#!/bin/bash
# TJB CITY GATE — pre-commit-city-gate.sh
# ═══════════════════════════════════════════════════════════════════════════════
# TJB Pre-Commit Hook — City Gate Enforcement
# ═══════════════════════════════════════════════════════════════════════════════
# Blocks any commit that changes src/data/cities.ts without passing stage gates
# for each affected city. This is the root-cause fix for cities like mesa-az
# that bypassed the pipeline and deployed with broken images.
#
# Install: bash scripts/hooks/install.sh
# Bypass:  git commit --no-verify  (emergency only)
#
# Gate files: artifacts/gates/{slug}-{stage}.json (written by preflight-stage-gate.py)
# For NEW cities: requires a passing BUILD gate
# For MODIFIED cities: requires a passing gate for the latest incomplete stage
# ═══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

PROJECT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# ── Python interpreter ────────────────────────────────────────────────────────
# TJB gate tooling (preflight-stage-gate.py) uses PEP 604 `X | None` (3.10+)
# annotations, so a bare `python3` (often the system 3.9) cannot parse it.
# Resolve a 3.10+ interpreter when available, falling back to whatever
# `python3` resolves to (for environments with only one Python installed).
PY="python3"
for cand in python3.13 python3.12 python3.11 python3.10 python3.14; do
    if command -v "$cand" >/dev/null 2>&1; then
        PY="$cand"
        break
    fi
done
GATES_DIR="$PROJECT_DIR/artifacts/gates"
CITIES_FILE="src/data/cities.ts"

# ── Helper: check if a gate file exists and passed ────────────────────────────
gate_passes() {
    local slug="$1"
    local stage="$2"
    local gate_file="$GATES_DIR/${slug}-${stage}.json"

    if [[ ! -f "$gate_file" ]]; then
        return 1
    fi

    local result
    result=$($PY -c "
import json, sys
try:
    with open('$gate_file') as f:
        data = json.load(f)
    exit_code = data.get('exit_code', None)
    passed = data.get('passed', None)
    if exit_code is not None:
        sys.exit(0 if exit_code == 0 else 1)
    elif passed is not None:
        sys.exit(0 if passed else 1)
    else:
        sys.exit(1)
except Exception:
    sys.exit(1)
" 2>/dev/null)
    local rc=$?
    return $rc
}

# ── Helper: extract city slug keys from a cities.ts text blob ──────────────────
extract_slugs() {
    grep -oE "slug:[[:space:]]*['\"][^'\"]+['\"]" | \
        sed "s/slug:[[:space:]]*['\"]//;s/['\"]//g" | sort -u
}

# ── Helper: extract a single city block from cities.ts text ────────────────────
# Reads from stdin, outputs the city block for the given slug
extract_city_block() {
    local target_slug="$1"
    $PY -c "
import sys, re
text = sys.stdin.read()
# Find the city entry by slug
marker = f'\"{sys.argv[1]}\": {{'
# Also try slug: pattern
alt_marker = f'slug: \"{sys.argv[1]}\"'
start = text.find(marker)
if start < 0:
    start = text.find(alt_marker)
    if start >= 0:
        start = text.rfind('{', 0, start)
if start < 0:
    sys.exit(0)
# Find matching close brace
depth = 0
i = start
while i < len(text):
    if text[i] == '{':
        depth += 1
    elif text[i] == '}':
        depth -= 1
        if depth == 0:
            print(text[start:i+1])
            break
    i += 1
" "$target_slug"
}

# ── 0. Only proceed if cities.ts is staged ────────────────────────────────────
if ! git diff --cached --name-only | grep -q "^${CITIES_FILE}$"; then
    # cities.ts not changed — nothing to gate
    exit 0
fi

# ── 1. Get HEAD and staged versions of cities.ts ──────────────────────────────
HEAD_CONTENT=$(git show "HEAD:$CITIES_FILE" 2>/dev/null || echo "")
STAGED_CONTENT=$(git show ":$CITIES_FILE" 2>/dev/null || echo "")

# ── 2. Get slug lists ──────────────────────────────────────────────────────────
HEAD_SLUGS=$(echo "$HEAD_CONTENT" | extract_slugs)
STAGED_SLUGS=$(echo "$STAGED_CONTENT" | extract_slugs)

# New slugs = in staged but not in HEAD
NEW_SLUGS=$(comm -13 <(echo "$HEAD_SLUGS") <(echo "$STAGED_SLUGS") 2>/dev/null | grep -v '^$' || true)

# ── 3. For modified cities, compare actual city blocks to find real changes ───
# A city is "modified" only if its block content differs between HEAD and staged
MODIFIED_SLUGS=""
while IFS= read -r slug; do
    [[ -z "$slug" ]] && continue
    # Skip if it's a new city (already in NEW_SLUGS)
    if echo "$NEW_SLUGS" | grep -qx "$slug"; then
        continue
    fi
    head_block=$(echo "$HEAD_CONTENT" | extract_city_block "$slug")
    staged_block=$(echo "$STAGED_CONTENT" | extract_city_block "$slug")
    if [[ "$head_block" != "$staged_block" ]]; then
        MODIFIED_SLUGS="${MODIFIED_SLUGS}${slug}"$'\n'
    fi
done <<< "$(echo "$STAGED_SLUGS" | grep -v '^$')"

# Count changes
NEW_COUNT=$(echo "$NEW_SLUGS" | grep -c . 2>/dev/null || true)
NEW_COUNT=${NEW_COUNT:-0}
MOD_COUNT=$(echo "$MODIFIED_SLUGS" | grep -c . 2>/dev/null || true)
MOD_COUNT=${MOD_COUNT:-0}
TOTAL_CHANGES=$(( NEW_COUNT + MOD_COUNT ))

if [[ $TOTAL_CHANGES -eq 0 ]]; then
    # cities.ts staged but no slug-level changes (formatting, comments, etc.)
    exit 0
fi

# ── 4. Check gate compliance ──────────────────────────────────────────────────
BLOCKED=0
BLOCK_MESSAGES=""

# For NEW cities: require a passing BUILD gate
while IFS= read -r slug; do
    [[ -z "$slug" ]] && continue
    if ! gate_passes "$slug" "build"; then
        BLOCKED=1
        BLOCK_MESSAGES+="❌ CITY GATE BLOCKED: $slug is a NEW city with no passing BUILD gate.
   Run: $PY scripts/preflight-stage-gate.py $slug build
   Then re-commit.

"
    fi
done <<< "$NEW_SLUGS"

# For MODIFIED cities: require a passing gate (verify_deploy > enrich > build)
while IFS= read -r slug; do
    [[ -z "$slug" ]] && continue
    # Check verify_deploy first — if it passes, city is fully compliant
    if gate_passes "$slug" "verify_deploy"; then
        continue
    fi
    if gate_passes "$slug" "enrich"; then
        continue
    fi
    if gate_passes "$slug" "build"; then
        continue
    fi
    # No gates pass — block
    BLOCKED=1
    BLOCK_MESSAGES+="❌ CITY GATE BLOCKED: $slug was modified but has no passing stage gate.
   Run: $PY scripts/preflight-stage-gate.py $slug build
   Then re-commit.

"
done <<< "$MODIFIED_SLUGS"

# ── 5. Report results ─────────────────────────────────────────────────────────
if [[ $BLOCKED -eq 1 ]]; then
    echo ""
    echo "════════════════════════════════════════════════════════════════"
    echo "  TJB CITY GATE — COMMIT BLOCKED"
    echo "════════════════════════════════════════════════════════════════"
    echo ""
    printf "%s" "$BLOCK_MESSAGES"
    echo "  Bypass with --no-verify (emergency only)"
    echo "════════════════════════════════════════════════════════════════"
    exit 1
fi

# All gates pass — allow commit
if [[ $TOTAL_CHANGES -gt 0 ]]; then
    echo "✅ City gate: $NEW_COUNT new + $MOD_COUNT modified cities — all gates passed."
fi
exit 0