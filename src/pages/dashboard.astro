---
import fs from 'fs';
import path from 'path';

const auditPath = path.join(process.cwd(), 'public', 'city-audit.json');
const auditData = JSON.parse(fs.readFileSync(auditPath, 'utf-8'));

// Sort: in_progress first, then by score descending (matches audit generator + refresh script "next up")
const cities = auditData.sort((a, b) => {
  if (a.in_progress !== b.in_progress) return a.in_progress ? -1 : 1;
  return b.score - a.score;
});
const total = cities.length;
const auditDate = fs.statSync(auditPath).mtime.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });

const stageLabels = {
  hero: 'Hero Image',
  og: 'OG Image',
  support: 'Support Scene',
  hospitals: 'Hospitals',
  doulas: 'Doulas',
  video: 'Video',
  outreach: 'Outreach'
};

const stages = Object.keys(stageLabels);
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
