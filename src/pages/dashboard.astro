<script is:inline define:vars={{ cityData: cities, totalCount: total }}>
  const data = {cities: cityData, total: totalCount};
  const stageLabels = {hero: 'Hero Image', og: 'OG Image', support: 'Support Scene', hospitals: 'Hospitals', doulas: 'Doulas', video: 'Video', outreach: 'Outreach'};
  const stages = Object.keys(stageLabels);

  document.getElementById('subtitle').textContent = data.total + ' city pages — tracked across 7 pipeline stages';

  function scoreClass(score) {
    if (score >= 100) return 'score-green';
    if (score >= 80) return 'score-yellow';
    if (score >= 40) return 'score-orange';
    return 'score-red';
  }

  function updateStats() {
    const statsBar = document.getElementById('statsBar');
    let html = '';

    const overallDone = data.cities.filter(c => c.score >= 100).length;
    const overallPct = Math.round(overallDone / data.total * 100);
    const overallColor = overallPct >= 50 ? '#A8B5A0' : overallPct >= 25 ? '#D8A0C4' : '#B87AA0';
    html += `
      <div class="stat-card overall">
        <div class="label">Overall Complete</div>
        <div class="value"><span class="done">${overallDone}</span><span class="sep">/</span><span class="total">${data.total}</span></div>
        <div class="bar"><div class="fill" style="width: ${overallPct}%; background: ${overallColor};"></div></div>
      </div>`;

    stages.forEach(s => {
      const done = data.cities.filter(c => c[s]).length;
      const t = data.total;
      const pct = Math.round(done / t * 100);
      const color = pct >= 75 ? '#A8B5A0' : pct >= 50 ? '#D8A0C4' : pct >= 25 ? '#E6BBD8' : '#B87AA0';
      html += `
        <div class="stat-card">
          <div class="label">${stageLabels[s]}</div>
          <div class="value"><span class="done">${done}</span><span class="sep">/</span><span class="total">${t}</span></div>
          <div class="bar"><div class="fill" style="width: ${pct}%; background: ${color};"></div></div>
        </div>`;
    });

    statsBar.innerHTML = html;
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function render() {
    const search = document.getElementById('search').value.toLowerCase();
    const filterStage = document.getElementById('filterStage').value;
    const hideComplete = document.getElementById('hideComplete').checked;

    let filtered = data.cities.filter(c => {
      if (hideComplete && c.score >= 100) return false;
      if (filterStage && c[filterStage]) return false;
      if (search) {
        const match = (c.city + ' ' + c.state + ' ' + c.slug).toLowerCase().includes(search);
        if (!match) return false;
      }
      return true;
    });

    const tbody = document.getElementById('tbody');
    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="11" class="empty-row">No cities match your filters</td></tr>';
      return;
    }

    let html = '';
    filtered.forEach((c, i) => {
      const isComplete = c.score >= 100;
      const rowClass = isComplete ? 'completed-row' : '';
      html += `<tr class="${rowClass}"><td>${i + 1}</td>`;
      html += `<td><span class="city-name" data-slug="${escapeHtml(c.slug)}" title="Click to copy pipeline prompt">${escapeHtml(c.city)}, ${escapeHtml(c.state)}</span><a href="https://truejoybirthing.com/birth-support/${encodeURIComponent(c.slug)}/" target="_blank" class="city-link">view</a></td>`;
      html += `<td class="center"><span class="score-badge ${scoreClass(c.score)}">${c.score}</span></td>`;
      // Status column
      if (c.in_progress) {
        const slotLabel = c.slot ? `Slot ${c.slot}` : 'Working';
        html += `<td class="center"><span class="in-progress-badge"><span class="pulse"></span>${escapeHtml(slotLabel)}</span></td>`;
      } else {
        html += `<td class="center"><span class="idle-badge">—</span></td>`;
      }
      stages.forEach(s => {
        const ok = c[s];
        const icon = ok ? '✓' : '✗';
        const cls = ok ? 'green-dot' : 'red-dot';
        let title = ok ? `${stageLabels[s]} ✓` : `${stageLabels[s]} ✗`;
        if (!ok && s === 'hero' && c.hero_issue) title += ' — ' + c.hero_issue;
        if (ok && s === 'hospitals' && c.hospital_count) title += ` (${c.hospital_count})`;
        if (ok && s === 'doulas' && c.doula_count) title += ` (${c.doula_count})`;
        html += `<td class="center" title="${escapeHtml(title)}"><span class="indicator ${cls}">${icon}</span></td>`;
      });
      html += '</tr>';
    });
    tbody.innerHTML = html;
  }

  document.getElementById('search').addEventListener('input', render);
  document.getElementById('filterStage').addEventListener('change', render);
  const hideCompleteEl = document.getElementById('hideComplete');
  // Default is checked (HTML attribute). Only override if user previously unchecked it.
  if (localStorage.getItem('tjb_hideComplete') === 'false') {
    hideCompleteEl.checked = false;
  }
  hideCompleteEl.addEventListener('change', function() {
    localStorage.setItem('tjb_hideComplete', this.checked);
    render();
  });

  // Click city name to copy targeted pipeline prompt
  document.getElementById('tbody').addEventListener('click', function(e) {
    if (e.target.classList.contains('city-name')) {
      const slug = e.target.dataset.slug;
      const city = data.cities.find(c => c.slug === slug);
      if (!city) return;

      const stageLabels = {
        hero: 'hero image (R9-R11: pregnant silhouette, 3:2, reused across OG/YT/video)',
        og: 'OG image (R9, R14: derived from hero, correct logo)',
        support: 'support scene image (R12: one pregnant woman + professional, 4:3, vision-verified)',
        hospitals: 'hospital enrichment (R18: 300+ char descriptions, R20: clean NICU labels, R19: population-scaled counts)',
        doulas: 'doula/provider enrichment (R13: photo sourcing headshot-logo-initials, R17: best-guess pricing never Contact-for-pricing, R21: specific credentials)',
        video: 'video embed (R31-R32: must reflect final page state, re-render if data changed)',
        outreach: 'outreach (R4: always last after deploy, R5: re-outreach after page updates)',
      };

      const failing = Object.keys(stageLabels).filter(s => !city[s]);
      let prompt;
      if (failing.length === 0) {
        prompt = `Probe ${slug} — run preflight to verify all gates pass, then confirm the live page matches the repo. If any gates fail, fix the root cause. Load tjb-pipeline-rules for all standards.`;
      } else if (failing.length >= 5) {
        prompt = `Work on ${slug} — load tjb-pipeline-dag first, then tjb-pipeline-rules. Probe current state with tjb-city-orchestrator, then execute all 4 stages through outreach. Failing: ${failing.map(s => stageLabels[s]).join('; ')}.`;
      } else {
        prompt = `Work on ${slug} — load tjb-pipeline-dag first, then tjb-pipeline-rules. Probe current state, then complete only the failing stages: ${failing.map(s => stageLabels[s]).join('; ')}. Do not re-run stages that are already passing.`;
      }
      navigator.clipboard.writeText(prompt).then(function() {
        e.target.classList.add('copied');
        setTimeout(function() { e.target.classList.remove('copied'); }, 1500);
      }).catch(function() {
        // Fallback for browsers without clipboard API
        const ta = document.createElement('textarea');
        ta.value = prompt;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        e.target.classList.add('copied');
        setTimeout(function() { e.target.classList.remove('copied'); }, 1500);
      });
    }
  });

  updateStats();
  render();
</script>
</body>
</html>