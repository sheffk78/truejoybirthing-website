---
import Layout from '../layouts/Layout.astro';

const breadcrumbList = [{"name": "Home", "url": "https://truejoybirthing.com/"}, {"name": "Privacy Policy", "url": "https://truejoybirthing.com/privacy/"}];
---

<Layout
  title="Privacy Policy"
  description="Privacy Policy for True Joy Birthing. Learn how we collect, use, and protect your personal information when you use our birth plan app and website."
  canonical="https://truejoybirthing.com/privacy/"
  breadcrumbList={breadcrumbList}
  schema={{
    "@graph": [{
      "@type": "WebPage",
      "name": "Privacy Policy",
      "description": "Privacy Policy for True Joy Birthing products and services.",
      "url": "https://truejoybirthing.com/privacy"
    }]
  }}>
  <!-- Hero -->
  <section class="bg-tjb-cream pt-16 pb-12">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">Privacy Policy</h1>
      <p class="text-lg text-tjb-gray">Last updated: July 2026</p>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-6 space-y-8">

      <p class="text-tjb-gray leading-relaxed">Agentic Trust ("we," "us," "our") respects your privacy and is committed to protecting your personal information. This policy explains what we collect, how we use it, and your choices.</p>

      <!-- 1. Information We Collect -->
      <div class="bg-tjb-cream-50 rounded-xl p-6 border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">1. Information We Collect</h2>
        <div class="space-y-3 mt-2">
          <div>
            <p class="font-semibold text-tjb-charcoal">Account information:</p>
            <p class="text-tjb-gray">Name, email address, and password when you create an account.</p>
          </div>
          <div>
            <p class="font-semibold text-tjb-charcoal">Birth plan data:</p>
            <p class="text-tjb-gray">Preferences, choices, and notes you enter into the birth plan builder.</p>
          </div>
          <div>
            <p class="font-semibold text-tjb-charcoal">Birth Plan Confidence Session:</p>
            <p class="text-tjb-gray">When you book a confidence session, we collect your name, email, booking date and time, payment confirmation, and any birth plan details you share during the session.</p>
          </div>
          <div>
            <p class="font-semibold text-tjb-charcoal">Pro Mode data:</p>
            <p class="text-tjb-gray">If you are a birth professional (doula or midwife) using True Joy Pro, we collect client information, visit notes, contracts, and invoices that you create within the app. This data is provided by you (the professional user) — we do not collect it directly from your clients.</p>
          </div>
          <div>
            <p class="font-semibold text-tjb-charcoal">Usage data:</p>
            <p class="text-tjb-gray">How you interact with the app, including pages visited, features used, and session duration.</p>
          </div>
          <div>
            <p class="font-semibold text-tjb-charcoal">Device information:</p>
            <p class="text-tjb-gray">Device type, operating system, and app version for troubleshooting and optimization.</p>
          </div>
        </div>
      </div>

      <!-- 2. How We Use Your Information -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">2. How We Use Your Information</h2>
        <p class="text-tjb-gray leading-relaxed">We use your information to provide and improve our services, process session bookings, process subscriptions, send transactional communications (account confirmation, booking confirmations, session reminders, and subscription receipts), respond to support requests, and comply with legal obligations.</p>
      </div>

      <!-- 3. Sensitive Data -->
      <div class="bg-tjb-rose-50 rounded-xl p-6 border border-tjb-rose-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">3. Sensitive Data</h2>
        <p class="text-tjb-gray leading-relaxed">Some personal information we collect, such as pregnancy status, due date, and birth planning preferences, may be considered sensitive under certain state privacy laws. We use this information only to provide and improve our Services and do not use it for targeted advertising.</p>
      </div>

      <!-- 3a. True Joy Pro Subscription -->
      <div class="bg-tjb-cream-50 rounded-xl p-6 border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">True Joy Pro Subscription</h2>
        <p class="text-tjb-gray leading-relaxed">True Joy Pro is a paid subscription for birth professionals (doulas and midwives), available via in-app purchase through the Apple App Store (and Google Play when available). Pricing is $29.99/month or $274.99/year, with a 14-day free trial. Subscriptions automatically renew unless cancelled before the renewal date. Payment is processed by Apple or Google through their respective stores; we do not store your payment card information for subscriptions.</p>
      </div>

      <!-- 4. Data Sharing -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">4. Data Sharing</h2>
        <p class="text-tjb-gray leading-relaxed mb-3">We do not sell your personal information. We share data only with:</p>
        <ul class="space-y-2 text-tjb-gray">
          <li class="flex items-start gap-2"><span class="text-tjb-lavender-500 mt-1">●</span> <span><strong class="text-tjb-charcoal">Apple App Store / Google Play:</strong> Process subscription payments for True Joy Pro and manage subscriptions. Subscription billing and account management are handled by Apple and Google through their respective stores.</span></li>
          <li class="flex items-start gap-2"><span class="text-tjb-lavender-500 mt-1">●</span> <span><strong class="text-tjb-charcoal">Stripe:</strong> Payment processing for one-time session payments ($250 Birth Plan Confidence Session). We do not store your full payment card number.</span></li>
          <li class="flex items-start gap-2"><span class="text-tjb-lavender-500 mt-1">●</span> <span><strong class="text-tjb-charcoal">Analytics tools (GA4):</strong> Aggregated, anonymized usage patterns. No personally identifiable information is shared.</span></li>
        </ul>
      </div>

      <!-- 5. Data Retention -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">5. Data Retention</h2>
        <p class="text-tjb-gray leading-relaxed">We retain your account information for as long as your account is active. If you delete your account, we will remove your personal data within 30 days, except where retention is required by law. Anonymized usage data may be retained indefinitely for analytics.</p>
      </div>

      <!-- 6. Your Rights -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">6. Your Rights</h2>
        <p class="text-tjb-gray leading-relaxed">You may access, correct, or delete your personal information at any time by contacting us. To exercise these rights, email <a href="mailto:support@truejoybirthing.com" class="text-tjb-rose-500 hover:text-tjb-charcoal underline underline-offset-3 transition-colors">support@truejoybirthing.com</a>.</p>
      </div>

      <!-- 7. U.S. State Privacy Rights -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">7. U.S. State Privacy Rights</h2>
        <p class="text-tjb-gray leading-relaxed mb-3">We do not sell or share your personal information. If you are a resident of one of the states below, you have additional rights as described:</p>
        <div class="space-y-3">
          <div>
            <p class="font-semibold text-tjb-charcoal">California (CCPA/CPRA):</p>
            <p class="text-tjb-gray">California residents have the right to know what personal information is collected, request deletion, correct inaccurate information, opt out of the sale or sharing of personal information, and limit use of sensitive personal information. We will respond to verified requests within 45 days. To submit a request, email support@truejoybirthing.com.</p>
          </div>
          <div>
            <p class="font-semibold text-tjb-charcoal">Utah (UCPA):</p>
            <p class="text-tjb-gray">Utah residents have the right to access and delete certain personal data, and to opt out of targeted advertising and the sale of personal data. We do not sell your data or use it for targeted advertising. We will respond to verified requests within 45 days. To submit a request, email support@truejoybirthing.com.</p>
          </div>
          <div>
            <p class="font-semibold text-tjb-charcoal">Virginia (VCDPA):</p>
            <p class="text-tjb-gray">Virginia residents have the right to access, correct, delete, and obtain a copy of their personal data, and to opt out of targeted advertising and the sale of personal data. We do not sell your data or use it for targeted advertising. We will respond to verified requests within 45 days. To submit a request, email support@truejoybirthing.com.</p>
          </div>
          <div>
            <p class="font-semibold text-tjb-charcoal">Colorado (CPA):</p>
            <p class="text-tjb-gray">Colorado residents have the right to access, correct, or delete their personal data, opt out of targeted advertising and the sale of personal data, and opt out of profiling. We do not sell your data or use it for targeted advertising. We will respond to verified requests within 45 days. To submit a request, email support@truejoybirthing.com.</p>
          </div>
          <div>
            <p class="font-semibold text-tjb-charcoal">Connecticut (CTDPA):</p>
            <p class="text-tjb-gray">Connecticut residents have the right to access, correct, delete, and obtain a copy of their personal data, and to opt out of targeted advertising and the sale of personal data. We do not sell your data or use it for targeted advertising. We will respond to verified requests within 45 days. To submit a request, email support@truejoybirthing.com.</p>
          </div>
        </div>
      </div>

      <!-- 8. Do Not Track -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">8. Do Not Track</h2>
        <p class="text-tjb-gray leading-relaxed">We do not currently respond to "Do Not Track" signals from your browser. We use cookies and similar technologies for analytics and site functionality, as described in this policy. You can manage cookies through your browser settings.</p>
      </div>

      <!-- 9. Children's Privacy -->
      <div class="bg-tjb-rose-50 rounded-xl p-6 border border-tjb-rose-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">9. Children's Privacy</h2>
        <p class="text-tjb-gray leading-relaxed">Our Services are not directed to children under 16. We do not knowingly collect personal information from children. If we discover that we have collected personal information from a child under 16, we will delete it promptly.</p>
      </div>

      <!-- 10. Security -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">10. Security</h2>
        <p class="text-tjb-gray leading-relaxed">We use industry-standard encryption and security practices to protect your information. No method of electronic storage is 100% secure. While we strive to protect your data, we cannot guarantee absolute security.</p>
      </div>

      <!-- 11. Medical Disclaimer -->
      <div class="bg-tjb-cream-50 rounded-xl p-6 border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">11. Medical Disclaimer</h2>
        <p class="text-tjb-gray leading-relaxed">True Joy Birthing provides educational content and planning tools. It is not a medical device and does not provide medical advice, diagnosis, or treatment. Always consult a qualified healthcare provider for medical decisions related to your pregnancy, birth, or postpartum care.</p>
      </div>

      <!-- 12. Changes -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">12. Changes to This Policy</h2>
        <p class="text-tjb-gray leading-relaxed">We may update this policy from time to time. We will notify you of material changes by posting the updated policy with a revised "Last updated" date. Your continued use of our services after changes are posted constitutes acceptance of the updated policy.</p>
      </div>

      <!-- 13. Contact -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">13. Contact</h2>
        <p class="text-tjb-gray leading-relaxed">For questions about this privacy policy, contact us at <a href="mailto:support@truejoybirthing.com" class="text-tjb-rose-500 hover:text-tjb-charcoal underline underline-offset-3 transition-colors">support@truejoybirthing.com</a>.</p>
        <div class="mt-3 text-sm text-tjb-gray">
          <p>Agentic Trust</p>
          <p>217 6th Ave N STE 43363, Nashville, TN 37219</p>
        </div>
      </div>

      <!-- Related links -->
      <div class="pt-8 border-t border-tjb-lavender-200/50 text-center">
        <p class="text-tjb-gray mb-4">Related: <a href="/terms/" class="text-tjb-rose-500 hover:text-tjb-charcoal underline underline-offset-3 transition-colors font-semibold">Terms of Use</a></p>
        <a href="/" class="btn-primary">Back to Home →</a>
      </div>

    </div>
  </section>
</Layout>