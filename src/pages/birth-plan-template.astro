---
import Layout from '../layouts/Layout.astro';
import LeadCaptureForm from '../components/LeadCaptureForm.astro';
import ContextualCityLinks from '../components/ContextualCityLinks.astro';
import AppStoreButtons from '../components/AppStoreButtons.astro';
import StickyAppCta from '../components/StickyAppCta.astro';
import ExitIntentCta from '../components/ExitIntentCta.astro';

const breadcrumbList = [{"name": "Home", "url": "https://truejoybirthing.com/"}, {"name": "Free Birth Plan Template", "url": "https://truejoybirthing.com/birth-plan-template/"}];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HowTo",
      "@id": "https://truejoybirthing.com/birth-plan-template/#howto",
      "name": "How to Use a Birth Plan Template",
      "description": "A step-by-step guide to building your birth plan using a free template, from choosing your preferences to sharing it with your care team.",
      "totalTime": "PT30M",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Download the free printable PDF",
          "text": "Download the birth plan template as a printable PDF. You can fill it in by hand or on your computer, or recreate it in the free True Joy Birthing app."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Review each section with your partner",
          "text": "Go through labor preferences, pain management, delivery, postpartum care, and newborn care. Talk through each section with your partner or support person so you're aligned."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Fill in your preferences",
          "text": "Mark what matters most to you. You don't need to answer every item, focus on the preferences that reflect what you actually want, not what you think you should want."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Bring it to your next appointment",
          "text": "Share your draft with your OB or midwife at your next visit. Ask them to flag anything that might not be possible at your specific hospital or birth center."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Pack it in your hospital bag",
          "text": "Print a few copies. Give one to your partner, one to your doula, and keep one in your hospital bag. When you're in labor, you won't be searching for it."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://truejoybirthing.com/birth-plan-template/#faq",
      "mainEntity": [
        { "@type": "Question", "name": "Is the birth plan template PDF really free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The one-pager and the fillable PDF are both free, no email or catch. Print as many copies as you like." } },
        { "@type": "Question", "name": "What should I put in a birth plan?", "acceptedAnswer": { "@type": "Answer", "text": "How you want labor to go, how you'll handle pain, what matters during delivery, the first hours after birth, and newborn care. A one-line flexibility statement at the top tells your team how you want decisions made if something changes." } },
        { "@type": "Question", "name": "What makes a good hospital birth plan template?", "acceptedAnswer": { "@type": "Answer", "text": "One your nurse can scan in about 30 seconds. Hospital templates work best when they're one page, written in short plain sentences, and organized by the moments of birth your team will actually manage: labor, pain relief, delivery, recovery, newborn care." } },
        { "@type": "Question", "name": "How long should a birth plan be?", "acceptedAnswer": { "@type": "Answer", "text": "One page. Seriously. Anything longer gets skimmed or skipped on a busy postpartum floor, which is exactly why we built the one-page version. Pick the preferences that matter most and cross out the rest." } },
                { "@type": "Question", "name": "When should I fill out my birth plan?", "acceptedAnswer": { "@type": "Answer", "text": "Most families start around 28 to 32 weeks, once prenatal visits get specific. Earlier is fine. Knowing your options early builds real confidence." } }
      ]
    }
  ]
};
---

<Layout
  title="Free Birth Plan Template (Printable PDF) | True Joy Birthing"
  description="Free printable birth plan template built by a certified doula. One page your nurses can scan in 30 seconds, plus a hospital example and how-to guide."
  canonical="https://truejoybirthing.com/birth-plan-template/"
  ogImage="https://truejoybirthing.com/images/og/og-birth-plan-template.webp?v=2"
  ogType="article"
  breadcrumbList={breadcrumbList}
  schema={schema}
>

  <!-- ═══════════════════════════════════════════
       HERO, Product-first two-column archetype
       Design spec: VISUAL-TOKENS.md hero archetype
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row">

        <!-- Left: Text, 55% -->
        <div class="md:w-[55%] px-6 md:px-12 py-16 md:py-24 flex flex-col justify-center">
          <p class="eyebrow mb-3">Birth Plan</p>
          <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
          <h1 class="font-bold text-tjb-charcoal leading-[1.15] mb-4" style="font-size: clamp(2.25rem, 5vw, 3.75rem);">
            Free Birth Plan Template (Printable PDF)
          </h1>
          <!-- Author credibility strip -->
          <div class="flex items-center gap-2.5 mb-5">
            <img src="/images/shelbi-thumb.webp" alt="Shelbi Kohler, birth doula" width="32" height="32" class="w-8 h-8 rounded-full object-cover" />
            <p class="text-sm text-tjb-gray leading-snug">
              <a href="/about/" class="text-tjb-lavender-600 hover:text-tjb-lavender-700 font-medium no-underline">Shelbi Kohler</a>,
              birth doula, 500+ families supported
            </p>
          </div>
          <p class="text-tjb-gray text-lg leading-[1.7] mb-8 max-w-[36rem]">
            A birth plan template is a short form for your preferences in labor, pain relief, delivery, and newborn care. Yours fits on <strong>one page a nurse can scan in 30 seconds</strong>. Below, a filled-in hospital example, the steps, and the download.
          </p>
          <div>
            <a href="#one-pager" class="btn-primary">Get the free PDF</a>
            <div class="mt-3" data-platform-cta>
              <AppStoreButtons variant="ghost" align="left" ct="bpt_above_fold" />
            </div>
          </div>

          <script is:inline>
            // Platform-aware above-fold CTA: show only the relevant store button
            // based on user-agent, matching TJB brand voice (sentence case, warm).
            (function () {
              var ctas = document.querySelectorAll('[data-platform-cta]');
              if (!ctas.length) return;
              var ua = navigator.userAgent || '';
              var isAndroid = /Android/.test(ua);
              var isIOS = /iPhone|iPad|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
              ctas.forEach(function (cta) {
                var buttons = cta.querySelectorAll('.app-store-buttons');
                buttons.forEach(function (btn) {
                  var iosBtn = btn.querySelector('[data-store="ios"]');
                  var androidBtn = btn.querySelector('[data-store="android"]');
                  if (isAndroid && androidBtn) {
                    iosBtn && (iosBtn.style.display = 'none');
                  } else if (isIOS && iosBtn) {
                    androidBtn && (androidBtn.style.display = 'none');
                  }
                });
              });
            })();
          </script>
        </div>

        <!-- Right: Product mockup, 45% -->
        <div class="md:w-[45%] flex items-center justify-center px-6 py-12 md:py-0">
          <img
            src="/images/birth-plan-preview.webp"
            alt="Preview of the free birth plan template, a structured multi-page document covering labor preferences, pain management, delivery, postpartum, and newborn care"
            class="w-full max-w-md rounded-md"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>

      <!-- Social proof strip — real numbers only (audit 1.9) -->
      <div id="bpt-social-proof" class="border-t border-tjb-lavender-200/50 bg-tjb-lavender-50/40">
        <p class="max-w-5xl mx-auto px-6 py-4 text-center text-sm text-tjb-gray leading-relaxed">
          173 app users · 130 moms · 31 doulas · 10 midwives · 53 birth plans created · 21 provider profiles
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PROVENANCE, Compact trust anchor
       ═══════════════════════════════════════════ -->
  <div class="bg-tjb-cream border-y border-tjb-lavender-200/40">
    <div class="max-w-3xl mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6">
      <span class="text-sm text-tjb-gray-300 tracking-wide">One-page print template</span>
      <span class="hidden sm:inline text-tjb-rose-400 text-sm">·</span>
      <span class="text-sm text-tjb-gray-300 tracking-wide">Free video walkthrough</span>
      <span class="hidden sm:inline text-tjb-rose-400 text-sm">·</span>
      <span class="text-sm text-tjb-gray-300 tracking-wide">Free app</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       WHAT IS A BIRTH PLAN TEMPLATE, editorial explainer
       ═══════════════════════════════════════════ -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">

      <p class="eyebrow mb-4">The basics</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-8" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        What is a birth plan template?
      </h2>

      <p class="text-tjb-gray text-lg leading-relaxed mb-5">
        It's a worksheet for your preferences, covering labor, pain management, delivery, postpartum care, and newborn care. You fill in what you want, and it becomes the document your OB, your nurse, and your doula read before anything happens.
      </p>
      <p class="text-tjb-gray text-lg leading-relaxed mb-5">
        It isn't a contract, or a place to list every preference you've ever had. Nurses meet you for twelve hours, usually during the busiest shift of their week. A one-page plan gets read. A four-page essay gets skimmed. <em>Short wins.</em>
      </p>
      <p class="text-tjb-gray text-lg leading-relaxed mb-5">
        The template flexes by setting. A hospital plan leans on short, scan-friendly sentences, and the <a href="/hospital-birth-plan/" class="text-tjb-rose-500 font-semibold hover:text-tjb-rose-600 transition">hospital birth plan guide</a> goes deep on that. A home birth plan reads like a transfer wish list for your midwife. Not sure what you want yet? Start with the <a href="/birth-plan-checklist/" class="text-tjb-rose-500 font-semibold hover:text-tjb-rose-600 transition">birth plan checklist</a>.
      </p>
      <p class="text-tjb-gray text-lg leading-relaxed">
        Most hospitals hand you their own form at a prenatal visit or admission, covering their defaults, IV access, continuous monitoring, an epidural offer on schedule. Bring yours anyway. Their form goes in the chart. Yours covers what a form can't ask, like who announces the baby's sex or what the room feels like at 3 a.m. Use both.
      </p>

      <p class="text-tjb-gray text-lg leading-relaxed">
        Built by <a href="/about/" class="text-tjb-rose-500 font-semibold hover:text-tjb-rose-600 transition">Shelbi Kohler</a>, a birth doula with delivery rooms across Texas behind her, around the decisions that actually come up in labor. The <a href="/birth-plan-examples/" class="text-tjb-rose-500 font-semibold hover:text-tjb-rose-600 transition">birth plan examples</a> make good starting points.
      </p>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       TEMPLATE PREVIEW — What a filled-in plan looks like
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-6">
      <p class="eyebrow mb-4 text-center">A filled-in example</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-8 mx-auto"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-4 text-center" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        See exactly what you'll fill in
      </h2>
      <p class="text-tjb-gray text-lg leading-relaxed mb-12 text-center max-w-2xl mx-auto">
        Excerpts from a hospital birth, filled in. Treat them as calibration, not scripture. Your answers should sound like you.
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Labor preferences -->
        <div class="bg-white rounded-xl p-6 border border-tjb-lavender-200/50 shadow-sm">
          <span class="inline-block bg-tjb-lavender-100 text-tjb-lavender-600 text-xs font-semibold px-3 py-1 rounded-full mb-3">Section 1</span>
          <h3 class="text-xl font-semibold text-tjb-charcoal mb-3">Labor preferences</h3>
          <ul class="space-y-2 text-sm text-tjb-gray leading-relaxed">
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> I'd like to move and change positions freely during labor</li>
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> Intermittent monitoring unless medically necessary</li>
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> Partner and doula present in the room at all times</li>
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> Dim lights and quiet voices please</li>
          </ul>
        </div>

        <!-- Pain management -->
        <div class="bg-white rounded-xl p-6 border border-tjb-lavender-200/50 shadow-sm">
          <span class="inline-block bg-tjb-rose-100 text-tjb-rose-500 text-xs font-semibold px-3 py-1 rounded-full mb-3">Section 2</span>
          <h3 class="text-xl font-semibold text-tjb-charcoal mb-3">Pain management</h3>
          <ul class="space-y-2 text-sm text-tjb-gray leading-relaxed">
            <li class="flex gap-2"><span class="text-tjb-rose-500 font-bold">✓</span> Start with breathing, tub/shower, and movement first</li>
            <li class="flex gap-2"><span class="text-tjb-rose-500 font-bold">✓</span> Please offer an epidural when I ask, not before</li>
            <li class="flex gap-2"><span class="text-tjb-rose-500 font-bold">✓</span> Open to nitrous oxide if labor is long</li>
          </ul>
        </div>

        <!-- Delivery -->
        <div class="bg-white rounded-xl p-6 border border-tjb-lavender-200/50 shadow-sm">
          <span class="inline-block bg-tjb-lavender-100 text-tjb-lavender-600 text-xs font-semibold px-3 py-1 rounded-full mb-3">Section 3</span>
          <h3 class="text-xl font-semibold text-tjb-charcoal mb-3">Delivery preferences</h3>
          <ul class="space-y-2 text-sm text-tjb-gray leading-relaxed">
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> Push in whatever position feels right</li>
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> Delayed cord clamping (at least 60 seconds)</li>
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> Partner announces the sex of the baby</li>
          </ul>
        </div>

        <!-- Postpartum -->
        <div class="bg-white rounded-xl p-6 border border-tjb-lavender-200/50 shadow-sm">
          <span class="inline-block bg-tjb-rose-100 text-tjb-rose-500 text-xs font-semibold px-3 py-1 rounded-full mb-3">Section 4</span>
          <h3 class="text-xl font-semibold text-tjb-charcoal mb-3">Postpartum care</h3>
          <ul class="space-y-2 text-sm text-tjb-gray leading-relaxed">
            <li class="flex gap-2"><span class="text-tjb-rose-500 font-bold">✓</span> Immediate skin-to-skin</li>
            <li class="flex gap-2"><span class="text-tjb-rose-500 font-bold">✓</span> Lactation consultant support before discharge</li>
            <li class="flex gap-2"><span class="text-tjb-rose-500 font-bold">✓</span> Partner stays overnight</li>
          </ul>
        </div>

        <!-- Newborn care -->
        <div class="md:col-span-2 bg-white rounded-xl p-6 border border-tjb-lavender-200/50 shadow-sm">
          <span class="inline-block bg-tjb-sage-100 text-tjb-sage text-xs font-semibold px-3 py-1 rounded-full mb-3">Section 5</span>
          <h3 class="text-xl font-semibold text-tjb-charcoal mb-3">Newborn care</h3>
          <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-2 text-sm text-tjb-gray leading-relaxed">
            <li class="flex gap-2"><span class="text-tjb-sage font-bold">✓</span> Baby rooms in with me at all times</li>
            <li class="flex gap-2"><span class="text-tjb-sage font-bold">✓</span> Vitamin K injection: yes</li>
            <li class="flex gap-2"><span class="text-tjb-sage font-bold">✓</span> Hepatitis B vaccine: yes, at the 2-month visit</li>
            <li class="flex gap-2"><span class="text-tjb-sage font-bold">✓</span> No formula or bottles without talking to us first</li>
          </ul>
        </div>
      </div>

      <div class="text-center mt-10">
        <a href="#one-pager" class="btn-primary">Download the free PDF →</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       HOW TO USE, Editorial numbered steps
       ═══════════════════════════════════════════ -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">

      <p class="eyebrow mb-4">How to use this template</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-10" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        Five steps from blank page to hospital bag
      </h2>

      <div class="space-y-0">
        <div class="py-5 border-t border-tjb-lavender-300/40">
          <div class="grid md:grid-cols-[3rem_1fr] gap-4 md:gap-6 items-start">
            <span class="text-3xl font-bold text-tjb-lavender-500 font-serif">01</span>
            <div>
              <p class="text-tjb-charcoal font-semibold mb-1">Download the printable template.</p>
              <p class="text-tjb-gray leading-relaxed">It's free, no email required. Print it and fill it in by hand, or type into the fillable version.</p>
            </div>
          </div>
        </div>

        <div class="py-5 border-t border-tjb-lavender-300/40">
          <div class="grid md:grid-cols-[3rem_1fr] gap-4 md:gap-6 items-start">
            <span class="text-3xl font-bold text-tjb-rose-500 font-serif">02</span>
            <div>
              <p class="text-tjb-charcoal font-semibold mb-1">Read it top to bottom with your partner.</p>
              <p class="text-tjb-gray leading-relaxed">Every check box is a conversation worth having in week 30, while nobody is having contractions. Where you disagree, talk it through. That's the template working.</p>
            </div>
          </div>
        </div>

        <div class="py-5 border-t border-tjb-lavender-300/40">
          <div class="grid md:grid-cols-[3rem_1fr] gap-4 md:gap-6 items-start">
            <span class="text-3xl font-bold text-tjb-lavender-500 font-serif">03</span>
            <div>
              <p class="text-tjb-charcoal font-semibold mb-1">Mark what matters most, and cross out the rest.</p>
              <p class="text-tjb-gray leading-relaxed">You don't need to answer every line. A plan with eight items that all matter beats forty items nobody reads.</p>
            </div>
          </div>
        </div>

        <div class="py-5 border-t border-tjb-lavender-300/40">
          <div class="grid md:grid-cols-[3rem_1fr] gap-4 md:gap-6 items-start">
            <span class="text-3xl font-bold text-tjb-rose-500 font-serif">04</span>
            <div>
              <p class="text-tjb-charcoal font-semibold mb-1">Bring it to your next appointment.</p>
              <p class="text-tjb-gray leading-relaxed">Ask your OB or midwife to flag anything your hospital doesn't do, because every hospital handles this differently. The <a href="/hospital-birth-plan/" class="text-tjb-rose-500 font-semibold hover:text-tjb-rose-600 border-b border-transparent hover:border-tjb-rose-500 transition-all">hospital birth plan guide</a> covers the preferences that matter most in that setting.</p>
            </div>
          </div>
        </div>

        <div class="py-5 border-t border-tjb-lavender-300/40 border-b">
          <div class="grid md:grid-cols-[3rem_1fr] gap-4 md:gap-6 items-start">
            <span class="text-3xl font-bold text-tjb-sage font-serif">05</span>
            <div>
              <p class="text-tjb-charcoal font-semibold mb-1">Pack it in your hospital bag.</p>
              <p class="text-tjb-gray leading-relaxed">Print a few copies. One for your partner, one for your doula, one tucked with your insurance card. When labor starts, you won't be searching for any of it.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       BIRTH PLANS FOR EVERY SITUATION, cluster grid
       ═══════════════════════════════════════════ -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-6">

      <p class="eyebrow mb-4 text-center">Same template, different circumstances</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-8 mx-auto"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-4 text-center" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        Birth plans for every kind of birth
      </h2>
      <p class="text-tjb-gray text-lg leading-relaxed mb-10 text-center max-w-2xl mx-auto">
        The five sections stay the same. What goes inside them changes with how you're giving birth.
      </p>

      <div class="grid md:grid-cols-2 gap-4">
        <a href="/hospital-birth-plan/" class="block bg-tjb-cream rounded-xl p-5 border border-tjb-lavender-200/50 hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-tjb-charcoal mb-1">Hospital birth</h3>
          <p class="text-tjb-gray text-sm leading-relaxed">The defaults your hospital assumes, and the sentences that rearrange them.</p>
        </a>
        <a href="/birth-plan-for-induction/" class="block bg-tjb-cream rounded-xl p-5 border border-tjb-lavender-200/50 hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-tjb-charcoal mb-1">Planned induction</h3>
          <p class="text-tjb-gray text-sm leading-relaxed">What adjusts when labor starts in a chart instead of your body.</p>
        </a>
        <a href="/vbac-birth-plan/" class="block bg-tjb-cream rounded-xl p-5 border border-tjb-lavender-200/50 hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-tjb-charcoal mb-1">VBAC</h3>
          <p class="text-tjb-gray text-sm leading-relaxed">A few lines carry extra weight when you're hoping for a vaginal birth after a cesarean.</p>
        </a>
        <a href="/home-birth-plan/" class="block bg-tjb-cream rounded-xl p-5 border border-tjb-lavender-200/50 hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-tjb-charcoal mb-1">Home birth</h3>
          <p class="text-tjb-gray text-sm leading-relaxed">A shorter, quieter plan, plus transfer wishes worth writing down early.</p>
        </a>
        <a href="/c-section-birth-plan/" class="block bg-tjb-cream rounded-xl p-5 border border-tjb-lavender-200/50 hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-tjb-charcoal mb-1">Planned or possible C-section</h3>
          <p class="text-tjb-gray text-sm leading-relaxed">Surgery has preferences too, from music to who's with you in the OR.</p>
        </a>
        <a href="/birth-plan-checklist/" class="block bg-tjb-cream rounded-xl p-5 border border-tjb-lavender-200/50 hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-tjb-charcoal mb-1">Just the checklist first</h3>
          <p class="text-tjb-gray text-sm leading-relaxed">If the blank form feels big, start with every choice on one list.</p>
        </a>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CONFIDENCE SESSION UPSELL (between cluster & CTA)
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream py-16 md:py-20 border-t border-tjb-lavender-200/50">
    <div class="max-w-3xl mx-auto px-6">

