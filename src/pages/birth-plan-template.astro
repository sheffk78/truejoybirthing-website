---
import Layout from '../layouts/Layout.astro';
import LeadCaptureForm from '../components/LeadCaptureForm.astro';
import AppShowcase from '../components/AppShowcase.astro';
import ContextualCityLinks from '../components/ContextualCityLinks.astro';

const breadcrumbList = [{"name": "Home", "url": "https://truejoybirthing.com/"}, {"name": "Free Birth Plan Template", "url": "https://truejoybirthing.com/birth-plan-template/"}];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HowTo",
      "@id": "https://truejoybirthing.com/birth-plan-template/#howto",
      "name": "How to Use a Birth Plan Template",
      "description": "A step-by-step guide to building your birth plan using a free template, from choosing your preferences to sharing it with your care team.",
      "totalTime": "PT30M",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Download the free fillable PDF",
          "text": "Download Your Birth Plan template as a fillable PDF. You can type directly into it, print it, or recreate it in the free True Joy Birthing app."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Review each section with your partner",
          "text": "Go through labor preferences, pain management, delivery, postpartum care, and newborn care. Talk through each section with your partner or support person so you're aligned."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Fill in your preferences",
          "text": "Mark what matters most to you. You don't need to answer every item, focus on the preferences that reflect what you actually want, not what you think you should want."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Bring it to your next appointment",
          "text": "Share your draft with your OB or midwife at your next visit. Ask them to flag anything that might not be possible at your specific hospital or birth center."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Pack it in your hospital bag",
          "text": "Print a few copies. Give one to your partner, one to your doula, and keep one in your hospital bag. When you're in labor, you won't be searching for it."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://truejoybirthing.com/birth-plan-template/#faq",
      "mainEntity": [
        { "@type": "Question", "name": "What should a birth plan template include?", "acceptedAnswer": { "@type": "Answer", "text": "A good birth plan template covers labor preferences, pain management options, delivery positions, postpartum care preferences, and newborn care decisions. It should be organized, concise, and easy for your care team to scan quickly." } },
        { "@type": "Question", "name": "Is this birth plan template really free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The fillable PDF and the full 5-video walkthrough are both completely free, just enter your name and email and youll get immediate access to everything. No payment, no trial, no upsell." } },
        { "@type": "Question", "name": "Can I edit the birth plan template?", "acceptedAnswer": { "@type": "Answer", "text": "The PDF is fillable, type directly into it or print it and fill it in by hand. For live updates, doula sharing, and a guided walkthrough, use the free True Joy Birthing app." } },
        { "@type": "Question", "name": "How is this different from a birth plan I find on Google?", "acceptedAnswer": { "@type": "Answer", "text": "Most free templates online are generic checklists. This one was built by a certified birth doula and organized around the decisions that actually come up in the delivery room, not just wish-list items." } },
        { "@type": "Question", "name": "When should I fill out my birth plan?", "acceptedAnswer": { "@type": "Answer", "text": "Most families start around 28-32 weeks. Earlier is fine too. The sooner you understand your options, the more confident you'll feel when the time comes." } },
        { "@type": "Question", "name": "What's the difference between the PDF and the app?", "acceptedAnswer": { "@type": "Answer", "text": "The PDF is free, fillable, and designed for print, write in your preferences and bring hard copies to the hospital. The free app goes further: it walks you through each section with guided videos, lets you update your plan anytime, and shares your live plan with your doula or partner directly. Both cover the same five sections; the app is for families who want an interactive, always-current experience." } },
        { "@type": "Question", "name": "Is the video walkthrough really free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The 5-video walkthrough is completely free, just enter your name and email and youll get immediate access to every module. No payment, no trial, no upsell. We ask for your email so we can send you the PDF and check in with tips as you fill out your plan." } },
        { "@type": "Question", "name": "How is the walkthrough different from the PDF?", "acceptedAnswer": { "@type": "Answer", "text": "The PDF is the template, the form you fill out. The walkthrough is a certified doula explaining what each section means, why each choice matters, and how to talk to your provider about it. They work together: download the PDF, then watch the videos as you fill it in." } }
      ]
    }
  ]
};
---

<Layout
  title="Free Birth Plan Template (PDF) — Fillable & Printable, by a Certified Doula"
  description="Free fillable birth plan template by a certified doula. Your nurse can read it in 30 seconds. Covers labor through newborn care. PDF and app included."
  canonical="https://truejoybirthing.com/birth-plan-template/"
  ogImage="https://truejoybirthing.com/images/og/og-birth-plan-template.webp?v=2"
  ogType="article"
  breadcrumbList={breadcrumbList}
  schema={schema}
>

  <!-- ═══════════════════════════════════════════
       HERO, Product-first two-column archetype
       Design spec: VISUAL-TOKENS.md hero archetype
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row">

        <!-- Left: Text, 55% -->
        <div class="md:w-[55%] px-6 md:px-12 py-16 md:py-24 flex flex-col justify-center">
          <p class="eyebrow mb-3">Birth Plan</p>
          <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
          <h1 class="font-bold text-tjb-charcoal leading-[1.15] mb-4" style="font-size: clamp(2.25rem, 5vw, 3.75rem);">
            Free birth plan template that actually works in the delivery room
          </h1>
          <!-- Author credibility strip -->
          <div class="flex items-center gap-2.5 mb-5">
            <img src="/images/shelbi-thumb.webp" alt="Shelbi Kohler, certified birth doula" width="32" height="32" class="w-8 h-8 rounded-full object-cover" />
            <p class="text-sm text-tjb-gray leading-snug">
              <a href="/about/" class="text-tjb-lavender-600 hover:text-tjb-lavender-700 font-medium no-underline">Shelbi Kohler</a>,
              certified birth doula, 500+ families supported
            </p>
          </div>
          <p class="text-tjb-gray text-lg leading-[1.7] mb-8 max-w-[36rem]">
            A <strong>birth plan template</strong> is a structured form that helps you write down your preferences for labor, pain management, delivery, and newborn care, so your medical team can read it at a glance.
          </p>
          <p class="text-tjb-gray text-base leading-relaxed mb-8 max-w-[36rem]">
            This one is built by a certified doula, not a generic hospital form. <strong>Start with the free printable PDF</strong>, and when you want guided videos, live updates, and doula sharing, step up to the <a href="https://apps.apple.com/us/app/true-joy-birthing/id6760793180" class="text-tjb-rose-500 font-semibold hover:text-tjb-rose-600 border-b border-transparent hover:border-tjb-rose-500 transition-all">free app</a>.
          </p>
          <div>
            <a href="https://apps.apple.com/us/app/true-joy-birthing/id6760793180" class="btn-primary">
              Build your birth plan in the app
            </a>
            <p class="mt-3 text-sm text-tjb-gray">
              Prefer a printable PDF?
              <a href="#download" class="text-tjb-rose-500 font-semibold hover:text-tjb-rose-600 underline underline-offset-2 transition-all">Get it free</a> — no email required.
            </p>
          </div>
        </div>

        <!-- Right: Product mockup, 45% -->
        <div class="md:w-[45%] flex items-center justify-center px-6 py-12 md:py-0">
          <img
            src="/images/birth-plan-preview.webp"
            alt="Preview of the free birth plan template, a structured multi-page document covering labor preferences, pain management, delivery, postpartum, and newborn care"
            class="w-full max-w-md rounded-md"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PROVENANCE, Compact trust anchor
       ═══════════════════════════════════════════ -->
  <div class="bg-tjb-cream border-y border-tjb-lavender-200/40">
    <div class="max-w-3xl mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6">
      <span class="text-sm text-tjb-gray-300 tracking-wide">📄 Free PDF</span>
      <span class="hidden sm:inline text-tjb-rose-400 text-sm">·</span>
      <span class="text-sm text-tjb-gray-300 tracking-wide">🎬 Free video walkthrough</span>
      <span class="hidden sm:inline text-tjb-rose-400 text-sm">·</span>
      <span class="text-sm text-tjb-gray-300 tracking-wide">📱 Free app</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       TEMPLATE PREVIEW — What a filled-in plan looks like
       ═══════════════════════════════════════════ -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-6">
      <p class="eyebrow mb-4 text-center">Inside the template</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-8 mx-auto"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-4 text-center" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        See exactly what you'll fill in
      </h2>
      <p class="text-tjb-gray text-lg leading-relaxed mb-12 text-center max-w-2xl mx-auto">
        Five short sections, each with plain-language choices. Here's a sample of what a filled-in section looks like.
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Labor preferences -->
        <div class="bg-tjb-cream rounded-xl p-6 border border-tjb-lavender-200/50 shadow-sm">
          <span class="inline-block bg-tjb-lavender-100 text-tjb-lavender-600 text-xs font-semibold px-3 py-1 rounded-full mb-3">Section 1</span>
          <h3 class="text-xl font-semibold text-tjb-charcoal mb-3">Labor preferences</h3>
          <ul class="space-y-2 text-sm text-tjb-gray leading-relaxed">
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> I'd like to move and change positions freely during labor</li>
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> Intermittent monitoring unless medically necessary</li>
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> Partner and doula present in the room at all times</li>
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> Dim lights and quiet voices please</li>
          </ul>
        </div>

        <!-- Pain management -->
        <div class="bg-tjb-cream rounded-xl p-6 border border-tjb-lavender-200/50 shadow-sm">
          <span class="inline-block bg-tjb-rose-100 text-tjb-rose-500 text-xs font-semibold px-3 py-1 rounded-full mb-3">Section 2</span>
          <h3 class="text-xl font-semibold text-tjb-charcoal mb-3">Pain management</h3>
          <ul class="space-y-2 text-sm text-tjb-gray leading-relaxed">
            <li class="flex gap-2"><span class="text-tjb-rose-500 font-bold">✓</span> Start with breathing, tub/shower, and movement first</li>
            <li class="flex gap-2"><span class="text-tjb-rose-500 font-bold">✓</span> Please offer an epidural when I ask — not before</li>
            <li class="flex gap-2"><span class="text-tjb-rose-500 font-bold">✓</span> Open to nitrous oxide if labor is long</li>
          </ul>
        </div>

        <!-- Delivery -->
        <div class="bg-tjb-cream rounded-xl p-6 border border-tjb-lavender-200/50 shadow-sm">
          <span class="inline-block bg-tjb-lavender-100 text-tjb-lavender-600 text-xs font-semibold px-3 py-1 rounded-full mb-3">Section 3</span>
          <h3 class="text-xl font-semibold text-tjb-charcoal mb-3">Delivery preferences</h3>
          <ul class="space-y-2 text-sm text-tjb-gray leading-relaxed">
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> Push in whatever position feels right to me</li>
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> Delayed cord clamping (at least 60 seconds)</li>
            <li class="flex gap-2"><span class="text-tjb-lavender-600 font-bold">✓</span> Partner announces the sex of the baby</li>
          </ul>
        </div>

        <!-- Postpartum -->
        <div class="bg-tjb-cream rounded-xl p-6 border border-tjb-lavender-200/50 shadow-sm">
          <span class="inline-block bg-tjb-rose-100 text-tjb-rose-500 text-xs font-semibold px-3 py-1 rounded-full mb-3">Section 4</span>
          <h3 class="text-xl font-semibold text-tjb-charcoal mb-3">Postpartum care</h3>
          <ul class="space-y-2 text-sm text-tjb-gray leading-relaxed">
            <li class="flex gap-2"><span class="text-tjb-rose-500 font-bold">✓</span> Immediate skin-to-skin for the first hour</li>
            <li class="flex gap-2"><span class="text-tjb-rose-500 font-bold">✓</span> Breastfeeding support from a lactation consultant before discharge</li>
            <li class="flex gap-2"><span class="text-tjb-rose-500 font-bold">✓</span> Partner stays overnight with me and baby</li>
          </ul>
        </div>

        <!-- Newborn care -->
        <div class="md:col-span-2 bg-tjb-cream rounded-xl p-6 border border-tjb-lavender-200/50 shadow-sm">
          <span class="inline-block bg-sage-100 text-tjb-sage text-xs font-semibold px-3 py-1 rounded-full mb-3">Section 5</span>
          <h3 class="text-xl font-semibold text-tjb-charcoal mb-3">Newborn care</h3>
          <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-2 text-sm text-tjb-gray leading-relaxed">
            <li class="flex gap-2"><span class="text-tjb-sage font-bold">✓</span> Baby rooms in with me at all times</li>
            <li class="flex gap-2"><span class="text-tjb-sage font-bold">✓</span> Vitamin K injection: yes</li>
            <li class="flex gap-2"><span class="text-tjb-sage font-bold">✓</span> Hepatitis B vaccine: yes, but at 2-month visit</li>
            <li class="flex gap-2"><span class="text-tjb-sage font-bold">✓</span> No formula or bottles without talking to us first</li>
          </ul>
        </div>
      </div>

      <div class="text-center mt-10">
        <a href="#download" class="btn-primary">Download the free PDF →</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       VALUE LADDER — PDF is the start, app is the upgrade
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-6">
      <p class="eyebrow mb-4 text-center">Start free, upgrade when you're ready</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-8 mx-auto"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-12 text-center" style="font-size: clamp(1.5rem, 3.5vw, 2.25rem);">
        Start with the printable PDF, step up to the app when it fits
      </h2>

      <div class="relative">
        <!-- Step 1: PDF (starting point) -->
        <div class="bg-white rounded-xl p-6 md:p-8 border border-tjb-lavender-200/50 shadow-sm md:flex md:items-start md:gap-6 relative z-10">
          <span class="hidden md:flex absolute -right-4 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-tjb-rose-500 text-white items-center justify-center z-20" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15m0 0l6.75 6.75M4.5 12l6.75-6.75"/></svg>
          </span>
          <div class="w-14 h-14 shrink-0 rounded-full bg-tjb-lavender-100 flex items-center justify-center mb-4 md:mb-0">
            <svg class="w-7 h-7 text-tjb-lavender-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-3 mb-2">
              <h3 class="font-semibold text-tjb-charcoal text-lg">Step 1 · Free Printable PDF</h3>
              <span class="text-xs font-semibold text-tjb-lavender-600 bg-tjb-lavender-100 px-3 py-1 rounded-full">Start here</span>
            </div>
            <p class="text-tjb-gray leading-relaxed mb-4">Download instantly — no email required. Fill it in on your computer or print it and write by hand. Covers all five sections your nurse needs.</p>
            <a href="#download" class="btn-secondary inline-block">Get the free PDF →</a>
          </div>
        </div>

        <!-- Connector -->
        <div class="hidden md:block w-0.5 h-10 bg-tjb-rose-300 mx-auto ml-[calc(50%)]"></div>

        <!-- Step 2: Video walkthrough -->
        <div class="bg-white rounded-xl p-6 md:p-8 border border-tjb-lavender-200/50 shadow-sm mb-6 md:flex md:items-start md:gap-6 relative z-10">
          <div class="w-14 h-14 shrink-0 rounded-full bg-tjb-rose-100 flex items-center justify-center mb-4 md:mb-0">
            <svg class="w-7 h-7 text-tjb-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z"/></svg>
          </div>
          <div>
            <h3 class="font-semibold text-tjb-charcoal text-lg mb-2">Step 2 · Video Walkthrough</h3>
            <p class="text-tjb-gray leading-relaxed mb-4">Not sure what to write? Watch Shelbi explain every section in 5 short videos, then fill in your PDF as you go. Just enter your email to watch.</p>
            <a href="/walkthrough/" class="btn-secondary inline-block">Watch the walkthrough →</a>
          </div>
        </div>

        <!-- Step 3: App (upgrade path) -->
        <div class="bg-tjb-charcoal rounded-xl p-6 md:p-8 shadow-md md:flex md:items-start md:gap-6 relative z-10">
          <div class="w-14 h-14 shrink-0 rounded-full bg-white/10 flex items-center justify-center mb-4 md:mb-0">
            <svg class="w-7 h-7 text-tjb-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"/></svg>
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-3 mb-2">
              <h3 class="font-semibold text-white text-lg">Step 3 · True Joy Birthing App</h3>
              <span class="text-xs font-semibold text-tjb-charcoal bg-tjb-rose-400 px-3 py-1 rounded-full">The upgrade</span>
            </div>
            <p class="text-tjb-gray-300 leading-relaxed mb-4">Everything the PDF does — plus guided videos inside every section, live updates after appointments, and one-tap sharing with your doula and partner. Still completely free.</p>
            <a href="https://apps.apple.com/us/app/true-joy-birthing/id6760793180" class="btn-primary inline-block">Get the free app</a>
          </div>
        </div>
      </div>

      <p class="text-center text-sm text-tjb-gray mt-8">All three cover the same five sections. Most families start with the PDF and move to the app as their due date gets closer.</p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       VIDEO MODULE PREVIEWS, Show what's inside the walkthrough
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">

      <p class="eyebrow mb-4">Birth Plan Walkthrough</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-4" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        Walk through every section with a certified doula, free
      </h2>
      <p class="text-tjb-gray text-lg leading-relaxed mb-8">
        Want to understand <em>why</em> each section matters before you fill it out? These 5 short videos walk through the entire Joyful Birth Plan, from labor preferences to backup plans, so you fill it out with confidence, not confusion.
      </p>

      <div class="space-y-4 mb-8">
        <!-- Module 1 -->
        <div class="bg-white rounded-xl p-5 shadow-sm border border-tjb-lavender-200/50 hover:shadow-md transition-shadow cursor-pointer" onclick="window.location.href='/walkthrough/'">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="relative shrink-0 sm:w-44 w-full aspect-video rounded-lg overflow-hidden">
              <img src="/images/video-thumbnails/module-01-intro.webp" alt="Video thumbnail: Shelbi introduces the Joyful Birth Plan" class="w-full h-full object-cover" loading="lazy" width="440" height="248" />
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-tjb-rose-500/90 flex items-center justify-center shadow-md">
                  <svg class="w-5 h-5 text-white ml-0.5" viewBox="0 0 24 24" fill="currentColor"><polygon points="8,5 20,12 8,19" /></svg>
                </div>
              </div>
            </div>
            <div>
              <span class="text-sm font-semibold text-tjb-lavender-500">Module 1</span>
              <h3 class="font-semibold text-lg text-tjb-charcoal mb-1">About Me & Your Birth Plan</h3>
              <p class="text-tjb-gray text-sm leading-relaxed">How to fill in the section that helps your care team see you as a person. What to include in your flexibility statement and how to note your preferences.</p>
              <span class="text-xs text-tjb-gray-400 mt-1 inline-block">▶ ~5 min</span>
            </div>
          </div>
        </div>

        <!-- Module 2 -->
        <div class="bg-white rounded-xl p-5 shadow-sm border border-tjb-lavender-200/50 hover:shadow-md transition-shadow cursor-pointer" onclick="window.location.href='/walkthrough/'">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="relative shrink-0 sm:w-44 w-full aspect-video rounded-lg overflow-hidden">
              <img src="/images/video-thumbnails/module-02-labor.webp" alt="Video thumbnail: Labor, delivery, and pain management walkthrough" class="w-full h-full object-cover" loading="lazy" width="440" height="248" />
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-tjb-rose-500/90 flex items-center justify-center shadow-md">
                  <svg class="w-5 h-5 text-white ml-0.5" viewBox="0 0 24 24" fill="currentColor"><polygon points="8,5 20,12 8,19" /></svg>
                </div>
              </div>
            </div>
            <div>
              <span class="text-sm font-semibold text-tjb-rose-500">Module 2</span>
