---
// ═══════════════════════════════════════════════════════════════
// Invite landing page — "Invite Your Doula" feature
// Static page: invite data fetched client-side via JS
// No server-side fetching. Works without JS (shows generic welcome).
// SEO: indexable, with FAQ schema, breadcrumbs, and organic content.
// ═══════════════════════════════════════════════════════════════
import Layout from '../../layouts/Layout.astro';

const pageTitle = "You're Invited to True Joy Birthing";
const pageDesc = "True Joy Birthing is A birth plan app connecting moms with doulas and midwives. Build your plan and share with your care team.";
const APP_STORE_URL = "https://apps.apple.com/us/app/true-joy-birthing/id6760793180";
const GOOGLE_PLAY_URL = "https://play.google.com/store/apps/details?id=com.truejoybirthing";

const breadcrumbList = [
  { name: 'Home', url: 'https://truejoybirthing.com/' },
  { name: 'Invite', url: 'https://truejoybirthing.com/invite/' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://truejoybirthing.com/invite/#webpage',
      name: 'True Joy Birthing Invite',
      url: 'https://truejoybirthing.com/invite/',
      description: pageDesc,
      publisher: { '@id': 'https://truejoybirthing.com/#organization' },
      isPartOf: { '@id': 'https://truejoybirthing.com/#website' },
      breadcrumb: { '@id': 'https://truejoybirthing.com/invite/#breadcrumb' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://truejoybirthing.com/invite/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://truejoybirthing.com/' },
        { '@type': 'ListItem', position: 2, name: 'Invite', item: 'https://truejoybirthing.com/invite/' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://truejoybirthing.com/invite/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Is True Joy Birthing free?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. The birth plan builder, care team messaging, and birth education content are completely free for expecting moms. Birth professionals get a 14-day free trial of TJB Pro, then $29/month.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do I need an invite code to join?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. You can download the app and create a free account anytime. An invite link from your doula or midwife simply personalizes your experience by connecting you to their care team automatically.',
          },
        },
        {
          '@type': 'Question',
          name: 'What does True Joy Birthing do?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'True Joy Birthing is A birth plan app that lets you build a structured birth plan, share it with your care team, message your doula or midwife, and walk through every birth decision with video guidance from a certified doula.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can my doula or midwife see my birth plan?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. When you join through an invite link from your doula or midwife, your birth plan is shared with them automatically. You can also share it manually inside the app at any time.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonical="https://truejoybirthing.com/invite/"
  breadcrumbList={breadcrumbList}
  schema={schema}
  ogImage="/images/og/og-invite.png"
  ogImageAlt="True Joy Birthing app, birth plan builder screen"
>
  <!-- ═══ Hero — Split Layout ═══ -->
  <section class="bg-tjb-cream pt-16 pb-12">
    <nav class="max-w-6xl mx-auto px-6 pt-4" aria-label="Breadcrumb"><ol class="flex items-center gap-2 text-sm text-tjb-gray"><li><a href="/" class="hover:underline">Home</a></li><li aria-hidden="true">/</li><li class="text-tjb-charcoal font-medium" aria-current="page">Invite</li></ol></nav>
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
        <div>
          <!-- Loading indicator (hidden once JS runs) -->
          <div id="invite-loading" class="flex items-center gap-3 text-tjb-gray text-sm mb-4">
            <svg class="animate-spin h-4 w-4 text-tjb-lavender-600" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span>Loading your invitation…</span>
          </div>
          <noscript><style>#invite-loading { display: none !important; }</style></noscript>

          <p class="eyebrow text-tjb-rose-500 uppercase text-xs font-semibold tracking-widest mb-4">You've been invited</p>
          <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
          <h1 id="invite-headline" class="text-3xl md:text-4xl font-bold mb-4" style="font-family: 'DM Serif Display', Georgia, serif;">
            Welcome to True Joy Birthing
          </h1>
          <p id="invite-subtitle" class="text-lg text-tjb-charcoal font-semibold mb-2">
            The free app your birth team uses to share your plan and stay connected.
          </p>
          <p id="invite-subtitle-2" class="text-tjb-gray mb-6">
            Build your <a href="/birth-plan-template/" class="text-tjb-lavender-600 hover:underline">birth plan</a>, connect with your care team, and feel confident going into your delivery.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 items-start">
            <a href={APP_STORE_URL} class="inline-block focus-visible:outline focus-visible:outline-3 focus-visible:outline-tjb-lavender-400 focus-visible:outline-offset-2 transition-opacity hover:opacity-90" style="line-height:0" id="hero-cta-appstore" rel="noopener">
              <img src="/images/app-store-badge.svg" alt="Download on the App Store" class="h-12 w-auto" width="120" height="40" loading="eager" />
            </a>
            <a href={GOOGLE_PLAY_URL} class="inline-block focus-visible:outline focus-visible:outline-3 focus-visible:outline-tjb-lavender-400 focus-visible:outline-offset-2 transition-opacity hover:opacity-90" style="line-height:0" id="hero-cta-googleplay" rel="noopener">
              <img src="/images/google-play-badge.png" alt="Get it on Google Play" class="h-12 w-auto" width="159" height="48" loading="eager" />
            </a>
          </div>
          <p class="text-xs text-tjb-gray mt-3">Free. No account needed to start.</p>
          <p class="text-xs text-tjb-gray mt-2">Your birth plan is private. Only your care team can see it.</p>
          <!-- Personal message container (hidden until invite data loads) -->
          <div id="invite-message-wrap" class="hidden mt-6 p-4 bg-white rounded-xl border border-tjb-lavender-200/60">
            <p class="text-xs uppercase tracking-widest text-tjb-rose-500 font-semibold mb-2">A message from <span id="invite-message-from">your inviter</span></p>
            <p id="invite-message-text" class="text-sm text-tjb-charcoal italic leading-relaxed"></p>
          </div>
        </div>
        <div class="relative">
          <picture>
            <source
              type="image/webp"
              srcset="/images/tjb-app-birth-plan-builder.webp"
            />
            <img
              src="/images/tjb-app-birth-plan-builder.png"
              alt="True Joy Birthing app, birth plan builder screen"
              class="w-full rounded-2xl shadow-lg"
              loading="eager"
              fetchpriority="high"
              width="390"
              height="844"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Value Props — 4 Cards ═══ -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="eyebrow text-tjb-rose-500 uppercase text-xs font-semibold tracking-widest mb-4">Why join</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
        <h2 class="text-2xl md:text-3xl font-bold text-tjb-charcoal mb-3" style="font-family: 'DM Sans', sans-serif;">
          Everything you need for a supported birth
        </h2>
        <p class="text-tjb-gray max-w-2xl mx-auto" id="value-props-intro">
          True Joy Birthing brings birth plans, your care team, and practice tools together in one free app.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <div class="w-10 h-10 rounded-lg bg-tjb-lavender-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-tjb-lavender-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <p class="font-semibold text-tjb-charcoal mb-2" id="value-prop-1">See birth plans instantly</p>
          <p class="text-sm text-tjb-gray">View shared birth plans in the app the moment you join. No email attachments, no lost PDFs.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <div class="w-10 h-10 rounded-lg bg-tjb-rose-50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-tjb-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <p class="font-semibold text-tjb-charcoal mb-2">Message and schedule appointments</p>
          <p class="text-sm text-tjb-gray">Chat with your birth team inside the app. Schedule appointments, share updates, and keep everything in one place.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <div class="w-10 h-10 rounded-lg bg-tjb-rose-50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-tjb-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </div>
          <p class="font-semibold text-tjb-charcoal mb-2">Birth education video guidance</p>
          <p class="text-sm text-tjb-gray">Walk through every birth decision with video guidance from a certified doula. Understand your options before you deliver.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <div class="w-10 h-10 rounded-lg bg-tjb-rose-50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-tjb-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <p class="font-semibold text-tjb-charcoal mb-2">Join free in seconds</p>
          <p class="text-sm text-tjb-gray">Download the app, create a free account, and you're in. No credit card, no commitment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ How It Works — 3 Steps ═══ -->
  <section class="py-16 bg-tjb-cream">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="eyebrow text-tjb-rose-500 uppercase text-xs font-semibold tracking-widest mb-4">Getting started</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
        <h2 class="text-2xl md:text-3xl font-bold text-tjb-charcoal mb-3" style="font-family: 'DM Serif Display', Georgia, serif;">
          How True Joy Birthing works
        </h2>
        <p class="text-tjb-gray max-w-2xl mx-auto">
          Three simple steps from download to a birth plan your whole care team can see.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-tjb-lavender-600 text-white flex items-center justify-center mx-auto mb-4 font-bold text-lg">1</div>
          <h3 class="font-semibold text-tjb-charcoal mb-2">Download the app</h3>
          <p class="text-sm text-tjb-gray">Free on the App Store. Create an account in under 60 seconds. No credit card needed.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-tjb-lavender-600 text-white flex items-center justify-center mx-auto mb-4 font-bold text-lg">2</div>
          <h3 class="font-semibold text-tjb-charcoal mb-2">Build your birth plan</h3>
          <p class="text-sm text-tjb-gray">Answer guided questions about labor, delivery, and newborn care. Get a clean, structured plan your care team can actually read.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-tjb-lavender-600 text-white flex items-center justify-center mx-auto mb-4 font-bold text-lg">3</div>
          <h3 class="font-semibold text-tjb-charcoal mb-2">Share with your team</h3>
          <p class="text-sm text-tjb-gray">Send your birth plan to your doula, midwife, or OB directly in the app. Message, schedule, and stay aligned.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ — SEO + Schema ═══ -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="eyebrow text-tjb-rose-500 uppercase text-xs font-semibold tracking-widest mb-4">Questions</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
        <h2 class="text-2xl md:text-3xl font-bold text-tjb-charcoal mb-3" style="font-family: 'DM Serif Display', Georgia, serif;">
          Common questions about True Joy Birthing
        </h2>
      </div>
      <div class="space-y-6">
        <div class="border-b border-tjb-lavender-200/40 pb-6">
          <h3 class="font-semibold text-tjb-charcoal mb-2 text-lg">Is True Joy Birthing free?</h3>
          <p class="text-tjb-gray leading-relaxed faq-answer">Yes. The birth plan builder, care team messaging, and birth education content are completely free for expecting moms. Birth professionals get a 14-day free trial of TJB Pro, then $29/month.</p>
        </div>
        <div class="border-b border-tjb-lavender-200/40 pb-6">
          <h3 class="font-semibold text-tjb-charcoal mb-2 text-lg">Do I need an invite code to join?</h3>
          <p class="text-tjb-gray leading-relaxed faq-answer">No. You can download the app and create a free account anytime. An invite link from your doula or midwife simply personalizes your experience by connecting you to their care team automatically.</p>
        </div>
        <div class="border-b border-tjb-lavender-200/40 pb-6">
          <h3 class="font-semibold text-tjb-charcoal mb-2 text-lg">What does True Joy Birthing do?</h3>
          <p class="text-tjb-gray leading-relaxed faq-answer">True Joy Birthing is A birth plan app that lets you build a structured birth plan, share it with your care team, message your doula or midwife, and walk through every birth decision with video guidance from a certified doula.</p>
        </div>
        <div class="border-b border-tjb-lavender-200/40 pb-6">
          <h3 class="font-semibold text-tjb-charcoal mb-2 text-lg">Can my doula or midwife see my birth plan?</h3>
          <p class="text-tjb-gray leading-relaxed faq-answer">Yes. When you join through an invite link from your doula or midwife, your birth plan is shared with them automatically. You can also share it manually inside the app at any time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Creator Trust Marker ═══ -->
  <section class="py-8 bg-white">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-sm text-tjb-gray">Created by Shelbi, certified birth doula</p>
    </div>
  </section>

  <!-- ═══ Download CTA ═══ -->
  <section class="py-20 bg-tjb-cream">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="eyebrow text-tjb-rose-500 uppercase text-xs font-semibold tracking-widest mb-4">Get started</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
      <h2 class="text-2xl md:text-3xl font-bold text-tjb-charcoal mb-4" style="font-family: 'DM Serif Display', Georgia, serif;" id="download-headline">
        Download True Joy Birthing
      </h2>
      <p class="text-tjb-gray mb-8" id="download-subtitle">
        Free for moms. 14-day free trial for birth professionals.
      </p>
      <div class="flex flex-wrap gap-4 justify-center items-center mb-6">
        <a href={APP_STORE_URL} class="inline-block focus-visible:outline focus-visible:outline-3 focus-visible:outline-tjb-lavender-400 focus-visible:outline-offset-2 transition-opacity hover:opacity-90" style="line-height:0" rel="noopener">
          <img src="/images/app-store-badge.svg" alt="Download on the App Store" class="h-12 w-auto" width="120" height="40" loading="lazy" />
        </a>
        <a href={GOOGLE_PLAY_URL} class="inline-block focus-visible:outline focus-visible:outline-3 focus-visible:outline-tjb-lavender-400 focus-visible:outline-offset-2 transition-opacity hover:opacity-90" style="line-height:0" rel="noopener">
          <img src="/images/google-play-badge.png" alt="Get it on Google Play" class="h-12 w-auto" width="159" height="48" loading="lazy" />
        </a>
      </div>
      <a href="/" class="text-sm text-tjb-lavender-600 hover:underline font-medium">I already have the app</a>
    </div>
  </section>

  <!-- ═══ Client-side invite data fetch ═══ -->
  <script is:inline>
    (function () {
      var API_BASE = 'https://api.truejoybirthing.com';
      var FETCH_TIMEOUT_MS = 8000;
      var TRACK_KEY_PREFIX = 'tjb_invite_tracked_';
      var INVITE_ID_RE = /^[a-zA-Z0-9_-]+$/;

      // Abort any in-flight fetch from a previous view transition to prevent
      // out-of-order resolution races.
      if (window.__tjbInviteController) {
        try { window.__tjbInviteController.abort(); } catch (e) {}
      }
      var controller = (typeof AbortController !== 'undefined') ? new AbortController() : null;
      window.__tjbInviteController = controller;
      var timeoutId = null;
      if (controller) {
        timeoutId = window.setTimeout(function () { controller.abort(); }, FETCH_TIMEOUT_MS);
      }

      // Extract invite_id from URL path: /invite/inv_abc123 -> inv_abc123
      var path = window.location.pathname;
      var parts = path.split('/').filter(Boolean); // ['invite', 'inv_abc123']
      var inviteId = parts.length > 1 && parts[0] === 'invite' ? parts[1] : null;

      // Query param fallback: /invite/?id=inv_abc123
      if (!inviteId) {
        try {
          var qp = new URLSearchParams(window.location.search).get('id');
          if (qp) inviteId = qp;
        } catch (e) {}
      }

      var loadingEl = document.getElementById('invite-loading');

      function hideLoading() {
        if (loadingEl) loadingEl.classList.add('hidden');
      }

      // If no invite_id in URL, hide spinner and leave the generic welcome as-is
      if (!inviteId) {
        hideLoading();
        return;
      }

      // Sanitize + validate inviteId format
      inviteId = (inviteId || '').trim();
      if (!inviteId || !INVITE_ID_RE.test(inviteId)) {
        hideLoading();
        return;
      }

      var headlineEl = document.getElementById('invite-headline');
      var subtitleEl = document.getElementById('invite-subtitle');
      var subtitle2El = document.getElementById('invite-subtitle-2');
      var msgWrap = document.getElementById('invite-message-wrap');
      var msgFromEl = document.getElementById('invite-message-from');
      var msgTextEl = document.getElementById('invite-message-text');
      var valueIntroEl = document.getElementById('value-props-intro');
      var vp1El = document.getElementById('value-prop-1');
      var dlHeadlineEl = document.getElementById('download-headline');
      var dlSubtitleEl = document.getElementById('download-subtitle');

      // Fire-and-forget track-open with sessionStorage dedup (once per session per invite)
      var trackKey = TRACK_KEY_PREFIX + inviteId;
      var alreadyTracked = false;
      try {
        alreadyTracked = sessionStorage.getItem(trackKey) === '1';
      } catch (e) {}

      if (!alreadyTracked) {
        try {
          var trackUrl = API_BASE + '/api/invites/' + encodeURIComponent(inviteId) + '/track-open';
          var trackBody = JSON.stringify({});
          if (navigator && typeof navigator.sendBeacon === 'function') {
            var blob = new Blob([trackBody], { type: 'application/json' });
            var queued = navigator.sendBeacon(trackUrl, blob);
            // sendBeacon returns false if the browser couldn't queue it
            if (queued) {
              try { sessionStorage.setItem(trackKey, '1'); } catch (e) {}
            } else {
              // Fall back to fetch with keepalive
              fetch(trackUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: trackBody,
                keepalive: true,
              }).then(function () {
                try { sessionStorage.setItem(trackKey, '1'); } catch (e) {}
              }).catch(function () {
                // Remove flag so it can retry next load — but if no flag was
                // set, just leave things as-is (nothing to remove).
              });
            }
          } else {
            // sendBeacon not available — use fetch with keepalive
            fetch(trackUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: trackBody,
              keepalive: true,
            }).then(function () {
              try { sessionStorage.setItem(trackKey, '1'); } catch (e) {}
            }).catch(function () {
              // Remove flag so it can retry next load
              try { sessionStorage.removeItem(trackKey); } catch (e) {}
            });
          }
        } catch (e) {}
      }

      // Fetch invite data
      var fetchOpts = { headers: { 'Accept': 'application/json' } };
      if (controller) {
        fetchOpts.signal = controller.signal;
      }

      fetch(API_BASE + '/api/invites/' + encodeURIComponent(inviteId), fetchOpts)
        .then(function (res) {
          if (!res.ok) {
            throw new Error('HTTP ' + res.status);
          }
          return res.json();
        })
        .then(function (data) {
          if (timeoutId) window.clearTimeout(timeoutId);
          hideLoading();

          if (!data || data.status === 'expired' || data.status === 'invalid' || data.status === 'not_found') {
            // Keep generic welcome — already rendered
            return;
          }

          var inviterName = (data.inviter_name || '').trim();
          if (!inviterName) return; // generic fallback

          // Hero
          if (headlineEl) {
            headlineEl.textContent = inviterName + ' invited you to join True Joy Birthing';
          }
          if (subtitleEl) {
            subtitleEl.textContent = inviterName + ' uses True Joy Birthing to share birth plans and communicate with their birth team.';
          }
          if (subtitle2El) {
            subtitle2El.textContent = "Join free to see " + inviterName + "'s birth plan and start messaging.";
          }

          // Personal message
          if (data.personal_message && data.personal_message.trim()) {
            if (msgFromEl) msgFromEl.textContent = inviterName;
            if (msgTextEl) msgTextEl.textContent = '"' + data.personal_message.trim() + '"';
            if (msgWrap) msgWrap.classList.remove('hidden');
          }

          // Value props intro
          if (valueIntroEl) {
            valueIntroEl.textContent = inviterName + " uses True Joy Birthing to plan and share. Here's what you get when you join:";
          }

          // Value prop 1 — personalize
          if (vp1El) {
            vp1El.textContent = "See " + inviterName + "'s birth plan instantly";
          }

          // Download section
          if (dlHeadlineEl) {
            dlHeadlineEl.textContent = "Join " + inviterName + " on True Joy Birthing";
          }
          if (dlSubtitleEl) {
            var role = (data.invitee_role || '').toLowerCase();
            var isPro = role.includes('doula') || role.includes('midwife') || role.includes('professional');
            dlSubtitleEl.textContent = isPro
              ? 'Free for moms. Birth professionals get a 14-day free trial of TJB Pro.'
              : 'Free for moms. No credit card needed.';
          }

          // Update document title
          document.title = inviterName + ' invited you to True Joy Birthing';
        })
        .catch(function (err) {
          if (timeoutId) window.clearTimeout(timeoutId);
          // On error, keep generic welcome (already rendered)
          hideLoading();
        });
    })();
  </script>
</Layout>