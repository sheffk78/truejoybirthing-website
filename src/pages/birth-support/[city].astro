  {/* ═══ Filter bar inline JS (with Phase 3A SEO enhancements) ═══ */}
  {showFilterBar && (
    <script type="module" data-filter-seo-map={filterSEOJson}>
      (function() {
        const activeFilters = new Set();
        const cards = document.querySelectorAll('.doula-card');
        const chips = document.querySelectorAll('.filter-chip');
        const clearBtn = document.getElementById('clear-filters');
        const noResults = document.getElementById('no-filter-results');

        // ═══ Phase 3A: SEO data ═══
        const scriptTag = document.querySelector('script[data-filter-seo-map]');
        const filterSEOMap = JSON.parse(scriptTag?.dataset.filterSeoMap || '{}');
        const baseTitle = document.title;
        const baseMeta = document.querySelector('meta[name="description"]')?.getAttribute('content') || '';
        const filterFaqSection = document.getElementById('filter-faq');
        const filterFaqTitle = document.getElementById('filter-faq-title');
        const filterFaqItems = document.getElementById('filter-faq-items');
        let faqSchemaScript = document.getElementById('filter-faq-schema');

        function updateSEO() {
          // Find the first active filter that has SEO data
          let seoData = null;
          for (const f of activeFilters) {
            if (filterSEOMap[f]) {
              seoData = filterSEOMap[f];
              break;
            }
          }

          if (seoData) {
            // Update title
            document.title = seoData.title;

            // Update meta description
            let metaTag = document.querySelector('meta[name="description"]');
            if (metaTag) {
              metaTag.setAttribute('content', seoData.meta);
            } else {
              metaTag = document.createElement('meta');
              metaTag.setAttribute('name', 'description');
              metaTag.setAttribute('content', seoData.meta);
              document.head.appendChild(metaTag);
            }

            // Update canonical URL
            const params = new URLSearchParams(window.location.search);
            const filterVal = params.get('filter');
            if (filterVal) {
              const canonicalUrl = window.location.origin + window.location.pathname + '?filter=' + filterVal;
              let canonicalTag = document.querySelector('link[rel="canonical"]');
              if (canonicalTag) {
                canonicalTag.setAttribute('href', canonicalUrl);
              } else {
                canonicalTag = document.createElement('link');
                canonicalTag.setAttribute('rel', 'canonical');
                canonicalTag.setAttribute('href', canonicalUrl);
                document.head.appendChild(canonicalTag);
              }
            }

            // Update FAQ section
            if (filterFaqSection && filterFaqTitle && filterFaqItems && seoData.faqs && seoData.faqs.length > 0) {
              filterFaqTitle.textContent = seoData.title;
              filterFaqItems.innerHTML = '';
              seoData.faqs.forEach((faq) => {
                const details = document.createElement('details');
                details.className = 'border border-tjb-lavender-200 rounded-xl p-5 bg-white group';
                const summary = document.createElement('summary');
                summary.className = 'text-lg font-semibold text-tjb-charcoal cursor-pointer list-none flex justify-between items-center';
                const span = document.createElement('span');
                span.textContent = faq.q;
                const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                svg.setAttribute('class', 'w-5 h-5 text-tjb-lavender-500 transition-transform group-open:rotate-180 flex-shrink-0 ml-2');
                svg.setAttribute('fill', 'none');
                svg.setAttribute('viewBox', '0 0 24 24');
                svg.setAttribute('stroke', 'currentColor');
                svg.setAttribute('stroke-width', '2');
                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('stroke-linecap', 'round');
                path.setAttribute('stroke-linejoin', 'round');
                path.setAttribute('d', 'M19 9l-7 7-7-7');
                svg.appendChild(path);
                summary.appendChild(span);
                summary.appendChild(svg);
                const p = document.createElement('p');
                p.className = 'text-tjb-gray mt-3 faq-answer';
                p.textContent = faq.a;
                details.appendChild(summary);
                details.appendChild(p);
                filterFaqItems.appendChild(details);
              });
              filterFaqSection.classList.remove('hidden');
              filterFaqSection.setAttribute('aria-hidden', 'false');

              // Update FAQ JSON-LD schema
              if (faqSchemaScript) {
                faqSchemaScript.remove();
              }
              const faqSchema = {
                '@context': 'https://schema.org',
                '@type': 'FAQPage',
                mainEntity: seoData.faqs.map((f) => ({
                  '@type': 'Question',
                  name: f.q,
                  acceptedAnswer: { '@type': 'Answer', text: f.a },
                })),
              };
              faqSchemaScript = document.createElement('script');
              faqSchemaScript.id = 'filter-faq-schema';
              faqSchemaScript.type = 'application/ld+json';
              faqSchemaScript.textContent = JSON.stringify(faqSchema);
              document.head.appendChild(faqSchemaScript);
            }
          } else {
            // Restore base title and meta
            document.title = baseTitle;
            let metaTag = document.querySelector('meta[name="description"]');
            if (metaTag) {
              metaTag.setAttribute('content', baseMeta);
            }

            // Restore canonical to base URL
            const baseCanonical = window.location.origin + window.location.pathname;
            let canonicalTag = document.querySelector('link[rel="canonical"]');
            if (canonicalTag) {
              canonicalTag.setAttribute('href', baseCanonical);
            }

            // Hide FAQ section and clear stale FAQ DOM
            if (filterFaqSection) {
              filterFaqSection.classList.add('hidden');
              filterFaqSection.setAttribute('aria-hidden', 'true');
            }
            if (filterFaqItems) {
              filterFaqItems.innerHTML = '';
            }
            if (faqSchemaScript) {
              faqSchemaScript.remove();
              faqSchemaScript = null;
            }
          }
        }

        function applyFilters() {
          let visibleCount = 0;
          cards.forEach(card => {
            const visible = [...activeFilters].every(f => {
              const [type, value] = f.split(':');
              const attr = 'data-' + type.replace('service', 'services').replace('cost', 'cost-tier').replace('language', 'languages');
              const val = card.getAttribute(attr) || '';
              if (type === 'medicaid' || type === 'accepting' || type === 'midwife' || type === 'lactation') {
                return val === value;
              }
              return val.split(',').includes(value);
            });
            card.style.display = visible ? '' : 'none';
            if (visible) visibleCount++;
          });
          if (noResults) noResults.classList.toggle('hidden', visibleCount > 0);
          if (clearBtn) clearBtn.classList.toggle('hidden', activeFilters.size === 0);
        }

        function updateURL() {
          const params = new URLSearchParams(window.location.search);
          if (activeFilters.size > 0) {
            params.set('filter', [...activeFilters].join(','));
          } else {
            params.delete('filter');
          }
          const newURL = window.location.pathname + (params.toString() ? '?' + params.toString() : '') + window.location.hash;
          window.history.replaceState({}, '', newURL);
        }

        chips.forEach(chip => {
          chip.addEventListener('click', () => {
            const filter = chip.dataset.filter;
            if (activeFilters.has(filter)) {
              activeFilters.delete(filter);
              chip.classList.remove('active');
              chip.style.background = '';
              chip.style.borderColor = '';
              chip.style.color = '';
            } else {
              activeFilters.add(filter);
              chip.classList.add('active');
              chip.style.background = '#fce7f3';
              chip.style.borderColor = '#f9a8d4';
              chip.style.color = '#be185d';
            }
            applyFilters();
            updateURL();
            updateSEO();
          });
        });

        function clearAll() {
          activeFilters.clear();
          chips.forEach(chip => {
            chip.classList.remove('active');
            chip.style.background = '';
            chip.style.borderColor = '';
            chip.style.color = '';
          });
          applyFilters();
          updateURL();
          updateSEO();
        }

        if (clearBtn) clearBtn.addEventListener('click', clearAll);
        const noResultsClear = noResults?.querySelector('button');
        if (noResultsClear) noResultsClear.addEventListener('click', clearAll);

        // Read filters from URL on load
        const params = new URLSearchParams(window.location.search);
        const filterParam = params.get('filter');
        if (filterParam) {
          filterParam.split(',').forEach(f => {
            const chip = document.querySelector(`[data-filter="${f}"]`);
            if (chip) {
              activeFilters.add(f);
              chip.classList.add('active');
              chip.style.background = '#fce7f3';
              chip.style.borderColor = '#f9a8d4';
              chip.style.color = '#be185d';
            }
          });
          applyFilters();
          updateSEO();
        }
      })();
    </script>
  )}


