---
// ═══════════════════════════════════════════════════════════════
// Dynamic city birth-support page — single template for all cities
// Written directly to expectant moms, especially first-time moms
// Denver flagship pattern (June 2026): split hero, app showcase,
// testimonials, two-column section illustrations, centered doula cards,
// hospital thumbnails, serif H2s for story sections, CTA card with
// booklet mockup, lead capture with banner image
// ═══════════════════════════════════════════════════════════════
import Layout from '../../layouts/Layout.astro';
import CityLeadCaptureForm from '../../components/city/LeadCaptureForm.astro';
import AppShowcase from '../../components/AppShowcase.astro';
import ContextualCityLinks from '../../components/ContextualCityLinks.astro';
import { cities, citySlugs, type CityData } from '../../data/cities';
import { cityVideoEmbeds } from '../../data/video-embeds';
import { getRelatedCities } from '../../data/related-cities';

export function getStaticPaths() {
  return citySlugs.map((slug) => ({
    params: { city: slug },
    props: { data: cities[slug]!, slug },
  }));
}

const { data, slug } = Astro.props;
const {
  city, state, costLow, costHigh, culture,
  heroLocalDetail, hospitalDetails, birthCenterDetails,
  localDoulas, medicaidNote, insuranceNote, faqs, nearbyCities,
  testimonials,
  heroImage: heroImageSlug, supportSceneImage, supportSceneAlt, ogImage: ogImageSlug,
  costSectionImage, insuranceSectionImage, midwifeSectionImage,
  midwifeInfo,
  lactationSectionImage,
  lactationInfo,
  birthStats,
  postpartumSection,
  providerReviewSection,
}: CityData = data;

// Medicaid helper (must come before pageDesc)
const medicaidCovers = !medicaidNote.includes('does not') && !medicaidNote.includes('does NOT');
const stateHubSlug = state.toLowerCase().replace(/\s+/g, '-');
// MT has no dedicated state hub (its only city is Bozeman). Link the state-hub
// breadcrumb / "All Montana Cities" CTA directly to the real city page so we
// avoid the /birth-support/mt/ path, which is intentionally not surfaced elsewhere
// (see index.astro, [state].astro, and ContextualCityLinks.astro).
const effectiveStateHubSlug = state.toUpperCase() === 'MT' ? 'bozeman-mt' : stateHubSlug;

// Deterministic anchor text rotation for /doula-cost/ inline link (costs section).
// Prevents over-optimization: 5 full-sentence variants distributed across 90+ city pages.
// Same city always gets the same variant (deterministic via slug hash).
// Each variant wraps a different natural anchor phrase in the <a> tag.
const doulaCostLinkVariants = [
  'See our <a href="/doula-cost/" class="text-tjb-rose-600 hover:underline">full doula cost breakdown</a> for what\'s included and what to ask about.',
  'Want to know <a href="/doula-cost/" class="text-tjb-rose-600 hover:underline">how much a doula costs</a>? Our complete guide breaks down typical packages and what\'s included.',
  'For a <a href="/doula-cost/" class="text-tjb-rose-600 hover:underline">complete doula cost breakdown</a> — including what\'s included and what to ask about — see our full guide.',
  'Compare <a href="/doula-cost/" class="text-tjb-rose-600 hover:underline">doula pricing and what\'s included</a> in our detailed cost guide for {city} families.',
  'Curious <a href="/doula-cost/" class="text-tjb-rose-600 hover:underline">what doulas charge in your area</a>? Our cost guide covers typical ranges, what\'s included, and what to ask about.',
];
const doulaCostLinkIndex = slug.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0) % doulaCostLinkVariants.length;
const doulaCostLinkHtml = doulaCostLinkVariants[doulaCostLinkIndex].replace(/{city}/g, city);
const hasBirthCenters = birthCenterDetails.some((bc) => !bc.name.toLowerCase().includes('no '));

// Cross-city provider data: cities that share doulas/midwives with this city
const sharedProviderCities = getRelatedCities(slug);

// ═══ Filter bar data — collect available filter values from localDoulas ═══
// Only show filter chips for values that exist in this city's doulas
const filterServiceValues = new Set<string>();
const filterLanguageValues = new Set<string>();
let filterHasMedicaid = false;
let filterHasAccepting = false;
let filterHasMidwife = false;
let filterHasLactation = false;
const filterCostTiers = new Set<string>();

const slugify = (s: string) => s.toLowerCase().trim().replace(/\s+/g, '-');

localDoulas?.forEach((d) => {
  d.services?.forEach((s) => filterServiceValues.add(s));
  d.languages?.forEach((l) => filterLanguageValues.add(l));
  if (d.acceptsMedicaid) filterHasMedicaid = true;
  if (d.acceptingClients) filterHasAccepting = true;
  if (d.isMidwife) filterHasMidwife = true;
  if (d.isLactation) filterHasLactation = true;
  if (d.costRange) {
    const m = d.costRange.match(/\$([\d,]+)/);
    if (m) {
      const low = parseInt(m[1].replace(/,/g, ''));
      if (low < 1000) filterCostTiers.add('under-1000');
      else if (low <= 2000) filterCostTiers.add('1000-2000');
      else filterCostTiers.add('over-2000');
    }
  }
});

const showFilterBar = (localDoulas?.length || 0) >= 2 && (
  filterServiceValues.size > 0 || filterHasMedicaid || filterHasAccepting ||
  filterHasMidwife || filterHasLactation || filterCostTiers.size > 0 || filterLanguageValues.size > 0
);

// State full name for breadcrumbs (SEO: "Colorado" not "CO")
const stateNames: Record<string, string> = {
  AL: 'Alabama', AK: 'Alaska', AZ: 'Arizona', AR: 'Arkansas', CA: 'California',
  CO: 'Colorado', CT: 'Connecticut', DE: 'Delaware', FL: 'Florida', GA: 'Georgia',
  HI: 'Hawaii', ID: 'Idaho', IL: 'Illinois', IN: 'Indiana', IA: 'Iowa',
  KS: 'Kansas', KY: 'Kentucky', LA: 'Louisiana', ME: 'Maine', MD: 'Maryland',
  MA: 'Massachusetts', MI: 'Michigan', MN: 'Minnesota', MS: 'Mississippi', MO: 'Missouri',
  MT: 'Montana', NE: 'Nebraska', NV: 'Nevada', NH: 'New Hampshire', NJ: 'New Jersey',
  NM: 'New Mexico', NY: 'New York', NC: 'North Carolina', ND: 'North Dakota', OH: 'Ohio',
  OK: 'Oklahoma', OR: 'Oregon', PA: 'Pennsylvania', RI: 'Rhode Island', SC: 'South Carolina',
  SD: 'South Dakota', TN: 'Tennessee', TX: 'Texas', UT: 'Utah', VT: 'Vermont',
  VA: 'Virginia', WA: 'Washington', WV: 'West Virginia', WI: 'Wisconsin', WY: 'Wyoming',
  DC: 'District of Columbia',
};
const stateFullName = stateNames[state] || state;

// ═══ Phase 3A: Niche-Down Filter SEO data ═══
// Build list of available "niche" filters for internal linking and SEO.
// Each entry maps a URL filter param value to display info.
// We only include filters that have matching providers in this city.
const nicheFilters: Array<{ param: string; label: string; titleTemplate: string; metaTemplate: string }> = [];

if (filterHasMedicaid) {
  nicheFilters.push({
    param: 'medicaid:yes',
    label: 'Medicaid doulas',
    titleTemplate: 'Medicaid-Accepting Birth Doulas in {city}, {state}',
    metaTemplate: 'Find Medicaid-accepting birth doulas in {city}, {state}. Filter by insurance, services, and more on True Joy Birthing.',
  });
}

// Check for VBAC-supportive doulas (service contains "VBAC" or "vbac")
const hasVbac = [...filterServiceValues].some((s) => s.toLowerCase().includes('vbac'));
if (hasVbac) {
  nicheFilters.push({
    param: 'service:vbac',
    label: 'VBAC doulas',
    titleTemplate: 'VBAC-Supportive Birth Doulas in {city}, {state}',
    metaTemplate: 'Find VBAC-supportive birth doulas in {city}, {state}. Filter by VBAC experience and services on True Joy Birthing.',
  });
}

// Check for Spanish-speaking doulas
const hasSpanish = [...filterLanguageValues].some((l) => l.toLowerCase().includes('spanish'));
if (hasSpanish) {
  nicheFilters.push({
    param: 'language:spanish',
    label: 'Spanish-speaking doulas',
    titleTemplate: 'Spanish-Speaking Birth Doulas in {city}, {state}',
    metaTemplate: 'Find Spanish-speaking birth doulas in {city}, {state}. Filter by language and services on True Joy Birthing.',
  });
}

// Check for home birth support
const hasHomeBirth = [...filterServiceValues].some((s) => s.toLowerCase().includes('home birth'));
if (hasHomeBirth) {
  nicheFilters.push({
    param: 'service:home-birth',
    label: 'Home birth',
    titleTemplate: 'Home Birth Midwives & Doulas in {city}, {state}',
    metaTemplate: 'Find home birth midwives and doulas in {city}, {state}. Filter by home birth support and services on True Joy Birthing.',
  });
}

// Check for water birth support
const hasWaterBirth = [...filterServiceValues].some((s) => s.toLowerCase().includes('water birth'));
if (hasWaterBirth) {
  nicheFilters.push({
    param: 'service:water-birth',
    label: 'Water birth',
    titleTemplate: 'Water Birth Support in {city}, {state}',
    metaTemplate: 'Find water birth support and doulas in {city}, {state}. Filter by water birth options and services on True Joy Birthing.',
  });
}

// Check for birth center support
const hasBirthCenterService = [...filterServiceValues].some((s) => s.toLowerCase().includes('birth center'));
if (hasBirthCenterService || hasBirthCenters) {
  nicheFilters.push({
    param: 'service:birth-center',
    label: 'Birth centers',
    titleTemplate: 'Birth Centers in {city}, {state}',
    metaTemplate: 'Find birth centers in {city}, {state}. Filter by birth center support and services on True Joy Birthing.',
  });
}

// Check for lactation support — show when any localDoulas entry has
// isLactation: true OR a "Lactation" service tag.
const hasLactationService = filterHasLactation
  || [...filterServiceValues].some((s) => s.toLowerCase().includes('lactation'));
if (hasLactationService) {
  nicheFilters.push({
    param: 'service:lactation',
    label: 'Lactation support',
    titleTemplate: 'Lactation Consultants & Support in {city}, {state}',
    metaTemplate: 'Find IBCLC lactation consultants and lactation support in {city}, {state}. Filter by insurance, home visits, and virtual consults on True Joy Birthing.',
  });
}

// Build a JSON-serializable map of filter param → {title, meta, faqs} for client-side JS
const filterSEOMap: Record<string, { title: string; meta: string; faqs: Array<{ q: string; a: string }> }> = {};
for (const nf of nicheFilters) {
  const title = nf.titleTemplate.replace(/{city}/g, city).replace(/{state}/g, state);
  const meta = nf.metaTemplate.replace(/{city}/g, city).replace(/{state}/g, state);
  let faqs: Array<{ q: string; a: string }> = [];
  if (nf.param === 'medicaid:yes') {
    faqs = [
      { q: `How do I find a Medicaid-accepting doula in ${city}?`, a: `Use the filter bar above and select "Medicaid" to see doulas in ${city}, ${state} who accept Medicaid. You can also check with your local WIC office or Medicaid managed care plan for a list of enrolled doula providers.` },
      { q: `Does ${state} Medicaid cover doula services?`, a: medicaidCovers ? `Yes, ${stateFullName} Medicaid covers doula services. Contact your Medicaid plan to confirm coverage details and find enrolled providers in the ${city} area.` : `Currently, ${stateFullName} does not cover doulas through Medicaid. Some community organizations and volunteer doula programs in ${city} may offer free or reduced-cost support.` },
    ];
  } else if (nf.param === 'service:vbac') {
    faqs = [
      { q: `Can I get VBAC support from a doula in ${city}?`, a: `Yes, the doulas listed above offer VBAC support. Use the "VBAC" filter to see providers in ${city} who have experience supporting vaginal birth after cesarean.` },
      { q: `What should I ask a VBAC doula in ${city}?`, a: `Ask about their experience with VBAC births, which ${city} hospitals support VBAC, and how they help you prepare mentally and physically for a VBAC labor.` },
    ];
  } else if (nf.param === 'language:spanish') {
    faqs = [
      { q: `How do I find a Spanish-speaking doula in ${city}?`, a: `Use the language filter above and select "Spanish" to see doulas in ${city}, ${state} who offer services in Spanish. You can also ask providers directly if they have Spanish-speaking staff.` },
      { q: `Are there bilingual doulas in ${city}?`, a: `Yes, several doulas in ${city} offer bilingual support. Filter by language to find Spanish-speaking providers who can communicate with you and your family in your preferred language.` },
    ];
  } else if (nf.param === 'service:home-birth') {
    faqs = [
      { q: `Can I have a home birth in ${city}?`, a: `Yes, there are doulas and midwives in ${city} who support home births. Use the "Home birth" filter to see providers who offer home birth services in the ${city} area.` },
      { q: `What does a home birth doula in ${city} do?`, a: `A home birth doula provides the same emotional, physical, and informational support as a hospital doula, but in your home. They help with labor comfort techniques and work alongside your home birth midwife.` },
    ];
  } else if (nf.param === 'service:water-birth') {
    faqs = [
      { q: `Is water birth available in ${city}?`, a: `Some hospitals and birth centers in ${city} offer water birth options. Use the "Water birth" filter to see doulas who have experience supporting water births in the ${city} area.` },
      { q: `How do I find a water birth doula in ${city}?`, a: `Filter the doula list above by selecting "Water birth" to see providers in ${city} who are experienced with water labor and water birth support.` },
    ];
  } else if (nf.param === 'service:birth-center') {
    faqs = [
      { q: `Are there birth centers in ${city}?`, a: hasBirthCenters ? `Yes, ${city} has freestanding birth centers. See the birth center details above and use the "Birth center" filter to find doulas who work with birth centers in the area.` : `There are currently no freestanding birth centers in ${city}, but some hospitals offer midwifery care in a birth-center-like setting. Use the filter to find doulas experienced with birth center-style care.` },
      { q: `What is a birth center doula?`, a: `A birth center doula supports you during labor at a freestanding birth center. They work alongside the midwife to provide comfort, advocacy, and continuous support throughout your birth.` },
    ];
  } else if (nf.param === 'service:lactation') {
    faqs = [
      { q: `How do I find a lactation consultant in ${city}?`, a: `Use the filter bar above and select "Lactation" to see providers in ${city}, ${state} who offer lactation support. You can also ask your OB, midwife, or pediatrician for an in-network IBCLC referral, or check with your hospital's lactation department.` },
      { q: `Does insurance cover lactation consultants in ${city}?`, a: `Yes for most plans. The ACA requires coverage of lactation support and counseling on most private plans, and ${stateFullName} Medicaid covers lactation consulting. Call your plan to confirm in-network IBCLCs before your first visit.` },
    ];
  }
  filterSEOMap[nf.param] = { title, meta, faqs };
}
const filterSEOJson = JSON.stringify(filterSEOMap);

const pageTitle = (data as any).titleTag || `${city}, ${state} Doula, Midwife & Lactation: Costs & Medicaid`;
const medicaidDesc = medicaidCovers ? 'Medicaid covers doulas' : 'no Medicaid doula coverage';
// Always use "free birth plan template" (never the shorter "free plan template")
// to keep meta descriptions in the 120-160 char sweet spot.
// Generate distinctive meta description that pulls from local culture data
// to avoid the "template with keyword swaps" pattern (Google §4.6.5).
const cultureSnippet = data.culture
  ? data.culture.slice(0, 80).replace(/["]/g, "'").trim()
  : null;
const uniqueDesc = cultureSnippet
  ? `${city}, ${state}: ${cultureSnippet}… Compare doula costs ($${costLow}-$${costHigh}), ${medicaidDesc}, hospitals, and local birth support.`
  : null;
let pageDesc = (data as any).metaDescription
  || uniqueDesc
  || `Planning a birth in ${city}, ${state}? Compare doula costs ($${costLow}-$${costHigh}), ${medicaidDesc}, hospitals, birth centers, lactation support, and a birth plan template (free).`;;
// Hard cap at 155 chars (Google desktop SERP shows ~155-160)
if (pageDesc.length > 155) {
  let trimmed = pageDesc.slice(0, 152);
  const lastSpace = trimmed.lastIndexOf(' ');
  if (lastSpace > 100) trimmed = trimmed.slice(0, lastSpace);
  pageDesc = trimmed + '...';
}
const pageUrl = `https://truejoybirthing.com/birth-support/${slug}/`;
const ogImage = ogImageSlug || `https://truejoybirthing.com/images/og-city-${slug}.webp`;
const heroImage = heroImageSlug || '/images/doula-breastfeeding.webp';
const heroImage600 = heroImageSlug
  ? heroImageSlug.replace(/\.(webp|jpg|jpeg|png)$/i, '-600.$1')
  : '/images/doula-breastfeeding-600.webp';
// AVIF versions: try exact versioned match first, then fall back to non-versioned
import { existsSync } from 'fs';
import { join } from 'path';
const heroAvifExact = heroImageSlug
  ? heroImageSlug.replace(/\.(webp|jpg|jpeg|png)$/i, '.avif')
  : '/images/doula-breastfeeding.avif';
const heroAvifExact600 = heroImageSlug
  ? heroImageSlug.replace(/\.(webp|jpg|jpeg|png)$/i, '-600.avif')
  : '/images/doula-breastfeeding-600.avif';
const heroAvifStripped = heroAvifExact.replace(/(-v\d+|-1200)\.avif$/, '.avif');
const heroAvifStripped600 = heroAvifExact600.replace(/(-v\d+)-600\.avif$/, '-600.avif');
const heroImageAvifBase = existsSync(join(process.cwd(), 'public', heroAvifExact))
  ? heroAvifExact
  : heroAvifStripped;
const heroImageAvif600 = existsSync(join(process.cwd(), 'public', heroAvifExact600))
  ? heroAvifExact600
  : heroAvifStripped600;
const heroHasAvif = existsSync(join(process.cwd(), 'public', heroImageAvifBase));
const heroAlt = `${city} birth doula: costs, Medicaid, and hospital info for ${state} families`;
const supportImage = supportSceneImage || '/images/doula-support-conversation.webp';
const supportImageAlt = supportSceneAlt || `A doula walking alongside an expectant mom, offering continuous labor support`;

// Section images — same across all locations (Jeff approved keeping
// photos consistent across cities; 4:3 aspect ratio for proper fit)
// ANTI-DISTORTION RULE: Every <img> with a known aspect ratio uses explicit
// aspect-[X/Y] class + object-cover. Source images should match their container
// ratio. If they don't match exactly, object-cover crops gracefully — but large
// mismatches mean significant content loss. Prefer matching ratios when possible.
// OG images are composed design assets (text + image), NOT raw photo crops.
const doulaCostImage = costSectionImage || '/images/doula-holding-hands.webp';
const medicaidImage = insuranceSectionImage || '/images/hands-on-belly.webp';
const midwifeImage = midwifeSectionImage || '/images/midwife-heartbeat.webp';
// Lactation section image — one reusable photo across cities (Jeff approved
// consistent cross-city section illustrations); city override only when a
// real practice supplies a photo. 4:3 to match the midwife container.
const lactationImage = lactationSectionImage || '/images/lactation-consult-v3.webp';
// Lactation specialists appear in the existing localDoulas array with
// isLactation: true (not a separate array). Filter them here so the lactation
// section can render its own simpler card grid.
const lactationProviders = localDoulas?.filter((d) => d.isLactation) || [];

// Build structured-data
const breadcrumbList = [
  { name: 'Home', url: 'https://truejoybirthing.com/' },
  { name: 'Birth Support', url: 'https://truejoybirthing.com/birth-support/' },
  { name: stateFullName, url: `https://truejoybirthing.com/birth-support/${state.toUpperCase() === 'MT' ? 'bozeman-mt' : state.toLowerCase()}/` },
  { name: `${city}, ${state}`, url: pageUrl },
];

// Default lactation FAQs — prepended to every city's faqs so the lactation
// section's FAQ coverage is guaranteed on every new page without manual entry.
// Uses medicaidCovers + stateFullName to stay accurate per-city.
const defaultLactationFaqs = [
  {
    q: `How much does a lactation consultant cost in ${city}?`,
    a: `An IBCLC consult in ${city} typically runs $150–$300 for an initial 90-minute visit and $75–$150 for follow-ups. The good news: under the ACA, most insurance plans cover lactation consulting with no cost-sharing — confirm your in-network IBCLCs and any out-of-pocket cost before booking.`,
  },
  {
    q: `Does insurance or Medicaid cover lactation consultants in ${city}?`,
    a: `Yes for most plans. The ACA requires coverage of lactation support and counseling on most private plans, and ${stateFullName} Medicaid covers lactation consulting. ${medicaidCovers ? 'Medicaid also covers doula services in your area.' : 'Doula coverage under Medicaid varies — see the Medicaid section above.'} Always call your plan to confirm in-network IBCLCs before your first visit.`,
  },
];
// Use allFaqs (not faqs) in render + FAQ schema so lactation FAQs are included.
const allFaqs = [...defaultLactationFaqs, ...faqs];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: `${city} Doula & Midwife: Costs, Hospitals & Medicaid`,
      description: pageDesc,
      author: { '@type': 'Organization', '@id': 'https://truejoybirthing.com/#organization' },
      publisher: { '@type': 'Organization', '@id': 'https://truejoybirthing.com/#organization' },
      ...(data.publishedDate ? { datePublished: data.publishedDate } : {}),
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
      ...(cityVideoEmbeds[slug] ? { video: { '@id': `${pageUrl}#video` } } : {}),
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: allFaqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        url: `${pageUrl}#faq-${f.q.toLowerCase().includes('cost') ? 'cost' : f.q.toLowerCase().includes('medicaid') ? 'medicaid' : f.q.toLowerCase().includes('true joy') ? 'brand' : f.q.toLowerCase().includes('lactation') ? 'lactation' : 'hospital'}`,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: `Joyful Birth Plan Resources for ${city} Families`,
      url: pageUrl,
      image: ogImage,
      areaServed: {
        '@type': 'City',
        name: city,
        ...(data.lat && data.lng ? {
          geo: {
            '@type': 'GeoCoordinates',
            latitude: data.lat,
            longitude: data.lng,
          },
        } : {}),
      },
      provider: { '@id': 'https://truejoybirthing.com/#organization' },
      serviceType: 'Birth Plan Resources',
      description: `Joyful Birth Plan tools, hospital info, and doula and midwife cost guides for families in ${city}, ${state}.`,
      ...(data.publishedDate ? { datePublished: data.publishedDate } : {}),
    },
    // Lactation service — always emitted (even with no verified providers) so
    // Google sees a lactation service offered in this city. Links to #lactation.
    {
      '@type': 'Service',
      '@id': `${pageUrl}#lactation-service`,
      name: `Lactation Support Resources for ${city} Families`,
      url: `${pageUrl}#lactation`,
      serviceType: 'Lactation Consulting',
      description: `IBCLC and CLC lactation consultant directory, insurance coverage info, and feeding-preferences birth plan tools for families in ${city}, ${state}.`,
      provider: { '@id': 'https://truejoybirthing.com/#organization' },
      areaServed: {
        '@type': 'City',
        name: city,
        ...(data.lat && data.lng ? {
          geo: { '@type': 'GeoCoordinates', latitude: data.lat, longitude: data.lng },
        } : {}),
      },
      ...(data.publishedDate ? { datePublished: data.publishedDate } : {}),
    },
    // Physician (MedicalBusiness/LocalBusiness) node per verified lactation
    // provider. Only emit for isVerified providers to avoid unverified claims.
    // Lactation specialists come from the localDoulas array (isLactation: true).
    ...lactationProviders
      .filter((p) => p.isVerified === true)
      .map((p, i) => ({
        '@type': 'Physician',
        '@id': `${pageUrl}#lactation-${i}`,
        name: p.name,
        medicalSpecialty: 'LactationConsulting',
        ...(p.credential ? { credential: p.credential } : {}),
        ...(p.url ? { url: p.url } : {}),
        ...(p.serviceArea ? {
          areaServed: p.serviceArea.map((a) => ({ '@type': 'City', name: a })),
        } : {}),
        address: {
          '@type': 'PostalAddress',
          addressLocality: city,
          addressRegion: state,
          addressCountry: 'US',
        },
        ...(p.acceptingClients === true ? { acceptsNewPatients: true } : {}),
      })),
    // MedicalOrganization for each hospital (schema helps Google understand
    // the medical facilities serving this city, whether or not they have a URL)
    ...hospitalDetails.map((h, i) => {
      // Extract hospital city from address string (e.g., "170 N 1100 E, American Fork, UT 84003")
      // City is the second-to-last comma-separated part (before state abbreviation)
      const hospitalCity = h.address && typeof h.address === 'string'
        ? (h.address.split(',').map(s => s.trim()).slice(-2, -1)[0] || city)
        : city;
      return {
        '@type': 'MedicalOrganization',
        '@id': `${pageUrl}#hospital-${i}`,
        name: h.name,
        ...(h.address && typeof h.address === 'string' ? {
          address: {
            '@type': 'PostalAddress',
            addressLocality: hospitalCity,
            addressRegion: state,
            addressCountry: 'US',
            streetAddress: h.address.split(',')[0].trim(),
          },
        } : {}),
        ...(h.url ? { url: h.url } : { url: pageUrl }),
      };
    }),
    {
      '@type': 'LocalBusiness',
      '@id': `${pageUrl}#local-business`,
      name: `True Joy Birthing — ${city}`,
      description: `Birth doula and midwife directory, hospital info, and Joyful Birth Plan resources for families in ${city}, ${state}.`,
      url: pageUrl,
      areaServed: {
        '@type': 'City',
        name: city,
        containedInPlace: { '@type': 'State', name: stateFullName },
      },
      parentOrganization: { '@id': 'https://truejoybirthing.com/#organization' },
      ...(data.lat && data.lng ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: data.lat,
          longitude: data.lng,
        },
      } : {}),
    },
    {
      '@type': 'SpeakableSpecification',
      '@id': `${pageUrl}#speakable`,
      cssSelector: ['.prose h2', '.prose h3', '.faq-answer'],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonical={pageUrl}
  ogImage={ogImage}
  ogImageAlt={heroAlt}
  ogType="article"
  breadcrumbList={breadcrumbList}
  schema={schema}
>

  
  <!-- ═══ Breadcrumb ═══ -->
  <nav aria-label="Breadcrumb" class="bg-tjb-cream pt-4 pb-2">
    <div class="max-w-7xl mx-auto px-6">
      <ol class="flex items-center gap-1.5 flex-wrap text-sm text-tjb-gray">
        <li class="flex items-center gap-1.5">
          <a href="https://truejoybirthing.com/" class="text-tjb-lavender-600 hover:underline">Home</a>
          <span class="text-tjb-gray/50">›</span>
        </li>
        <li class="flex items-center gap-1.5">
          <a href="https://truejoybirthing.com/birth-support/" class="text-tjb-lavender-600 hover:underline">Birth Support</a>
          <span class="text-tjb-gray/50">›</span>
        </li>
        <li class="flex items-center gap-1.5">
          <a href={`/birth-support/${effectiveStateHubSlug}/`} class="text-tjb-lavender-600 hover:underline">{stateFullName}</a>
          <span class="text-tjb-gray/50">›</span>
        </li>
        <li class="text-tjb-charcoal font-medium">{city}, {state}</li>
      </ol>
    </div>
  </nav>

  <!-- ═══ Hero — Split Layout (55% text / 45% image) ═══ -->
  <section class="bg-tjb-cream pt-16 pb-12">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
        <div>
          <p class="eyebrow text-tjb-rose-500 uppercase text-xs font-semibold tracking-widest mb-4">{city} Doula & Midwife Support</p>
          <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
          <h1 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: 'DM Serif Display', Georgia, serif;">{city} Doula & Midwife: Costs, Hospitals & Medicaid</h1>
          <p class="text-lg text-tjb-charcoal font-semibold mb-2">True Joy Birthing is a birth plan app and doula directory for first-time moms in {city}. Whether you're looking for a <strong>doula or midwife in {city}</strong>, building your birth plan, or figuring out what support even looks like — everything here is free.</p>
          <p class="text-tjb-gray mb-6">Doulas, midwives, hospital policies, and costs, broken down so you can walk in prepared. This guide covers <a href="/doula-cost/" class="text-tjb-rose-600 hover:underline">how much doulas cost</a>, <a href="/medicaid-doula-coverage/" class="text-tjb-rose-600 hover:underline">whether Medicaid covers a doula</a>, and which hospitals welcome birth partners. New here? <a href="/what-is-a-doula/" class="text-tjb-rose-600 hover:underline">Learn what a doula actually does</a>.</p>
          {costLow > 0 && (
            <p class="mb-6"><span class="inline-flex items-center bg-tjb-rose-50 text-tjb-rose-600 text-sm font-semibold px-3 py-1 rounded-full border border-tjb-rose-200">Birth doula support in {city} starts at ${costLow}</span></p>
          )}
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="https://apps.apple.com/us/app/true-joy-birthing/id6760793180" class="btn-primary text-center">Build Your Birth Plan in the App</a>
            <a href="/birth-plan-template/" class="btn-secondary text-center">Or download the free PDF →</a>
          </div>
          <p class="text-xs text-tjb-gray mt-3">Free · No account needed · Works on iPhone</p>
          {heroLocalDetail && (
            <p class="text-sm text-tjb-gray/80 italic mt-4">{heroLocalDetail}</p>
          )}
        </div>
        <div class="relative">
          {heroImageSlug ? (
            <picture>
              {heroHasAvif && (
                <source
                  type="image/avif"
                  srcset={`${heroImageAvif600} 600w,
                          ${heroImageAvifBase} 1200w`}
                  sizes="(max-width: 768px) 100vw, 50vw"
                />
              )}
              <source
                type="image/webp"
                srcset={`${heroImage600} 600w,
                        ${heroImage} 1200w`}
                sizes="(max-width: 768px) 100vw, 50vw"
              />
              <img
                src={heroImage}
                alt={heroAlt}
                class="w-full aspect-[3/2] object-cover rounded-2xl shadow-lg"
                width="1200"
                height="800"
                loading="eager"
                fetchpriority="high"
              />
            </picture>
          ) : (
            <picture>
              <source
                type="image/webp"
                srcset="/images/doula-breastfeeding-600.webp 600w,
                        /images/doula-breastfeeding-1200.webp 1200w"
                sizes="(max-width: 768px) 100vw, 50vw"
              />
              <img
                src="/images/doula-breastfeeding.webp"
                alt={heroAlt}
                class="w-full aspect-[3/2] object-cover rounded-2xl shadow-lg"
                width="1200"
                height="800"
                loading="eager"
                fetchpriority="high"
              />
            </picture>
          )}
        </div>
      </div>
    </div>
  </section>

  {/* ═══ Local Culture Section (unique per city — defeats template similarity) ═══ */}
  {data.culture && (
    <section class="py-12 bg-white">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-2xl font-bold text-tjb-charcoal mb-4" style="font-family: 'DM Serif Display', Georgia, serif;">About {city}, {state}</h2>
        <p class="text-tjb-gray leading-relaxed">{data.culture}</p>
      </div>
    </section>
  )}

  {/* ═══ E-E-A-T: Reviewer Byline (Google compliance) — matches guide-page author strip ═══ */}
  <div class="bg-white py-6">
    <div class="max-w-3xl mx-auto px-6">
      <div class="flex items-center gap-2.5">
        <img src="/images/shelbi-thumb.webp" alt="Shelbi Kohler, certified birth doula" width="32" height="32" class="w-8 h-8 rounded-full object-cover" />
        <p class="text-sm text-tjb-gray leading-snug">
          Content reviewed by
          <a href="/about/" class="text-tjb-lavender-600 hover:text-tjb-lavender-700 font-medium no-underline">Shelbi Kohler, CD(DONA)</a>,
          certified birth doula, 500+ families supported
        </p>
      </div>
      <p class="text-xs text-tjb-gray-500 mt-2">
        This page was created with AI assistance and reviewed by a certified birth doula. Content accuracy is verified against current medical guidelines and local provider data.
      </p>
    </div>
  </div>


  {/* ═══ Phase 3A: Internal linking to filter views ═══ */}
  {showFilterBar && nicheFilters.length > 0 && (
    <nav class="bg-tjb-cream pb-6" aria-label="Browse by filter">
      <div class="max-w-6xl mx-auto px-6">
        <p class="text-sm text-tjb-gray mb-2">
          <span class="font-semibold text-tjb-charcoal">Browse:</span>
          {nicheFilters.map((nf, i) => (
            <span>
              {i > 0 && <span class="text-tjb-gray/40 mx-1">|</span>}
              <a href={`?filter=${nf.param}`} class="text-tjb-rose-600 hover:underline font-medium" data-filter-link={nf.param}>{nf.label}</a>
            </span>
          ))}
        </p>
      </div>
    </nav>
  )}

  {/* ═══ Phase 3A: Filter-specific FAQ section (hidden, shown by JS) ═══ */}
  {showFilterBar && nicheFilters.length > 0 && (
    <div id="filter-faq" class="hidden py-12 bg-tjb-cream-50" aria-hidden="true">
      <div class="max-w-3xl mx-auto px-6">
        <h2 id="filter-faq-title" class="text-2xl font-bold mb-6" style="font-family: 'DM Sans', sans-serif;"></h2>
        <div id="filter-faq-items" class="space-y-4">
          {/* FAQ items injected by client-side JS */}
        </div>
      </div>
    </div>
  )}

  <!-- ═══ App Showcase ═══ -->
  <AppShowcase variant="sans" />


  <!-- ═══ What the Free App Offers ═══ -->
  <section class="py-16 bg-tjb-cream-50">
    <div class="max-w-4xl mx-auto px-6">
      <p class="eyebrow text-tjb-rose-500 uppercase text-xs font-semibold tracking-widest mb-4 text-center">Free app</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
      <h2 class="text-2xl md:text-3xl font-bold text-tjb-charcoal mb-6 text-center" style="font-family: 'DM Sans', sans-serif;">What the Free App Offers</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <p class="font-semibold text-tjb-charcoal mb-2">9 guided sections</p>
          <p class="text-sm text-tjb-gray">Hospital preferences, pain management options, who's in the room, feeding preferences, postpartum plans — each section walks you through what each choice means so nothing gets missed. Answer a few questions at a time, save your progress, and come back whenever you want. Your plan builds as you go, so it never feels overwhelming.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <p class="font-semibold text-tjb-charcoal mb-2">Find local doulas</p>
          <p class="text-sm text-tjb-gray">Browse and connect with doulas and midwives serving {city} right inside the app. See their services, cost ranges, and availability without searching elsewhere. Many {city} parents use the app to message providers directly and find someone who fits their schedule and personality.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <p class="font-semibold text-tjb-charcoal mb-2">Printable PDF birth plan</p>
          <p class="text-sm text-tjb-gray">Export your finished plan as a PDF to share with your provider, doula, or hospital. Easy to update anytime — not a static document you fill out once.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <p class="font-semibold text-tjb-charcoal mb-2">Completely free</p>
          <p class="text-sm text-tjb-gray">No account needed, no credit card, no time limit. Works on iPhone. Download it, build your plan, share it — that's it.</p>
        </div>
      </div>
      <div class="text-center mt-8">
        <a href="https://apps.apple.com/us/app/true-joy-birthing/id6760793180" class="btn-primary">Download on the App Store →</a>
      </div>
    </div>
  </section>


  <!-- ═══ City Video Guide (YouTube Embed) ═══ -->
  {cityVideoEmbeds[slug] && (
    <section class="py-12 bg-tjb-cream">
      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-8">
          <p class="eyebrow text-tjb-rose-500 uppercase text-xs font-semibold tracking-widest mb-4">Video guide</p>
          <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
          <h2 class="text-2xl md:text-3xl font-bold text-tjb-charcoal mb-3" style="font-family: 'DM Sans', sans-serif;">{cityVideoEmbeds[slug].title}</h2>
          <p class="text-tjb-gray max-w-2xl mx-auto">{cityVideoEmbeds[slug].description}</p>
        </div>
        <div class="aspect-video rounded-xl overflow-hidden shadow-lg bg-black relative cursor-pointer group" id="city-video-facade" data-video-id={cityVideoEmbeds[slug].videoId}>
          <img src={`https://img.youtube.com/vi/${cityVideoEmbeds[slug].videoId}/maxresdefault.jpg`} alt={`${cityVideoEmbeds[slug].title} — press play to watch`} class="w-full h-full object-cover" width="1280" height="720" loading="lazy" />
          <div class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/20 transition-colors">
            <div class="w-16 h-16 bg-white/90 rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
              <svg class="w-7 h-7 ml-1 text-tjb-charcoal" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>
        <script is:inline>
          (function() {
            var facade = document.getElementById('city-video-facade');
            if (!facade) return;
            facade.addEventListener('click', function() {
              var videoId = this.dataset.videoId;
              this.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/' + videoId + '?autoplay=true" class="w-full h-full border-0 absolute inset-0" width="100%" height="100%" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>';
            });
          })();
        </script>
        {/*
          @todo: In a future iteration, add a collapsible <details> transcript below the video
          by fetching auto-captions via YouTube API (captions.download?tfmt=srt&tlang=en&id=...)
          and rendering them here. Clean up SRT formatting and wrap in:
          <details class="mt-4 bg-white rounded-xl border-2 border-tjb-lavender-200 p-4">
            <summary class="text-sm font-semibold text-tjb-charcoal cursor-pointer">Read the transcript</summary>
            <div class="prose prose-sm mt-2 max-w-none text-tjb-gray">
              {cleanedTranscriptText}
            </div>
          </details>
        */}
      </div>
    </section>
  )}


  <!-- ═══ Doulas & Midwives Serving {city} ═══ -->
  {localDoulas && localDoulas.length > 0 ? (
    <section class="py-20 bg-tjb-cream">
      <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-10">
          <p class="eyebrow text-tjb-rose-500 uppercase text-xs font-semibold tracking-widest mb-4">Local support</p>
          <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
          <h2 class="text-2xl md:text-3xl font-bold text-tjb-charcoal mb-4" style="font-family: 'DM Sans', sans-serif;">Doulas & Midwives Serving {city}</h2>
          <p class="text-tjb-gray max-w-2xl mx-auto">Real people, real support: here are doulas and midwives who serve {city} families. Every listing is a practicing provider, not an ad.</p>
        </div>
        {/* Filter bar — only when 2+ doulas and filters exist */}
        {showFilterBar && (
          <div class="mb-6 not-prose" id="doula-filters">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-semibold text-tjb-gray uppercase tracking-wide mr-1">Filter:</span>
              {[...filterServiceValues].sort().map((svc) => (
                <button class="filter-chip inline-flex items-center bg-white text-tjb-charcoal text-xs font-medium px-3 py-1.5 rounded-full border border-tjb-lavender-200 hover:border-tjb-rose-300 hover:bg-tjb-rose-50 transition" data-filter={`service:${slugify(svc)}`}>{svc}</button>
              ))}
              {filterHasMedicaid && (
                <button class="filter-chip inline-flex items-center bg-white text-tjb-charcoal text-xs font-medium px-3 py-1.5 rounded-full border border-green-200 hover:border-green-400 hover:bg-green-50 transition" data-filter="medicaid:yes">Medicaid</button>
              )}
              {filterHasAccepting && (
                <button class="filter-chip inline-flex items-center bg-white text-tjb-charcoal text-xs font-medium px-3 py-1.5 rounded-full border border-tjb-lavender-200 hover:border-tjb-rose-300 hover:bg-tjb-rose-50 transition" data-filter="accepting:yes">Accepting clients</button>
              )}
              {filterHasMidwife && (
                <button class="filter-chip inline-flex items-center bg-white text-tjb-charcoal text-xs font-medium px-3 py-1.5 rounded-full border border-tjb-lavender-200 hover:border-tjb-rose-300 hover:bg-tjb-rose-50 transition" data-filter="midwife:yes">Midwife</button>
              )}
              {filterHasLactation && (
                <button class="filter-chip inline-flex items-center bg-white text-tjb-charcoal text-xs font-medium px-3 py-1.5 rounded-full border border-tjb-lavender-200 hover:border-tjb-rose-300 hover:bg-tjb-rose-50 transition" data-filter="lactation:yes">Lactation</button>
              )}
              {filterCostTiers.has('under-1000') && (
                <button class="filter-chip inline-flex items-center bg-white text-tjb-charcoal text-xs font-medium px-3 py-1.5 rounded-full border border-tjb-lavender-200 hover:border-tjb-rose-300 hover:bg-tjb-rose-50 transition" data-filter="cost:under-1000">Under $1,000</button>
              )}
              {filterCostTiers.has('1000-2000') && (
                <button class="filter-chip inline-flex items-center bg-white text-tjb-charcoal text-xs font-medium px-3 py-1.5 rounded-full border border-tjb-lavender-200 hover:border-tjb-rose-300 hover:bg-tjb-rose-50 transition" data-filter="cost:1000-2000">$1,000-$2,000</button>
              )}
              {filterCostTiers.has('over-2000') && (
                <button class="filter-chip inline-flex items-center bg-white text-tjb-charcoal text-xs font-medium px-3 py-1.5 rounded-full border border-tjb-lavender-200 hover:border-tjb-rose-300 hover:bg-tjb-rose-50 transition" data-filter="cost:over-2000">$2,000+</button>
              )}
              {[...filterLanguageValues].sort().map((lang) => (
                <button class="filter-chip inline-flex items-center bg-white text-tjb-charcoal text-xs font-medium px-3 py-1.5 rounded-full border border-tjb-lavender-200 hover:border-tjb-rose-300 hover:bg-tjb-rose-50 transition" data-filter={`language:${slugify(lang)}`}>{lang}</button>
              ))}
              <button id="clear-filters" class="hidden text-xs text-tjb-rose-600 hover:text-tjb-rose-700 font-medium underline ml-2">Clear filters</button>
            </div>
            <p id="no-filter-results" class="hidden text-sm text-tjb-gray mt-4 text-center">No doulas match your filters. <button class="text-tjb-rose-600 hover:text-tjb-rose-700 font-medium underline">Clear filters</button></p>
          </div>
        )}
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 not-prose" id="doula-grid">
          {[...localDoulas].sort((a, b) => (b.isVerified === true ? 1 : 0) - (a.isVerified === true ? 1 : 0)).map((doula) => {
            const verified = doula.isVerified === true;
            const webVerified = !verified && !!doula.enrichedAt;
            // Compute data attributes for filter bar
            const cardServices = (doula.services || []).map((s: string) => slugify(s)).join(',');
            const cardLanguages = (doula.languages || []).map((l: string) => slugify(l)).join(',');
            let cardCostTier = '';
            if (doula.costRange) {
              const m = doula.costRange.match(/\$([\d,]+)/);
              if (m) {
                const low = parseInt(m[1].replace(/,/g, ''));
                if (low < 1000) cardCostTier = 'under-1000';
                else if (low <= 2000) cardCostTier = '1000-2000';
                else cardCostTier = 'over-2000';
              }
            }
            return (
            <div class={`doula-card bg-white relative rounded-xl p-6 shadow-sm border hover:shadow-md transition-shadow duration-200 flex flex-col items-center text-center ${doula.isAmbassador ? 'border-2 border-tjb-rose-300 shadow-md' : 'border-tjb-lavender-200/50 hover:border-tjb-lavender-300'}`}
              data-services={cardServices}
              data-medicaid={doula.acceptsMedicaid ? 'yes' : ''}
              data-accepting={doula.acceptingClients ? 'yes' : ''}
              data-midwife={doula.isMidwife ? 'yes' : ''}
              data-lactation={doula.isLactation ? 'yes' : ''}
              data-cost-tier={cardCostTier}
              data-languages={cardLanguages}
            >
              {/* Verification tier badge */}
              {verified && (
                <span class="absolute top-3 right-3 inline-flex items-center gap-1 bg-tjb-sage-100 text-tjb-charcoal text-xs font-medium px-2.5 py-0.5 rounded-full border border-tjb-sage" role="status" aria-label="Provider-verified listing">
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M10 3L4.5 8.5L2 6" stroke="#2A2A2A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  Provider-verified
                </span>
              )}
              {webVerified && (
                <span class="absolute top-3 right-3 inline-flex items-center gap-1 bg-gray-100 text-gray-500 text-xs font-medium px-2.5 py-0.5 rounded-full border border-gray-300" role="status" aria-label="Web-verified listing">
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M10 3L4.5 8.5L2 6" stroke="#6B7280" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  Web-verified
                </span>
              )}
              {/* Photo or initial monogram */}
              {doula.photo ? (
                <div class:list={["w-14 h-14 flex items-center justify-center mb-4", doula.photoIsLogo ? "rounded-lg bg-white border border-tjb-lavender-200 p-2" : "rounded-full overflow-hidden"]}>
                  <img src={doula.photo} alt={`${doula.name} logo`} class:list={["w-full h-full", doula.photoIsLogo ? "object-contain" : "object-cover"]} width="56" height="56" loading="lazy" />
                </div>
              ) : (
                <div class={`w-14 h-14 rounded-full flex items-center justify-center mb-4 ${doula.isMidwife ? 'bg-tjb-lavender-100' : 'bg-tjb-lavender-100'}`}>
                  <span class="text-2xl font-semibold" style="font-family: 'Cormorant Garamond', Georgia, serif;" className={doula.isAmbassador ? 'text-tjb-rose-600' : doula.isMidwife ? 'text-tjb-lavender-700' : 'text-tjb-charcoal'}>{doula.name.split(' ').map((n: string) => n[0]).join('')}</span>
                </div>
              )}
              <h3 class="text-lg font-semibold text-tjb-charcoal leading-tight mb-1" style="font-family: 'Cormorant Garamond', Georgia, serif;">{doula.name}</h3>
              {doula.credential && <p class="text-sm text-tjb-lavender-600 font-medium mb-2">{doula.credential}</p>}
              {doula.practice && <p class="text-sm text-tjb-gray mb-1">{doula.practice}</p>}
              {doula.costRange && <p class="text-sm text-tjb-charcoal font-medium mb-2">{doula.costRange}</p>}
              {(doula.services && doula.services.length > 0) && (
                <div class="flex flex-wrap justify-center gap-1.5 mt-1 mb-2">
                  {/* Deduplicate — skip service tags that duplicate the credential text */}
                  {doula.services.filter((svc: string) => !doula.credential || svc !== doula.credential).map((svc: string) => (
                    <span class="inline-flex items-center bg-tjb-lavender-50 text-tjb-lavender-700 text-xs font-medium px-2 py-0.5 rounded-full border border-tjb-lavender-200">{svc}</span>
                  ))}
                </div>
              )}
              {doula.description && <p class="text-sm text-tjb-gray leading-relaxed mb-2">{doula.description}</p>}
              {doula.acceptsMedicaid && (
                <span class="inline-flex items-center bg-green-50 text-green-700 text-xs font-medium px-2.5 py-0.5 rounded-full border border-green-200 mb-2">
                  <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  Accepts Medicaid
                </span>
              )}
              {doula.serviceArea && doula.serviceArea.length > 0 && (
