---
// ═══════════════════════════════════════════════════════════════
// Neighborhood-level birth-support page — Phase 3B
// Generates /birth-support/[city]/[neighborhood]/ pages from
// serviceArea[] data on localDoulas.
// Only generates pages where at least 1 doula serves that neighborhood.
// ═══════════════════════════════════════════════════════════════
import Layout from '../../../layouts/Layout.astro';
import { cities, citySlugs, type CityData, type LocalDoula } from '../../../data/cities';

// State full name for breadcrumbs
const stateNames: Record<string, string> = {
  AL: 'Alabama', AK: 'Alaska', AZ: 'Arizona', AR: 'Arkansas', CA: 'California',
  CO: 'Colorado', CT: 'Connecticut', DE: 'Delaware', FL: 'Florida', GA: 'Georgia',
  HI: 'Hawaii', ID: 'Idaho', IL: 'Illinois', IN: 'Indiana', IA: 'Iowa',
  KS: 'Kansas', KY: 'Kentucky', LA: 'Louisiana', ME: 'Maine', MD: 'Maryland',
  MA: 'Massachusetts', MI: 'Michigan', MN: 'Minnesota', MS: 'Mississippi', MO: 'Missouri',
  MT: 'Montana', NE: 'Nebraska', NV: 'Nevada', NH: 'New Hampshire', NJ: 'New Jersey',
  NM: 'New Mexico', NY: 'New York', NC: 'North Carolina', ND: 'North Dakota', OH: 'Ohio',
  OK: 'Oklahoma', OR: 'Oregon', PA: 'Pennsylvania', RI: 'Rhode Island', SC: 'South Carolina',
  SD: 'South Dakota', TN: 'Tennessee', TX: 'Texas', UT: 'Utah', VT: 'Vermont',
  VA: 'Virginia', WA: 'Washington', WV: 'West Virginia', WI: 'Wisconsin', WY: 'Wyoming',
  DC: 'District of Columbia',
};

// ─── getStaticPaths ───
// Scan all cities, extract neighborhoods from serviceArea[], generate a page
// for every (city, neighborhood) pair where at least 1 doula serves it.

interface NeighborhoodPath {
  params: { city: string; neighborhood: string };
  props: {
    citySlug: string;
    cityData: CityData;
    neighborhoodName: string;
    neighborhoodSlug: string;
    neighborhoodDoulas: LocalDoula[];
  };
}

export function getStaticPaths(): NeighborhoodPath[] {
  const paths: NeighborhoodPath[] = [];
  const seen = new Set<string>();

  // ─── Helpers (defined inside getStaticPaths so Astro's SSG compiler
  //     keeps them in scope — frontmatter-level helpers get tree-shaken) ───

  /** Strip ", STATE" suffix and trim, giving just the city/neighborhood name. */
  function cleanServiceAreaName(val: string): string {
    return val.replace(/,\s*[A-Z]{2}\s*$/, '').trim();
  }

  /** Convert a neighborhood display name to a URL slug. */
  function neighborhoodSlug(name: string): string {
    return name
      .toLowerCase()
      .replace(/'/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .replace(/-+/g, '-');
  }

  /** Normalize a serviceArea value for matching: lowercase, no state, no extra spaces. */
  function normalizeForMatch(val: string): string {
    return cleanServiceAreaName(val).toLowerCase().replace(/\s+/g, ' ').trim();
  }

  // ─── Garbage filter ───
  // Reject serviceArea values that are NOT real neighborhood/community names.
  // Filters out service-radius strings, county names, metro areas, regions, etc.
  const GARBAGE_KEYWORDS = [
    'mile', 'service range', 'county', 'metroplex', 'greater',
    'surrounding', 'area', 'region', 'central', 'radius',
    'metropolitan', 'metro area', 'metro', 'driving', 'travel',
    'within', 'extended', 'including', 'throughout', 'miles',
    'mile radius', 'statewide', 'nearby', 'virtual', 'panhandle',
    'remote', 'online', 'all of', 'east bay', 'west bay',
    'hampton roads', 'western pa',
  ];

  // ─── Blocklist of larger cities that should never be neighborhoods ───
  // These are cities that either have their own page (handled by allCityNames
  // check below) or are known larger cities / cross-state places that should
  // not appear as neighborhoods of smaller cities.
  const BLOCKED_CITY_NAMES = new Set([
    'dallas', 'fort worth',     // DFW — larger cities, not neighborhoods
    'moscow',                   // Moscow, ID — cross-state from Spokane, WA
    'coeur d\'alene',           // Idaho city near Spokane, WA
    'pullman',                  // Idaho/WA border city near Spokane, WA
  ]);

  // ─── State abbreviation map for cross-state rejection ───
  // If a serviceArea value has a ", XX" suffix where XX is a 2-letter state
  // abbreviation different from the parent city's state, reject it.
  const STATE_ABBREVS = new Set([
    'AL','AK','AZ','AR','CA','CO','CT','DE','FL','GA','HI','ID','IL','IN','IA',
    'KS','KY','LA','ME','MD','MA','MI','MN','MS','MO','MT','NE','NV','NH','NJ',
    'NM','NY','NC','ND','OH','OK','OR','PA','RI','SC','SD','TN','TX','UT','VT',
    'VA','WA','WV','WI','WY','DC',
  ]);

  // US state abbreviations and full names (lowercase) for rejection
  const STATE_NAMES_LOWER = new Set([
    'al','ak','az','ar','ca','co','ct','de','fl','ga','hi','id','il','in','ia',
    'ks','ky','la','me','md','ma','mi','mn','ms','mo','mt','ne','nv','nh','nj',
    'nm','ny','nc','nd','oh','ok','or','pa','ri','sc','sd','tn','tx','ut','vt',
    'va','wa','wv','wi','wy','dc',
    'alabama','alaska','arizona','arkansas','california','colorado','connecticut',
    'delaware','florida','georgia','hawaii','idaho','illinois','indiana','iowa',
    'kansas','kentucky','louisiana','maine','maryland','massachusetts','michigan',
    'minnesota','mississippi','missouri','montana','nebraska','nevada','new hampshire',
    'new jersey','new mexico','new york','north carolina','north dakota','ohio',
    'oklahoma','oregon','pennsylvania','rhode island','south carolina','south dakota',
    'tennessee','texas','utah','vermont','virginia','washington','west virginia',
    'wisconsin','wyoming','district of columbia',
  ]);

  /**
   * Check if a serviceArea value looks like a real neighborhood/community name.
   * Returns false for service-radius strings, county names, metro areas, state names, etc.
   */
  function isNeighborhoodName(val: string, cityName: string): boolean {
    const lower = val.toLowerCase().trim();

    // Reject empty
    if (!lower) return false;

    // Reject if it matches the city name itself
    if (lower === cityName.toLowerCase().trim()) return false;

    // Reject values containing garbage keywords
    for (const kw of GARBAGE_KEYWORDS) {
      if (lower.includes(kw)) return false;
    }

    // Reject if it ends with "County" or "Area"
    if (/\bcounty$/.test(lower) || /\barea$/.test(lower)) return false;

    // Reject if it's just a state name or abbreviation
    if (STATE_NAMES_LOWER.has(lower)) return false;

    // Reject if it's a 2-letter state abbreviation (uppercase original)
    if (/^[A-Z]{2}$/.test(val.trim())) return false;

    // Reject if it starts with a digit (e.g. "25-mile service range")
    if (/^\d/.test(val.trim())) return false;

    // Reject if too long — real neighborhoods are typically 1-4 words
    const wordCount = val.trim().split(/\s+/).length;
    if (wordCount > 4) return false;

    // Reject "CityName, ST" format — after cleanServiceAreaName strips ", ST",
    // check if the remainder is itself a known city name (another city, not a neighborhood)
    // We handle this by checking against all city names
    return true;
  }

  for (const slug of citySlugs) {
    const data = cities[slug];
    if (!data || !data.localDoulas) continue;

    // Collect all serviceArea values from this city's doulas
    // Map: normalized name → { displayName, doulas[] }
    const neighborhoodMap = new Map<
      string,
      { displayName: string; doulas: LocalDoula[] }
    >();

    // Build a set of all city names (lowercase) for rejecting "CityName, ST" entries
    // that are actually other cities, not neighborhoods
    const allCityNames = new Set<string>();
    for (const s of citySlugs) {
      if (cities[s]) allCityNames.add(cities[s]!.city.toLowerCase());
    }

    for (const doula of data.localDoulas) {
      if (!doula.serviceArea || doula.serviceArea.length === 0) continue;
      for (const area of doula.serviceArea) {
        // ─── Cross-state rejection: if the raw serviceArea value has a
        // ", XX" suffix where XX is a 2-letter state abbreviation that
        // differs from the parent city's state, skip it entirely. ───
        const stateMatch = area.match(/,\s*([A-Z]{2})\s*$/);
        if (stateMatch && STATE_ABBREVS.has(stateMatch[1]) && stateMatch[1] !== data.state) {
          continue;
        }

        const cleaned = cleanServiceAreaName(area);
        if (!cleaned) continue;

        // ─── Garbage filter: only generate pages for real neighborhoods ───
        if (!isNeighborhoodName(cleaned, data.city)) continue;

        // Reject if the cleaned name is another city in our database (not a neighborhood)
        if (allCityNames.has(cleaned.toLowerCase().trim())) continue;

        // Reject if the cleaned name is on the blocklist of larger cities
        // that should never be neighborhoods (e.g. Fort Worth, Moscow ID)
        if (BLOCKED_CITY_NAMES.has(cleaned.toLowerCase().trim())) continue;

        const key = normalizeForMatch(area);
        if (!neighborhoodMap.has(key)) {
          neighborhoodMap.set(key, { displayName: cleaned, doulas: [] });
        }
        neighborhoodMap.get(key)!.doulas.push(doula);
      }
    }

    // Generate a path for each neighborhood with at least 1 doula
    for (const [key, info] of neighborhoodMap) {
      // Skip if the "neighborhood" is just the city itself
      if (normalizeForMatch(data.city) === key) continue;

      const nhSlug = neighborhoodSlug(info.displayName);
      if (!nhSlug) continue;

      const dedupKey = `${slug}__${nhSlug}`;
      if (seen.has(dedupKey)) continue;
      seen.add(dedupKey);

      paths.push({
        params: { city: slug, neighborhood: nhSlug },
        props: {
          citySlug: slug,
          cityData: data,
          neighborhoodName: info.displayName,
          neighborhoodSlug: nhSlug,
          neighborhoodDoulas: info.doulas,
        },
      });
    }
  }

  return paths;
}

// ─── Page logic ───
const {
  citySlug,
  cityData,
  neighborhoodName,
  neighborhoodSlug: nhSlug,
  neighborhoodDoulas,
} = Astro.props;

const { city, state, costLow, costHigh, medicaidNote } = cityData;
const stateFullName = stateNames[state] || state;
const stateHubSlug = state.toLowerCase().replace(/\s+/g, '-');
const medicaidCovers =
  !medicaidNote.includes('does not') && !medicaidNote.includes('does NOT');

// URLs
const parentCityUrl = `https://truejoybirthing.com/birth-support/${citySlug}/`;
const pageUrl = `https://truejoybirthing.com/birth-support/${citySlug}/${nhSlug}/`;

// Meta
const pageTitle = `${neighborhoodName}, ${state} Birth Doula & Midwife Guide`;
const doulaCount = neighborhoodDoulas.length;
const costRangeText = neighborhoodDoulas.some((d) => d.costRange)
  ? neighborhoodDoulas
      .map((d) => d.costRange!)
      .filter(Boolean)
      .join(', ')
  : `$${costLow}–$${costHigh}`;

let pageDesc = `Doulas and midwives serving ${neighborhoodName}, ${state}: ${doulaCount} ${doulaCount === 1 ? 'provider' : 'providers'} serving ${neighborhoodName} families. Birth doula costs, hospital info, and free birth plan resources.`;
if (pageDesc.length > 160) {
  pageDesc = pageDesc.slice(0, 157) + '...';
}

const heroAlt = `${neighborhoodName} birth doula: costs, Medicaid, and hospital info for ${state} families`;

// Breadcrumbs
const breadcrumbList = [
  { name: 'Home', url: 'https://truejoybirthing.com/' },
  { name: 'Birth Support', url: 'https://truejoybirthing.com/birth-support/' },
  { name: stateFullName, url: `https://truejoybirthing.com/birth-support/${state.toLowerCase()}/` },
  { name: `${city}, ${state}`, url: parentCityUrl },
  { name: neighborhoodName, url: pageUrl },
];

// Build neighborhood-specific FAQ
const neighborhoodFaqs = [
  {
    q: `How much does a doula cost in ${neighborhoodName}, ${state}?`,
    a: `Doulas serving ${neighborhoodName} typically charge between $${costLow} and $${costHigh} for a birth package, though some offer sliding-scale pricing. ${medicaidCovers ? `${stateFullName} Medicaid covers doula services — ask your plan for enrolled providers near ${neighborhoodName}.` : `Check with individual doulas for sliding-scale or payment plan options.`} The ${doulaCount} ${doulaCount === 1 ? 'doula listed' : 'doulas listed'} below all serve the ${neighborhoodName} area.`,
  },
  {
    q: `Are there doulas who serve ${neighborhoodName} specifically?`,
    a: `Yes — ${doulaCount} ${doulaCount === 1 ? 'doula or midwife is' : 'doulas and midwives are'} listed below who explicitly include ${neighborhoodName} in their service area. Each provider confirmed they serve families in ${neighborhoodName} and surrounding areas near ${city}.`,
  },
  {
    q: `Does ${stateFullName} Medicaid cover doula services in ${neighborhoodName}?`,
    a: medicaidCovers
      ? `Yes, ${stateFullName} Medicaid covers doula services. Contact your Medicaid plan to confirm coverage details and find enrolled providers serving the ${neighborhoodName} area.`
      : `Currently, ${stateFullName} does not cover doulas through Medicaid. Some community organizations and volunteer doula programs near ${neighborhoodName} may offer free or reduced-cost support. Check the ${city} page for additional resources.`,
  },
  {
    q: `How do I find a birth-friendly hospital near ${neighborhoodName}?`,
    a: `${neighborhoodName} is part of the greater ${city} metro area. See our full ${city} birth guide for hospital maternity policies, birth center options, and provider recommendations near ${neighborhoodName}.`,
  },
];

// Schema
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: `${neighborhoodName}, ${state} Birth Doula & Midwife Guide`,
      description: pageDesc,
      author: { '@type': 'Organization', '@id': 'https://truejoybirthing.com/#organization' },
      publisher: { '@type': 'Organization', '@id': 'https://truejoybirthing.com/#organization' },
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: neighborhoodFaqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: `Birth Doula Resources for ${neighborhoodName} Families`,
      url: pageUrl,
      areaServed: {
        '@type': 'City',
        name: neighborhoodName,
        containedInPlace: { '@type': 'City', name: city, containedInPlace: { '@type': 'State', name: stateFullName } },
      },
      provider: { '@id': 'https://truejoybirthing.com/#organization' },
      serviceType: 'Birth Doula Support',
      description: `Birth doula and midwife directory for families in ${neighborhoodName}, ${state}. ${doulaCount} ${doulaCount === 1 ? 'provider' : 'providers'} serving this area.`,
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${pageUrl}#local-business`,
      name: `True Joy Birthing — ${neighborhoodName}, ${state}`,
      description: `Birth doula and midwife directory and Joyful Birth Plan resources for families in ${neighborhoodName}, ${state}.`,
      url: pageUrl,
      areaServed: {
        '@type': 'City',
        name: neighborhoodName,
        containedInPlace: { '@type': 'State', name: stateFullName },
      },
      parentOrganization: { '@id': 'https://truejoybirthing.com/#organization' },
    },
    {
      '@type': 'SpeakableSpecification',
      '@id': `${pageUrl}#speakable`,
      cssSelector: ['.prose h2', '.prose h3', '.faq-answer'],
    },
  ],
};

const ogImage = cityData.ogImage || `https://truejoybirthing.com/images/og-city-${citySlug}.webp`;
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonical={pageUrl}
  ogImage={ogImage}
  ogImageAlt={heroAlt}
  ogType="article"
  breadcrumbList={breadcrumbList}
  schema={schema}
>
  <!-- ═══ Breadcrumb ═══ -->
  <nav aria-label="Breadcrumb" class="bg-tjb-cream pt-4 pb-2">
    <div class="max-w-7xl mx-auto px-6">
      <ol class="flex items-center gap-1.5 flex-wrap text-sm text-tjb-gray">
        <li class="flex items-center gap-1.5">
          <a href="https://truejoybirthing.com/" class="text-tjb-lavender-600 hover:underline">Home</a>
          <span class="text-tjb-gray/50">›</span>
        </li>
        <li class="flex items-center gap-1.5">
          <a href="/birth-support/" class="text-tjb-lavender-600 hover:underline">Birth Support</a>
          <span class="text-tjb-gray/50">›</span>
        </li>
        <li class="flex items-center gap-1.5">
          <a href={`/birth-support/${stateHubSlug}/`} class="text-tjb-lavender-600 hover:underline">{stateFullName}</a>
          <span class="text-tjb-gray/50">›</span>
        </li>
        <li class="flex items-center gap-1.5">
          <a href={`/birth-support/${citySlug}/`} class="text-tjb-lavender-600 hover:underline">{city}</a>
          <span class="text-tjb-gray/50">›</span>
        </li>
        <li class="text-tjb-charcoal font-medium" aria-current="page">{neighborhoodName}</li>
      </ol>
    </div>
  </nav>

  <!-- ═══ Hero — Neighborhood ═══ -->
  <section class="bg-tjb-cream pt-16 pb-12">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl">
        <p class="eyebrow text-tjb-rose-500 uppercase text-xs font-semibold tracking-widest mb-4">{neighborhoodName} Birth Doula Support</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
        <h1 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: 'DM Serif Display', Georgia, serif;">
          Doulas & Midwives Serving {neighborhoodName}, {state}
        </h1>
        <p class="text-lg text-tjb-charcoal font-semibold mb-2">
          {doulaCount} {doulaCount === 1 ? 'birth doula or midwife is' : 'birth doulas and midwives are'} available to families in {neighborhoodName}, part of the greater {city} metro area.
        </p>
        <p class="text-tjb-gray mb-6">
          Whether you're looking for a <strong>doula in {neighborhoodName}</strong>, building your birth plan, or figuring out what support looks like in your area — everything here is free. These providers all serve {neighborhoodName} and surrounding neighborhoods near {city}.
        </p>
        {costLow > 0 && (
          <p class="mb-6">
            <span class="inline-flex items-center bg-tjb-rose-50 text-tjb-rose-600 text-sm font-semibold px-3 py-1 rounded-full border border-tjb-rose-200">
              Birth doula support serving {neighborhoodName} starts at ${costLow}
            </span>
          </p>
        )}
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="https://apps.apple.com/us/app/true-joy-birthing/id6760793180" class="btn-primary text-center">Build Your Birth Plan in the App</a>
          <a href="/birth-plan-template/" class="btn-secondary text-center">Or download the free PDF →</a>
        </div>
        <p class="text-xs text-tjb-gray mt-3">Free · No account needed · Works on iPhone</p>
      </div>
    </div>
  </section>

  <!-- ═══ Doulas Serving {neighborhoodName} ═══ -->
  <section class="py-20 bg-tjb-cream">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="eyebrow text-tjb-rose-500 uppercase text-xs font-semibold tracking-widest mb-4">Local support</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
        <h2 class="text-2xl md:text-3xl font-bold text-tjb-charcoal mb-4" style="font-family: 'DM Sans', sans-serif;">
          Doulas & Midwives Serving {neighborhoodName}
        </h2>
        <p class="text-tjb-gray max-w-2xl mx-auto">
          Real people, real support: here {doulaCount === 1 ? 'is the doula' : 'are the doulas and midwives'} who serve {neighborhoodName} families. Every listing is a practicing provider, not an ad.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 not-prose" id="doula-grid">
        {[...neighborhoodDoulas].sort((a, b) => (b.isVerified === true ? 1 : 0) - (a.isVerified === true ? 1 : 0)).map((doula) => {
          const verified = doula.isVerified === true;
          return (
            <div class={`doula-card bg-white relative rounded-xl p-6 shadow-sm border hover:shadow-md transition-shadow duration-200 flex flex-col items-center text-center ${doula.isAmbassador ? 'border-2 border-tjb-rose-300 shadow-md' : 'border-tjb-lavender-200/50 hover:border-tjb-lavender-300'}`}>
              {/* Verification tier badge */}
              {verified && (
                <span class="absolute top-3 right-3 inline-flex items-center gap-1 bg-tjb-sage-100 text-tjb-charcoal text-xs font-medium px-2.5 py-0.5 rounded-full border border-tjb-sage" role="status" aria-label="Provider-verified listing">
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M10 3L4.5 8.5L2 6" stroke="#2A2A2A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  Provider-verified
                </span>
              )}
              {/* Photo or initial monogram */}
              {doula.photo ? (
                <img src={doula.photo} alt={`${doula.name}, doula`} class="w-14 h-14 rounded-full object-cover mb-4" width="56" height="56" loading="lazy" />
              ) : (
                <div class="w-14 h-14 rounded-full flex items-center justify-center mb-4 bg-tjb-lavender-100">
                  <span class="text-2xl font-semibold text-tjb-charcoal" style="font-family: 'Cormorant Garamond', Georgia, serif;">{doula.name.split(' ').map((n) => n[0]).join('')}</span>
                </div>
              )}
              <h3 class="text-lg font-semibold text-tjb-charcoal leading-tight mb-1" style="font-family: 'Cormorant Garamond', Georgia, serif;">{doula.name}</h3>
              {doula.credential && <p class="text-sm text-tjb-lavender-600 font-medium mb-2">{doula.credential}</p>}
              {doula.practice && <p class="text-sm text-tjb-gray mb-1">{doula.practice}</p>}
              {doula.costRange && <p class="text-sm text-tjb-charcoal font-medium mb-2">{doula.costRange}</p>}
              {(doula.services && doula.services.length > 0) && (
                <div class="flex flex-wrap justify-center gap-1.5 mt-1 mb-2">
                  {doula.services.map((svc) => (
                    <span class="text-xs bg-tjb-lavender-50 text-tjb-lavender-700 px-2 py-0.5 rounded-full border border-tjb-lavender-200">{svc}</span>
                  ))}
                </div>
              )}
              {doula.acceptingClients && (
                <span class="inline-flex items-center gap-1 text-xs text-tjb-sage-700 bg-tjb-sage-50 px-2 py-0.5 rounded-full border border-tjb-sage-200 mb-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-tjb-sage-500"></span>
                  {typeof doula.acceptingClients === 'string' ? doula.acceptingClients : 'Accepting clients'}
                </span>
              )}
              {doula.acceptsMedicaid && (
                <span class="inline-flex items-center gap-1 text-xs text-green-700 bg-green-50 px-2 py-0.5 rounded-full border border-green-200 mb-2">
                  Accepts Medicaid
                </span>
              )}
              {doula.url && (
                <a href={doula.url} target="_blank" rel="noopener noreferrer" class="text-sm text-tjb-rose-600 hover:text-tjb-rose-700 font-medium mt-auto pt-2">Visit website →</a>
              )}
            </div>
          );
        })}
      </div>

      <!-- Back-link to parent city -->
      <div class="mt-12 text-center">
        <div class="inline-flex flex-col gap-2 p-6 rounded-2xl bg-white border border-tjb-lavender-200/50 shadow-sm">
          <p class="text-tjb-gray text-sm">
            {neighborhoodName} is part of the greater {city} metro area.
          </p>
          <p class="text-tjb-gray text-sm">
            See the full {city} birth guide for hospitals, birth centers, and all {cityData.localDoulas?.length || 0} doulas and midwives in the area.
          </p>
          <a href={`/birth-support/${citySlug}/`} class="text-tjb-rose-600 hover:text-tjb-rose-700 font-semibold text-lg">
            Full {city}, {state} Birth Guide →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="py-20 bg-white" id="faqs">
    <div class="max-w-3xl mx-auto px-6 prose">
      <div class="text-center mb-10">
        <p class="eyebrow text-tjb-rose-500 uppercase text-xs font-semibold tracking-widest mb-4">Questions moms ask</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
        <h2 class="text-2xl md:text-3xl font-bold text-tjb-charcoal" style="font-family: 'DM Sans', sans-serif;">
          {neighborhoodName} Birth Doula FAQs
        </h2>
      </div>
      <div class="space-y-6">
        {neighborhoodFaqs.map((faq) => (
          <div class="border-b border-tjb-lavender-200/50 pb-6">
            <h3 class="text-lg font-semibold text-tjb-charcoal mb-3" style="font-family: 'DM Sans', sans-serif;">{faq.q}</h3>
            <p class="faq-answer text-tjb-gray leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="py-16 bg-tjb-cream">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-tjb-charcoal mb-4" style="font-family: 'DM Serif Display', Georgia, serif;">
        Build Your Birth Plan for Free
      </h2>
      <p class="text-tjb-gray mb-6 max-w-xl mx-auto">
        Whether you're in {neighborhoodName}, {city}, or anywhere else in {stateFullName}, the True Joy Birthing app helps you create a complete birth plan in minutes. Free, private, and works on your iPhone.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="https://apps.apple.com/us/app/true-joy-birthing/id6760793180" class="btn-primary text-center">Build Your Birth Plan →</a>
        <a href={`/birth-support/${citySlug}/`} class="btn-secondary text-center">See all {city} doulas →</a>
      </div>
    </div>
  </section>

  <!-- ═══ Related Links ═══ -->
  <section class="py-12 bg-white border-t border-tjb-lavender-200/50">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-xl font-bold text-tjb-charcoal mb-4" style="font-family: 'DM Sans', sans-serif;">Explore more</h2>
      <div class="flex flex-wrap gap-3 text-sm">
        <a href={`/birth-support/${citySlug}/`} class="inline-flex items-center gap-1 text-tjb-rose-600 hover:underline font-medium">
          ← {city}, {state} birth guide
        </a>
        <span class="text-tjb-gray/40">|</span>
        <a href={`/birth-support/${stateHubSlug}/`} class="inline-flex items-center gap-1 text-tjb-lavender-600 hover:underline font-medium">
          All {stateFullName} cities
        </a>
        <span class="text-tjb-gray/40">|</span>
        <a href="/doula-cost/" class="inline-flex items-center gap-1 text-tjb-lavender-600 hover:underline font-medium">
          Doula cost guide
        </a>
        <span class="text-tjb-gray/40">|</span>
        <a href="/medicaid-doula-coverage/" class="inline-flex items-center gap-1 text-tjb-lavender-600 hover:underline font-medium">
          Medicaid doula coverage
        </a>
      </div>
    </div>
  </section>
</Layout>