---
// Dynamic pregnancy week page template — renders one page per week (4–40)
// from src/data/pregnancy-weeks.ts at build time.
import Layout from '../../layouts/Layout.astro';
import { PREGNANCY_WEEKS, PREGNANCY_WEEK_BY_WEEK } from '../../data/pregnancy-weeks.ts';
import { PARTNER_WEEK_BY_WEEK } from '../../data/pregnancy-weeks-partner.ts';

const SITE = 'https://truejoybirthing.com';

export function getStaticPaths() {
  return PREGNANCY_WEEKS.map((week) => ({
    params: { week: week.slug },
    props: { week },
  }));
}

const { week } = Astro.props;
const partner = PARTNER_WEEK_BY_WEEK[week.week];

const trimesterName =
  week.trimester === 'first' ? 'First Trimester' :
  week.trimester === 'second' ? 'Second Trimester' : 'Third Trimester';

const prevWeek = PREGNANCY_WEEK_BY_WEEK[week.week - 1] || null;
const nextWeek = PREGNANCY_WEEK_BY_WEEK[week.week + 1] || null;

const pageTitle = `${week.week} Weeks Pregnant: Baby Development & Your Body`;
const description = week.metaDescription || `${week.babyTitle} at ${week.week} weeks pregnant. See how your baby is developing this week, what's happening in your body, and a word of encouragement from doula Shelbi Kohler.`;
const relatedWeekNumbers = [4, 12, 20, 28, 36].filter((n) => n !== week.week && PREGNANCY_WEEK_BY_WEEK[n]);
const canonical = `${SITE}/pregnancy/${week.slug}/`;
const imageUrl = `${SITE}/images/pregnancy-series/${week.imageName}`;

const breadcrumbList = [
  { name: 'Home', url: `${SITE}/` },
  { name: 'Pregnancy Week by Week', url: `${SITE}/pregnancy-week-by-week/` },
  { name: trimesterName, url: `${SITE}/pregnancy-week-by-week/#${week.trimester}-trimester` },
  { name: `${week.week} Weeks Pregnant`, url: canonical },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': `${canonical}#medicalwebpage`,
      url: canonical,
      name: pageTitle,
      headline: `${week.week} Weeks Pregnant`,
      description,
      image: imageUrl,
      inLanguage: 'en-US',
      about: {
        '@type': 'MedicalCondition',
        name: `Pregnancy, week ${week.week}`,
      },
      author: {
        '@type': 'Person',
        name: 'Shelbi Kohler',
        jobTitle: 'Certified Birth Doula',
        url: `${SITE}/about/`,
      },
      datePublished: '2026-08-25',
      dateModified: '2026-08-25',
      lastReviewed: '2026-08-25',
      reviewedBy: {
        '@type': 'Person',
        name: 'Shelbi Kohler',
        jobTitle: 'Certified Birth Doula',
        url: `${SITE}/about/`,
      },
      publisher: {
        '@type': 'Organization',
        name: 'True Joy Birthing',
        '@id': `${SITE}/#organization`,
      },
      mainEntityOfPage: canonical,
      isPartOf: {
        '@type': 'WebPage',
        url: `${SITE}/pregnancy-week-by-week/`,
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: week.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbList.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.name,
        item: crumb.url,
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={description}
  canonical={canonical}
  ogImage={imageUrl}
  ogImageAlt={`Week ${week.week} pregnancy illustration — ${week.babyTitle}`}
  ogType="article"
  breadcrumbList={breadcrumbList}
  schema={schema}
>

  <!-- ═══════════════════════════════════════════
       HERO ILLUSTRATION — full-width, generous whitespace
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream">
    <div class="max-w-7xl mx-auto px-6 md:px-12 pt-10 md:pt-14 pb-16 md:pb-24 text-center">

      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center justify-center gap-2 text-sm text-tjb-gray list-none p-0 m-0">
          <li><a href="/" class="text-tjb-lavender-600 hover:text-tjb-rose-500 no-underline">Home</a></li>
          <li aria-hidden="true" class="text-tjb-gray-300">/</li>
          <li><a href="/pregnancy-week-by-week/" class="text-tjb-lavender-600 hover:text-tjb-rose-500 no-underline">Week by Week</a></li>
          <li aria-hidden="true" class="text-tjb-gray-300">/</li>
          <li class="font-medium text-tjb-charcoal">{trimesterName}</li>
        </ol>
      </nav>

      <!-- Hero illustration -->
      <img
        src={`/images/pregnancy-series/${week.imageName}`}
        alt={`Pregnancy illustration for week ${week.week} — baby ${week.babyTitle}`}
        class="w-full max-w-2xl mx-auto rounded-xl"
        width="800"
        height="800"
        loading="eager"
        fetchpriority="high"
      />

      <!-- Week heading -->
      <p class="eyebrow mt-12 mb-3">{trimesterName} · Week {week.week}</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6 mx-auto"></div>
      <h1 class="font-bold text-tjb-charcoal leading-[1.15] mb-5 max-w-3xl mx-auto" style="font-size: clamp(2rem, 4.5vw, 3.25rem);">
        {week.week} Weeks Pregnant: {week.babyTitle}
      </h1>

      <!-- Size reference chips -->
      {(week.food || week.sizeNote) && (
        <div class="flex items-center justify-center gap-3 mb-8">
          {week.food && (
            <span class="inline-flex items-center bg-white border border-tjb-lavender-200 rounded-full px-4 py-1.5 text-sm text-tjb-charcoal shadow-sm">
              🍎 About the size of a <strong class="ml-1 capitalize">{week.food}</strong>
            </span>
          )}
          {week.sizeNote && (
            <span class="inline-flex items-center bg-tjb-lavender-100 border border-tjb-lavender-200 rounded-full px-4 py-1.5 text-sm text-tjb-charcoal">
              📏 {week.sizeNote}
            </span>
          )}
        </div>
      )}

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       BABY DEVELOPMENT THIS WEEK
       ═══════════════════════════════════════════ -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">

      <p class="eyebrow mb-4">Baby development</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-8" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        Your baby at {week.week} weeks
      </h2>
      <p class="text-tjb-gray text-lg leading-[1.8]">{week.babyDescription}</p>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       YOUR BODY THIS WEEK
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">

      <p class="eyebrow mb-4">Your body this week</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-8" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        What you might be feeling at {week.week} weeks
      </h2>
      <p class="text-tjb-gray text-lg leading-[1.8]">{week.maternalBody}</p>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       FROM SHELBI — warm, personal callout
       ═══════════════════════════════════════════ -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">
      <div class="relative rounded-2xl bg-tjb-lavender-100/70 border border-tjb-lavender-200 p-8 md:p-12 overflow-hidden">
        <!-- Decorative quote mark -->
        <span aria-hidden="true" class="absolute -top-4 left-6 font-serif text-[7rem] leading-none text-tjb-rose-400/30 select-none">&ldquo;</span>
        <div class="relative">
          <div class="flex items-center gap-3 mb-5">
            <img src="/images/shelbi-thumb.webp" alt="Shelbi Kohler, certified birth doula" width="48" height="48" class="w-12 h-12 rounded-full object-cover ring-2 ring-white" />
            <div>
              <p class="font-semibold text-tjb-charcoal leading-tight">From Shelbi</p>
              <p class="text-sm text-tjb-gray">Shelbi Kohler · mother of seven · certified birth doula</p>
            </div>
          </div>
          <p class="text-tjb-charcoal/90 text-lg md:text-xl leading-[1.85] italic" style="font-family: 'DM Serif Display', Georgia, serif;">
            {week.fromShelbi}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PARTNER VIEW TOGGLE
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">

      <!-- Toggle -->
      <div class="flex items-center justify-center mb-10">
        <div class="inline-flex bg-white rounded-full border border-tjb-lavender-200 p-1 shadow-sm" role="tablist" aria-label="Week perspective">
          <button id="view-mom" class="view-toggle-btn px-5 py-2 rounded-full text-sm font-semibold transition-all bg-tjb-rose-500 text-white" role="tab" aria-selected="true" aria-controls="mom-view-content" tabindex="0">Mom's view</button>
          <button id="view-partner" class="view-toggle-btn px-5 py-2 rounded-full text-sm font-semibold transition-all text-tjb-gray" role="tab" aria-selected="false" aria-controls="partner-view-content" tabindex="-1">Partner's view</button>
        </div>
      </div>

      <!-- Mom's view (default, already shown above in body section) -->
      <div id="mom-view-content" class="view-content" role="tabpanel" aria-labelledby="view-mom" tabindex="0">
        <div class="text-center">
          <p class="eyebrow mb-3">For you</p>
          <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6 mx-auto"></div>
          <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-6" style="font-size: clamp(1.5rem, 3.5vw, 2.25rem);">
            This week is about getting through it
          </h2>
          <p class="text-tjb-gray text-lg leading-[1.8] max-w-2xl mx-auto">
            Scroll up to revisit your baby's development and Shelbi's encouragement for week {week.week}.
            When you're ready, share this week with your partner.
          </p>
        </div>
      </div>

      <!-- Partner's view (hidden by default) -->
      <div id="partner-view-content" class="view-content hidden" role="tabpanel" aria-labelledby="view-partner" tabindex="0">
        <div class="space-y-8">
          <div>
            <p class="eyebrow mb-3">What she's feeling</p>
            <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
            <p class="text-tjb-gray text-lg leading-[1.8]">{partner.partnerSummary}</p>
          </div>
          <div class="rounded-2xl bg-white border border-tjb-lavender-200 p-8">
            <p class="eyebrow mb-3">What you can do</p>
            <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
            <p class="text-tjb-charcoal text-lg leading-[1.8]">{partner.partnerAction}</p>
          </div>
          <p class="text-sm text-tjb-gray/70 text-center italic">
            From Shelbi — mother of seven, certified birth doula. Written for the partner who wants to show up well.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SHAREABLE WEEK CARD
       ═══════════════════════════════════════════ -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">

      <p class="eyebrow mb-3">Share this week</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6 mx-auto"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-4" style="font-size: clamp(1.5rem, 3.5vw, 2.25rem);">
        Save and share your week {week.week} card
      </h2>
      <p class="text-tjb-gray text-lg leading-relaxed mb-8 max-w-xl mx-auto">
        Download a beautifully designed card with this week's illustration to share with family, friends, or on social media.
      </p>

      <!-- Canvas (hidden, used for generation) -->
      <canvas id="share-canvas" width="1080" height="1080" class="hidden"></canvas>

      <!-- Preview + buttons -->
      <div class="flex flex-col items-center gap-6">
        <img id="share-preview" alt="Shareable week card preview" width="400" height="400" class="w-full max-w-sm rounded-2xl shadow-lg border border-tjb-lavender-200" />
        <div class="flex flex-wrap items-center justify-center gap-3">
          <button id="download-card" class="btn-primary" aria-label={`Download the week ${week.week} pregnancy card as a PNG image`}>Download card</button>
          <button id="share-card" class="btn-secondary" aria-label={`Share the week ${week.week} pregnancy card via iMessage, Instagram, or Facebook`}>Share to social</button>
        </div>
        <p class="text-xs text-tjb-gray/60">Card is 1080×1080 — save the image to share via iMessage, Instagram, or Facebook.</p>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       THIRD TRIMESTER CROSS-LINKS (weeks 34–40)
       ═══════════════════════════════════════════ -->
  {week.week >= 34 && (
    <section class="bg-tjb-cream py-14">
      <div class="max-w-3xl mx-auto px-6">
        <div class="rounded-2xl bg-white border border-tjb-rose-300/60 p-8 md:p-10">
          <p class="eyebrow mb-3">You're getting close</p>
          <h2 class="text-2xl md:text-3xl font-semibold text-tjb-charcoal mb-4">
            The finish line is in sight — here are two things worth doing now
          </h2>
          <p class="text-tjb-gray leading-relaxed mb-6">
            At {week.week} weeks, birth could be just around the corner. These two free guides will help you feel ready:
          </p>
          <div class="grid sm:grid-cols-2 gap-4">
            <a href="/birth-plan-template/" class="block no-underline group bg-tjb-cream rounded-xl p-5 border border-tjb-lavender-200/50 hover:border-tjb-rose-400 transition-colors">
              <span class="text-xs font-bold uppercase tracking-wide text-tjb-rose-500">Free guide</span>
              <h3 class="mt-1 font-semibold text-lg text-tjb-charcoal group-hover:text-tjb-rose-600 transition-colors">Free Birth Plan Template</h3>
              <p class="mt-1 text-sm text-tjb-gray leading-relaxed">A nurse-readable plan covering labor, pain management, delivery, postpartum, and newborn care.</p>
              <span class="mt-2 inline-block text-xs text-tjb-lavender-600 font-medium">Get the template →</span>
            </a>
            <a href="/benefits-of-a-doula/" class="block no-underline group bg-tjb-cream rounded-xl p-5 border border-tjb-lavender-200/50 hover:border-tjb-rose-400 transition-colors">
              <span class="text-xs font-bold uppercase tracking-wide text-tjb-rose-500">Free guide</span>
              <h3 class="mt-1 font-semibold text-lg text-tjb-charcoal group-hover:text-tjb-rose-600 transition-colors">The Benefits of a Doula</h3>
              <p class="mt-1 text-sm text-tjb-gray leading-relaxed">What the research says about doula support — shorter labors, fewer interventions, more confidence.</p>
              <span class="mt-2 inline-block text-xs text-tjb-lavender-600 font-medium">Read the benefits →</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════
       RELATED WEEKS — internal linking
       ═══════════════════════════════════════════ -->
  {relatedWeekNumbers.length > 0 && (
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-3xl mx-auto px-6">
        <p class="eyebrow mb-4">Related weeks</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
        <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-8" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
          Keep following your pregnancy
        </h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {relatedWeekNumbers.map((n) => {
            const rw = PREGNANCY_WEEK_BY_WEEK[n];
            return (
              <a href={`/pregnancy/${rw.slug}/`} class="group no-underline bg-tjb-cream rounded-xl p-5 border border-tjb-lavender-200/50 hover:border-tjb-rose-400 transition-colors">
                <span class="text-xs font-bold uppercase tracking-wide text-tjb-lavender-600">Week {n}</span>
                <p class="mt-1 font-semibold text-tjb-charcoal group-hover:text-tjb-rose-600 transition-colors">{n} weeks pregnant: {rw.babyTitle}</p>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════
       FAQ
       ═══════════════════════════════════════════ -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">

      <p class="eyebrow mb-4">Common questions</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-10" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        {week.week} weeks pregnant: your questions answered
      </h2>

      <div class="space-y-4">
        {week.faqs.map((faq) => (
          <details class="group bg-tjb-cream rounded-xl border border-tjb-lavender-200/50 open:shadow-md transition-shadow">
            <summary class="cursor-pointer list-none p-5 font-semibold text-tjb-charcoal flex items-center justify-between gap-4">
              {faq.q}
              <span class="text-tjb-rose-500 group-open:rotate-45 transition-transform text-xl leading-none shrink-0">+</span>
            </summary>
            <p class="px-5 pb-5 text-tjb-gray leading-relaxed">{faq.a}</p>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       APP DOWNLOAD CTA
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-charcoal py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-4">
        Follow every week in the free app
      </h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        Weekly baby updates, your birth plan, and doula-backed guidance — all free, all in one place.
      </p>
      <a href="https://apps.apple.com/us/app/true-joy-birthing/id6760793180" class="btn-primary">Download the True Joy Birthing app</a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PREV / NEXT WEEK NAVIGATION
       ═══════════════════════════════════════════ -->
  <section class="bg-white border-t border-tjb-lavender-200/50 py-10">
    <div class="max-w-4xl mx-auto px-6 grid sm:grid-cols-2 gap-4">
      {prevWeek ? (
        <a href={`/pregnancy/${prevWeek.slug}/`} class="group no-underline bg-tjb-cream rounded-xl p-5 border border-tjb-lavender-200/50 hover:border-tjb-rose-400 transition-colors">
          <span class="text-xs font-bold uppercase tracking-wide text-tjb-lavender-600">← Previous week</span>
          <p class="mt-1 font-semibold text-tjb-charcoal group-hover:text-tjb-rose-600 transition-colors">Week {prevWeek.week}: {prevWeek.babyTitle}</p>
        </a>
      ) : (
        <a href="/pregnancy-week-by-week/" class="group no-underline bg-tjb-cream rounded-xl p-5 border border-tjb-lavender-200/50 hover:border-tjb-rose-400 transition-colors">
          <span class="text-xs font-bold uppercase tracking-wide text-tjb-lavender-600">← Back to hub</span>
          <p class="mt-1 font-semibold text-tjb-charcoal group-hover:text-tjb-rose-600 transition-colors">Pregnancy Week by Week hub</p>
        </a>
      )}
      {nextWeek ? (
        <a href={`/pregnancy/${nextWeek.slug}/`} class="group no-underline bg-tjb-cream rounded-xl p-5 border border-tjb-lavender-200/50 hover:border-tjb-rose-400 transition-colors sm:text-right">
          <span class="text-xs font-bold uppercase tracking-wide text-tjb-lavender-600">Next week →</span>
          <p class="mt-1 font-semibold text-tjb-charcoal group-hover:text-tjb-rose-600 transition-colors">Week {nextWeek.week}: {nextWeek.babyTitle}</p>
        </a>
      ) : (
        <a href="/pregnancy-week-by-week/" class="group no-underline bg-tjb-cream rounded-xl p-5 border border-tjb-lavender-200/50 hover:border-tjb-rose-400 transition-colors sm:text-right">
          <span class="text-xs font-bold uppercase tracking-wide text-tjb-lavender-600">Back to the guide</span>
          <p class="mt-1 font-semibold text-tjb-charcoal group-hover:text-tjb-rose-600 transition-colors">Pregnancy Week by Week hub</p>
        </a>
      )}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CLIENT-SIDE SCRIPTS: Partner toggle + Share card
       ═══════════════════════════════════════════ -->
  <script define:vars={{
    weekNum: week.week,
    babyTitle: week.babyTitle,
    imageName: week.imageName,
    food: week.food,
    sizeNote: week.sizeNote,
    trimesterName,
  }}>
    // ── Partner View Toggle ──
    const btnMom = document.getElementById('view-mom');
    const btnPartner = document.getElementById('view-partner');
    const momContent = document.getElementById('mom-view-content');
    const partnerContent = document.getElementById('partner-view-content');

    function styleActive(activeBtn, inactiveBtn) {
      activeBtn.classList.add('bg-tjb-rose-500', 'text-white');
      activeBtn.classList.remove('text-tjb-gray');
      inactiveBtn.classList.remove('bg-tjb-rose-500', 'text-white');
      inactiveBtn.classList.add('text-tjb-gray');
    }

    function setView(view) {
      if (view === 'partner') {
        styleActive(btnPartner, btnMom);
        btnMom.setAttribute('aria-selected', 'false');
        btnMom.setAttribute('tabindex', '-1');
        btnPartner.setAttribute('aria-selected', 'true');
        btnPartner.setAttribute('tabindex', '0');
        momContent.classList.add('hidden');
        partnerContent.classList.remove('hidden');
      } else {
        styleActive(btnMom, btnPartner);
        btnMom.setAttribute('aria-selected', 'true');
        btnMom.setAttribute('tabindex', '0');
        btnPartner.setAttribute('aria-selected', 'false');
        btnPartner.setAttribute('tabindex', '-1');
        partnerContent.classList.add('hidden');
        momContent.classList.remove('hidden');
      }
    }

    btnMom.addEventListener('click', () => setView('mom'));
    btnPartner.addEventListener('click', () => setView('partner'));

    // Arrow-key navigation between tabs
    const tablist = document.querySelector('[role="tablist"]');
    tablist.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight' && e.key !== 'Home' && e.key !== 'End') return;
      e.preventDefault();
      const toPartner = (e.key === 'ArrowRight') ? !btnPartner.getAttribute('aria-selected') || btnPartner.getAttribute('aria-selected') === 'false' :
        (e.key === 'ArrowLeft') ? btnPartner.getAttribute('aria-selected') === 'true' : null;
      let target;
      if (e.key === 'Home') target = btnMom;
      else if (e.key === 'End') target = btnPartner;
      else target = toPartner ? btnPartner : btnMom;
      setView(target === btnPartner ? 'partner' : 'mom');
      target.focus();
    });

    // ── Shareable Week Card Generator ──
    const canvas = document.getElementById('share-canvas');
    const ctx = canvas.getContext('2d');
    const preview = document.getElementById('share-preview');
    const downloadBtn = document.getElementById('download-card');
    const shareBtn = document.getElementById('share-card');

    const W = 1080, H = 1080;
    const bgColor = '#FBF7F0'; // cream
    const roseColor = '#E11D48';
    const charcoalColor = '#3B3A36';
    const lavenderColor = '#C4B5E4';
    const grayColor = '#6B6A66';

    function roundRect(ctx, x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r);
      ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r);
      ctx.arcTo(x, y, x + w, y, r);
      ctx.closePath();
    }

    async function generateCard() {
      // Background
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, W, H);

      // Decorative top bar
      ctx.fillStyle = roseColor;
      ctx.fillRect(0, 0, W, 8);

      // Load illustration
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.src = `/images/pregnancy-series/${imageName}`;
      await new Promise((resolve) => { img.onload = resolve; img.onerror = resolve; });

      // Draw illustration centered (500x500 area)
      const imgSize = 500;
      const imgX = (W - imgSize) / 2;
      const imgY = 60;
      if (img.complete && img.naturalWidth > 0) {
        ctx.save();
        roundRect(ctx, imgX, imgY, imgSize, imgSize, 24);
        ctx.clip();
        ctx.drawImage(img, imgX, imgY, imgSize, imgSize);
        ctx.restore();
      }

      // Week number
      ctx.fillStyle = roseColor;
      ctx.font = 'bold 48px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(`WEEK ${weekNum}`, W / 2, 620);

      // Baby title
      ctx.fillStyle = charcoalColor;
      ctx.font = 'bold 40px Georgia, serif';
      const title = food ? `As small as a ${food}` : babyTitle;
      ctx.fillText(title, W / 2, 680);

      // Size note
      if (sizeNote) {
        ctx.fillStyle = grayColor;
        ctx.font = '28px sans-serif';
        ctx.fillText(sizeNote, W / 2, 730);
      }

      // Trimester
      ctx.fillStyle = lavenderColor;
      ctx.font = '24px sans-serif';
      ctx.fillText(trimesterName, W / 2, 780);

      // Brand mark
      ctx.fillStyle = roseColor;
      ctx.font = 'bold 32px Georgia, serif';
      ctx.fillText('True Joy Birthing', W / 2, 900);

      // URL
      ctx.fillStyle = grayColor;
      ctx.font = '24px sans-serif';
      ctx.fillText('truejoybirthing.com', W / 2, 940);

      // Decorative bottom bar
      ctx.fillStyle = roseColor;
      ctx.fillRect(0, H - 8, W, 8);

      // Set preview
      preview.src = canvas.toDataURL('image/png');
    }

    // Generate on load
    generateCard();

    // Download
    downloadBtn.addEventListener('click', () => {
      canvas.toBlob((blob) => {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `week-${weekNum}-pregnancy-card.png`;
        a.click();
        URL.revokeObjectURL(url);
      }, 'image/png');
    });

    // Share (Web Share API if available, fallback to download)
    shareBtn.addEventListener('click', async () => {
      canvas.toBlob(async (blob) => {
        const file = new File([blob], `week-${weekNum}-card.png`, { type: 'image/png' });
        if (navigator.share && navigator.canShare({ files: [file] })) {
          try {
            await navigator.share({
              files: [file],
              title: `Week ${weekNum} — ${babyTitle}`,
              text: `Following my pregnancy week by week at truejoybirthing.com`,
            });
          } catch (e) { /* user cancelled */ }
        } else {
          // Fallback: trigger download
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `week-${weekNum}-pregnancy-card.png`;
          a.click();
          URL.revokeObjectURL(url);
        }
      }, 'image/png');
    });
  </script>

</Layout>
