  <!-- ═══════════════════════════════════════════
       DOULA COST CALCULATOR, Vanilla JS
       ═══════════════════════════════════════════ -->
  <script is:inline>
    (function() {
      // Cost data: [low, high] per region per type
      const DATA = {
        birth: {
          major:    { low: 1500, high: 3000, label: 'major metros' },
          texas:    { low: 800,  high: 2800, label: 'Texas cities' },
          midsize:  { low: 700,  high: 2000, label: 'mid-size cities' },
          midwest:  { low: 900,  high: 2200, label: 'the Midwest' },
          pnw:      { low: 1000, high: 2500, label: 'the Pacific Northwest' },
          southeast:{ low: 800,  high: 2200, label: 'the Southeast' },
          mountain: { low: 750,  high: 2000, label: 'the Mountain West' },
          rural:    { low: 650,  high: 1500, label: 'smaller towns and rural areas' }
        },
        postpartum: {
          major:    { low: 35, high: 50 },
          texas:    { low: 25, high: 45 },
          midsize:  { low: 25, high: 40 },
          midwest:  { low: 25, high: 40 },
          pnw:      { low: 30, high: 50 },
          southeast:{ low: 25, high: 40 },
          mountain: { low: 25, high: 40 },
          rural:    { low: 20, high: 35 }
        },
        night: {
          major:    { low: 50, high: 75 },
          texas:    { low: 35, high: 55 },
          midsize:  { low: 35, high: 50 },
          midwest:  { low: 35, high: 50 },
          pnw:      { low: 40, high: 65 },
          southeast:{ low: 35, high: 50 },
          mountain: { low: 35, high: 50 },
          rural:    { low: 30, high: 45 }
        }
      };

      const BIRTH_INCLUDES = [
        '1-2 prenatal visits',
        '24/7 on-call availability from 37 weeks',
        'Continuous labor support',
        '1-2 postpartum visits',
        'Phone and text support throughout'
      ];
      const POSTPARTUM_INCLUDES = [
        'Recovery and healing support',
        'Infant feeding assistance',
        'Light household tasks',
        'Emotional support and companionship',
        'Sibling care and transition help'
      ];
      const NIGHT_INCLUDES = [
        'Overnight newborn care',
        'Feeding (bottle or bringing baby to nurse)',
        'Diaper changes and soothing',
        'Sleep environment setup',
        'Morning routine handoff'
      ];

      const fmt = n => '$' + n.toLocaleString('en-US');
      const regionSelect = document.getElementById('calc-region');
      const typeSelect = document.getElementById('calc-type');
      const hoursWrap = document.getElementById('calc-hours-wrap');
      const hoursSlider = document.getElementById('calc-hours');
      const hoursDisplay = document.getElementById('calc-hours-display');
      const lowEl = document.getElementById('calc-low');
      const highEl = document.getElementById('calc-high');
      const breakdownEl = document.getElementById('calc-breakdown');
      const includesEl = document.getElementById('calc-includes');

      function update() {
        const region = regionSelect.value;
        const type = typeSelect.value;
        const hours = parseInt(hoursSlider.value);
        hoursDisplay.textContent = hours;

        if (type === 'birth') {
          hoursWrap.classList.add('hidden');
          const d = DATA.birth[region];
          lowEl.textContent = fmt(d.low);
          highEl.textContent = fmt(d.high);
          breakdownEl.textContent = 'For a birth doula package in ' + d.label + ', including prenatal visits, on-call availability, continuous labor support, and 1-2 postpartum visits.';
          includesEl.innerHTML = BIRTH_INCLUDES.map(i => 
            '<div class="flex items-start gap-2"><span class="text-tjb-rose-500 mt-0.5">✓</span><span>' + i + '</span></div>'
          ).join('');
        } else if (type === 'postpartum') {
          hoursWrap.classList.remove('hidden');
          const d = DATA.postpartum[region];
          const weeklyLow = d.low * hours;
          const weeklyHigh = d.high * hours;
          lowEl.textContent = fmt(weeklyLow);
          highEl.textContent = fmt(weeklyHigh);
          breakdownEl.textContent = 'For ' + hours + ' hours/week of postpartum doula support in ' + DATA.birth[region].label + ', at ' + fmt(d.low) + ' to ' + fmt(d.high) + ' per hour. Most families use 8-20 hours per week for the first 2-6 weeks.';
          includesEl.innerHTML = POSTPARTUM_INCLUDES.map(i => 
            '<div class="flex items-start gap-2"><span class="text-tjb-rose-500 mt-0.5">✓</span><span>' + i + '</span></div>'
          ).join('');
        } else {
          hoursWrap.classList.remove('hidden');
          const d = DATA.night[region];
          const nightlyLow = d.low * 8;
          const nightlyHigh = d.high * 8;
          const weeklyLow = nightlyLow * (hours >= 20 ? 5 : 3);
          const weeklyHigh = nightlyHigh * (hours >= 20 ? 6 : 4);
          lowEl.textContent = fmt(weeklyLow);
          highEl.textContent = fmt(weeklyHigh);
          breakdownEl.textContent = 'For ' + (hours >= 20 ? '5-6' : '3-4') + ' nights/week of overnight care in ' + DATA.birth[region].label + ', at ' + fmt(d.low) + ' to ' + fmt(d.high) + ' per hour (typical 8-hour shift).';
          includesEl.innerHTML = NIGHT_INCLUDES.map(i => 
            '<div class="flex items-start gap-2"><span class="text-tjb-rose-500 mt-0.5">✓</span><span>' + i + '</span></div>'
          ).join('');
        }
      }

      regionSelect.addEventListener('change', update);
      typeSelect.addEventListener('change', update);
      hoursSlider.addEventListener('input', update);
      update();
    })();
  </script>

