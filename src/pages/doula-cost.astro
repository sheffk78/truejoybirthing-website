---
import Layout from '../layouts/Layout.astro';
import LeadCaptureForm from '../components/LeadCaptureForm.astro';
import ContextualCityLinks from '../components/ContextualCityLinks.astro';

const breadcrumbList = [{"name": "Home", "url": "https://truejoybirthing.com/"}, {"name": "How Much Does a Doula Cost", "url": "https://truejoybirthing.com/doula-cost/"}];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://truejoybirthing.com/doula-cost/#service",
      "name": "Birth Doula Support",
      "description": "Non-medical emotional, physical, and informational support during labor and delivery.",
      "provider": { "@id": "https://truejoybirthing.com/#organization" },
      "areaServed": { "@type": "Country", "name": "United States" },
      "offers": {
        "@type": "AggregateOffer",
        "lowPrice": "650",
        "highPrice": "3000",
        "priceCurrency": "USD",
        "offerCount": "1000"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://truejoybirthing.com/doula-cost/#faq",
      "mainEntity": [
        { "@type": "Question", "name": "How much does a doula cost?", "acceptedAnswer": { "@type": "Answer", "text": "A doula costs $650 to $3,000 for a standard birth package in the US. The national average is $1,200 to $1,500. Doula prices vary by location, experience, and what is included in the package. In major metros, expect $1,500 to $3,000. In Texas cities like Dallas, Houston, and Austin, the range is $800 to $2,800. In smaller towns and rural areas, costs range from $650 to $1,500." } },
        { "@type": "Question", "name": "How much is a doula?", "acceptedAnswer": { "@type": "Answer", "text": "A doula is $650 to $3,000 for a birth package, with most families paying $1,200 to $1,500. The exact price depends on your city, the doula's experience level, and what services are included. Postpartum doulas cost $25 to $50 per hour." } },
        { "@type": "Question", "name": "How much are doulas?", "acceptedAnswer": { "@type": "Answer", "text": "Doulas cost $650 to $3,000 for a birth package, averaging $1,200 to $1,500 nationally. In major cities, doulas cost $1,500 to $3,000. In smaller cities and rural areas, doulas cost $650 to $1,500. Postpartum doulas charge $25 to $50 per hour." } },
        { "@type": "Question", "name": "What does a doula cost?", "acceptedAnswer": { "@type": "Answer", "text": "A doula costs $650 to $3,000 for a birth package. The average cost is $1,200 to $1,500. The price includes prenatal visits, on-call availability from 37 weeks, continuous labor support, and 1-2 postpartum visits. Postpartum doulas cost $25 to $50 per hour." } },
        { "@type": "Question", "name": "How much do doulas cost?", "acceptedAnswer": { "@type": "Answer", "text": "Doulas cost $650 to $3,000 for a birth package, with a national average of $1,200 to $1,500. How much doulas cost depends on location, experience, and package inclusions. In major metros, doulas cost $1,500 to $3,000. In Texas cities, doulas cost $800 to $2,800. In rural areas, doulas cost $650 to $1,500." } },
        { "@type": "Question", "name": "How much do doulas charge?", "acceptedAnswer": { "@type": "Answer", "text": "Doulas charge $650 to $3,000 for a birth package. Most charge a flat package fee rather than an hourly rate. The average doula charges $1,200 to $1,500 for a package that includes prenatal visits, labor support, and postpartum follow-up. Postpartum doulas charge $25 to $50 per hour." } },
        { "@type": "Question", "name": "What are doula prices?", "acceptedAnswer": { "@type": "Answer", "text": "Doula prices range from $650 to $3,000 for a birth package. The average doula price is $1,200 to $1,500. In major metros like NYC and LA, doula prices reach $1,500 to $3,000. In Texas cities, doula prices are $800 to $2,800. In smaller towns, doula prices start at $650." } },
        { "@type": "Question", "name": "How much does a birth doula cost?", "acceptedAnswer": { "@type": "Answer", "text": "In the US, birth doula services typically range from $650 to $3,000 depending on location, experience, and what's included. The national average is around $1,200 to $1,500 for a standard birth package." } },
        { "@type": "Question", "name": "How much does a doula cost in Dallas?", "acceptedAnswer": { "@type": "Answer", "text": "In Dallas, Texas, a birth doula costs $900 to $2,800, with most packages averaging $1,400 to $1,800. Postpartum doulas in Dallas charge $30 to $50 per hour. Texas Medicaid covers doula services." } },
        { "@type": "Question", "name": "How much does a doula cost in Houston?", "acceptedAnswer": { "@type": "Answer", "text": "In Houston, Texas, a birth doula costs $1,900 to $3,000, the highest among major Texas cities. Houston's larger metro and higher cost of living drive prices up. Postpartum doulas in Houston charge $35 to $55 per hour." } },
        { "@type": "Question", "name": "How much does a doula cost in San Antonio?", "acceptedAnswer": { "@type": "Answer", "text": "In San Antonio, Texas, a birth doula costs $800 to $2,200, with the average around $1,100 to $1,500. San Antonio has more affordable doula options than Dallas or Houston. Postpartum doulas in San Antonio charge $25 to $45 per hour." } },
        { "@type": "Question", "name": "How much does a doula cost in Texas?", "acceptedAnswer": { "@type": "Answer", "text": "In Texas, a birth doula costs $800 to $2,800, with a statewide average of $1,200 to $1,800. Dallas ranges from $900 to $2,800, Houston from $1,900 to $3,000, San Antonio from $800 to $2,200, and Austin from $900 to $2,500. Texas Medicaid covers doula services." } },
        { "@type": "Question", "name": "What's included in a doula's fee?", "acceptedAnswer": { "@type": "Answer", "text": "A standard birth doula package usually includes 1-2 prenatal visits, on-call availability from 37-38 weeks, continuous labor support, and 1-2 postpartum visits. Some include additional services like birth plan help, texting support, or lactation guidance." } },
        { "@type": "Question", "name": "Does insurance cover doula costs?", "acceptedAnswer": { "@type": "Answer", "text": "Some private insurers are starting to cover doula services, particularly as part of maternal wellness benefits. Medicaid coverage for doulas is also expanding in many states. In practice, results vary widely. Some families have successfully requested in-network exceptions from their insurance provider for doula care, though outcomes can depend on which representative you speak to. If the first answer is no, call back and ask again. You'll need to check directly with your plan." } },
        { "@type": "Question", "name": "Why do doulas cost so much?", "acceptedAnswer": { "@type": "Answer", "text": "Birth doulas are on-call for weeks, often leaving their own lives on hold. A standard package represents 30-50+ hours of work across prenatal visits, the birth itself (which can be 12-24+ hours), and postpartum visits. When you break it down hourly, the cost is often comparable to other professional support services." } },
        { "@type": "Question", "name": "Are there low-cost or free doula options?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Many communities have volunteer doula programs, and some doulas offer sliding-scale fees or payment plans. If cost is a barrier, look into local doula collectives or ask about reduced-rate packages. Some hospital-based doula programs operate with grant funding or donations, which can bring your out-of-pocket cost down significantly. It's always worth asking a doula you love whether they offer a sliding scale, even if they don't advertise one." } },
        { "@type": "Question", "name": "Is a doula worth the cost?", "acceptedAnswer": { "@type": "Answer", "text": "Research consistently shows that continuous doula support leads to shorter labors, fewer interventions, and higher satisfaction with the birth experience. For many families, the investment pays off in confidence and outcomes. While no one can guarantee how a birth will unfold, many mothers describe that pivotal moment in labor when their doula was the calm, steady presence that helped them feel heard and in control. The support a doula provides can be the difference between feeling overwhelmed and feeling empowered." } },
        { "@type": "Question", "name": "What is the average cost of a doula?", "acceptedAnswer": { "@type": "Answer", "text": "The national average cost of a doula for a birth package is around $1,200 to $1,500. In major metropolitan areas, the average is higher, often $1,800 to $2,500. In smaller cities and rural areas, the average is closer to $800 to $1,200." } },
        { "@type": "Question", "name": "How much does a postpartum doula cost?", "acceptedAnswer": { "@type": "Answer", "text": "Postpartum doulas typically charge $25 to $50 per hour with a four-hour minimum per visit. A typical postpartum doula package runs $400 to $1,200 depending on how many visits and hours you need. Night doulas cost more, typically $35 to $75 per hour." } },
        { "@type": "Question", "name": "What are typical doula rates per hour?", "acceptedAnswer": { "@type": "Answer", "text": "When broken down hourly, birth doula rates typically work out to $25 to $50 per hour when you factor in the full package of prenatal visits, on-call time, labor, and postpartum visits. Postpartum doula rates are $25 to $50 per hour, and night doulas charge $35 to $75 per hour." } },
        { "@type": "Question", "name": "Are doulas worth the money?", "acceptedAnswer": { "@type": "Answer", "text": "Research shows that doula support leads to 39% fewer C-sections, shorter labors, and higher satisfaction with the birth experience. For many families, the cost is justified by improved outcomes and reduced need for medical interventions, which can carry their own costs." } },
        { "@type": "Question", "name": "How much does it cost to hire a doula?", "acceptedAnswer": { "@type": "Answer", "text": "Hiring a birth doula typically costs $650 to $3,000 for a full package. Hiring a postpartum doula costs $25 to $50 per hour. Some doulas offer sliding-scale fees, payment plans, or reduced rates for students completing their certification." } }
      ]
    }
  ]
};
---

<Layout
  title="How Much Is a Doula? Costs With & Without Insurance (2026)"
  description="How much is a doula? Birth doula prices run $650 to $3,000, averaging $1,200 to $1,500. See costs with and without insurance, by city, and by type."
  canonical="https://truejoybirthing.com/doula-cost/"
  ogImage="https://truejoybirthing.com/images/og/og-doula-cost.png"
  ogType="article"
  breadcrumbList={breadcrumbList}
  schema={schema}
>

  <!-- ═══════════════════════════════════════════
       HERO, Editorial two-column, 55/45
       Author photo right, text left
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row">

        <!-- Left: Text, 55% -->
        <div class="md:w-[55%] px-6 md:px-12 py-16 md:py-24 flex flex-col justify-center">
          <p class="eyebrow mb-3">Doula costs</p>
          <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
          <h1 class="font-bold text-tjb-charcoal leading-[1.15] mb-4" style="font-size: clamp(1.75rem, 5vw, 3.75rem);">
            How Much Does a Doula Cost?
          </h1>
          <!-- Author credibility strip -->
          <div class="flex items-center gap-2.5 mb-5">
            <img src="/images/shelbi-thumb.webp" alt="Shelbi Kohler, certified birth doula" width="32" height="32" class="w-8 h-8 rounded-full object-cover" />
            <p class="text-sm text-tjb-gray leading-snug">
              <a href="/about/" class="text-tjb-lavender-600 hover:text-tjb-lavender-700 font-medium no-underline">Shelbi Kohler</a>,
              certified birth doula, 500+ families supported
            </p>
          </div>
          <p class="text-tjb-gray text-lg leading-[1.7] mb-8 max-w-[36rem]">
            <strong>A doula costs $650 to $3,000</strong> for a standard birth package, with a national average of <strong>$1,200 to $1,500</strong> in 2025. Out of pocket, most families pay the full fee themselves, but some private insurers and state Medicaid programs now cover part or all of doula care. Below you'll find doula costs with and without insurance, a city-by-city breakdown, a calculator, and ways to find affordable support, so you can budget with confidence.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/birth-plan-template/" class="btn-primary">Get the free Joyful Birth Plan</a>
            <a href="/birth-support/" class="btn-secondary">Find your city</a>
          </div>
        </div>

        <!-- Right: Photo, 45% -->
        <div class="md:w-[45%] flex items-center justify-center px-6 py-12 md:py-0">
          <img
            src="/images/hero-doula-cost.webp"
            alt="A birth doula providing hands-on support during labor, counter-pressure, encouragement, and continuous presence"
            class="w-full aspect-[3/4] object-cover rounded-2xl shadow-lg"
            width="900"
            height="1200"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PROVENANCE, Compact trust anchor
       ═══════════════════════════════════════════ -->
  <div class="bg-tjb-cream border-y border-tjb-lavender-200/40">
    <div class="max-w-3xl mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6">
      <span class="text-sm text-tjb-gray-300 tracking-wide">$650–$3,000 typical range</span>
      <span class="hidden sm:inline text-tjb-rose-400 text-sm">·</span>
      <span class="text-sm text-tjb-gray-300 tracking-wide">30–50+ hours per package</span>
      <span class="hidden sm:inline text-tjb-rose-400 text-sm">·</span>
      <span class="text-sm text-tjb-gray-300 tracking-wide">Insurance may cover part or all</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       KEY TAKEAWAYS, Quick-answer box
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream py-10">
    <div class="max-w-3xl mx-auto px-6">
      <div class="bg-white rounded-2xl border border-tjb-lavender-200/60 p-6 md:p-8">
        <h2 class="text-lg font-bold text-tjb-charcoal mb-4">Key takeaways</h2>
        <ul class="space-y-3 text-sm text-tjb-gray leading-relaxed">
          <li class="flex items-start gap-2"><span class="text-tjb-rose-500 mt-0.5">✓</span><span>Birth doula packages cost <strong>$650 to $3,000</strong> nationally, averaging <strong>$1,200 to $1,500</strong>.</span></li>
          <li class="flex items-start gap-2"><span class="text-tjb-rose-500 mt-0.5">✓</span><span>Postpartum doulas charge <strong>$25 to $50/hour</strong>; night doulas <strong>$35 to $75/hour</strong>.</span></li>
          <li class="flex items-start gap-2"><span class="text-tjb-rose-500 mt-0.5">✓</span><span>A standard package includes <strong>30 to 50+ hours</strong> of combined support across prenatal, labor, and postpartum.</span></li>
          <li class="flex items-start gap-2"><span class="text-tjb-rose-500 mt-0.5">✓</span><span>Some insurers and state Medicaid programs are beginning to cover doula services.</span></li>
          <li class="flex items-start gap-2"><span class="text-tjb-rose-500 mt-0.5">✓</span><span>Research shows doula support leads to <strong>39% fewer C-sections</strong> and shorter labors (<a href="https://www.cochranelibrary.com/cdsr/doi/10.1002/14651858.CD003766.pub5/full" class="text-tjb-rose-500 hover:underline" rel="nofollow noopener" target="_blank">Cochrane review, 26 trials</a>).</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       COST AT A GLANCE, Designed table on cream
       ═══════════════════════════════════════════ -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">

      <p class="eyebrow mb-4">Cost at a glance</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-4" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        Doula prices by region
      </h2>
      <p class="text-tjb-gray leading-relaxed mb-8">
        In the United States, <strong>doula prices</strong> typically range from <strong>$650 to $3,000</strong> for a birth package depending on where you live, the doula's experience, and what's included. The <strong>average doula cost</strong> is $1,200 to $1,500. Use this table to see how much a doula costs in your region.
      </p>

      <!-- Designed cost table -->
      <div class="not-prose">
        <div class="bg-tjb-cream rounded-md overflow-hidden">
          <div class="hidden sm:grid grid-cols-[1fr_auto] border-b-2 border-tjb-lavender-300/60">
            <div class="py-3 px-5 text-sm font-semibold text-tjb-charcoal">Region</div>
            <div class="py-3 px-5 text-sm font-semibold text-tjb-charcoal text-right">Typical Range</div>
          </div>
          <!-- Row: Major metros -->
          <div class="flex sm:grid sm:grid-cols-[1fr_auto] flex-col sm:flex-row border-b border-tjb-lavender-200/50">
            <div class="py-3 px-5 text-sm text-tjb-gray">Major metros (NYC, LA, SF)</div>
            <div class="py-1 sm:py-3 px-5 text-sm font-semibold text-tjb-charcoal sm:text-right">$1,500–$3,000</div>
          </div>
          <!-- Row: Texas cities -->
          <div class="flex sm:grid sm:grid-cols-[1fr_auto] flex-col sm:flex-row border-b border-tjb-lavender-200/50 bg-tjb-lavender-50/30">
            <div class="py-3 px-5 text-sm text-tjb-gray">Texas cities (Dallas, Houston, Austin)<br><span class="text-xs text-tjb-gray-300">Houston runs higher: $1,900–$3,000</span></div>
            <div class="py-1 sm:py-3 px-5 text-sm font-semibold text-tjb-charcoal sm:text-right">$800–$2,800</div>
          </div>
          <!-- Row: Mid-size cities -->
          <div class="flex sm:grid sm:grid-cols-[1fr_auto] flex-col sm:flex-row border-b border-tjb-lavender-200/50">
            <div class="py-3 px-5 text-sm text-tjb-gray">Mid-size cities</div>
            <div class="py-1 sm:py-3 px-5 text-sm font-semibold text-tjb-charcoal sm:text-right">$700–$2,000</div>
          </div>
          <!-- Row: Midwest -->
          <div class="flex sm:grid sm:grid-cols-[1fr_auto] flex-col sm:flex-row border-b border-tjb-lavender-200/50">
            <div class="py-3 px-5 text-sm text-tjb-gray">Midwest (Chicago, Minneapolis, Detroit)</div>
            <div class="py-1 sm:py-3 px-5 text-sm font-semibold text-tjb-charcoal sm:text-right">$900–$2,200</div>
          </div>
          <!-- Row: Pacific Northwest -->
          <div class="flex sm:grid sm:grid-cols-[1fr_auto] flex-col sm:flex-row border-b border-tjb-lavender-200/50 bg-tjb-lavender-50/30">
            <div class="py-3 px-5 text-sm text-tjb-gray">Pacific Northwest (Seattle, Portland)</div>
            <div class="py-1 sm:py-3 px-5 text-sm font-semibold text-tjb-charcoal sm:text-right">$1,000–$2,500</div>
          </div>
          <!-- Row: Southeast -->
          <div class="flex sm:grid sm:grid-cols-[1fr_auto] flex-col sm:flex-row border-b border-tjb-lavender-200/50">
            <div class="py-3 px-5 text-sm text-tjb-gray">Southeast (Atlanta, Miami, Charlotte)</div>
            <div class="py-1 sm:py-3 px-5 text-sm font-semibold text-tjb-charcoal sm:text-right">$800–$2,200</div>
          </div>
          <!-- Row: Mountain West -->
          <div class="flex sm:grid sm:grid-cols-[1fr_auto] flex-col sm:flex-row border-b border-tjb-lavender-200/50 bg-tjb-lavender-50/30">
            <div class="py-3 px-5 text-sm text-tjb-gray">Mountain West (Denver, Phoenix, Salt Lake)</div>
            <div class="py-1 sm:py-3 px-5 text-sm font-semibold text-tjb-charcoal sm:text-right">$750–$2,000</div>
          </div>
          <!-- Row: Rural -->
          <div class="flex sm:grid sm:grid-cols-[1fr_auto] flex-col sm:flex-row">
            <div class="py-3 px-5 text-sm text-tjb-gray">Smaller towns and rural areas</div>
            <div class="py-1 sm:py-3 px-5 text-sm font-semibold text-tjb-charcoal sm:text-right">$650–$1,500</div>
          </div>
        </div>
        <p class="text-xs text-tjb-gray-300 mt-3 italic">These ranges reflect 2025-2026 market rates. Costs vary by individual doula and package.</p>
      </div>

      <!-- California callout -->
      <div class="mt-6 bg-tjb-lavender-50/40 rounded-lg p-5 border border-tjb-lavender-200/50">
        <p class="text-sm text-tjb-gray leading-relaxed">
          <strong class="text-tjb-charcoal">California pricing runs higher.</strong> Birth doulas in California often cost $2,000 to $3,000, with postpartum doulas at $55 to $75 per hour. Medi-Cal now reimburses doula services statewide. <a href="/birth-support/ca/" class="text-tjb-rose-500 hover:underline font-medium">See California birth support guides →</a>
        </p>
      </div>

      <!-- ═══════════════════════════════════════════
           CITY-LEVEL COST DATA, Detailed city table
           ═══════════════════════════════════════════ -->
      <div class="mt-10">
        <h3 class="font-semibold text-tjb-charcoal text-xl mb-3">Doula Costs in Major US Cities</h3>
        <p class="text-tjb-gray leading-relaxed mb-6">
          Doula prices vary significantly by city. Here's what birth doulas typically charge in major US markets:
        </p>

        <div class="not-prose">
          <div class="bg-tjb-cream rounded-md overflow-hidden">
            <div class="hidden sm:grid grid-cols-[1.3fr_1.1fr_1fr_1.6fr] border-b-2 border-tjb-lavender-300/60">
              <div class="py-3 px-4 text-sm font-semibold text-tjb-charcoal">City</div>
              <div class="py-3 px-4 text-sm font-semibold text-tjb-charcoal text-right">Birth Doula Range</div>
              <div class="py-3 px-4 text-sm font-semibold text-tjb-charcoal text-right">Postpartum Hourly</div>
              <div class="py-3 px-4 text-sm font-semibold text-tjb-charcoal">Notes</div>
            </div>
            <!-- New York, NY -->
            <div class="flex sm:grid sm:grid-cols-[1.3fr_1.1fr_1fr_1.6fr] flex-col sm:flex-row border-b border-tjb-lavender-200/50">
              <div class="py-3 px-4 text-sm text-tjb-gray font-medium">New York, NY</div>
              <div class="py-1 sm:py-3 px-4 text-sm font-semibold text-tjb-charcoal sm:text-right">$2,000–$3,000</div>
              <div class="py-1 sm:py-3 px-4 text-sm font-semibold text-tjb-charcoal sm:text-right">$40–$55</div>
              <div class="py-1 sm:py-3 px-4 text-sm text-tjb-gray">High cost of living, strong doula community</div>
            </div>
            <!-- Los Angeles, CA -->
            <div class="flex sm:grid sm:grid-cols-[1.3fr_1.1fr_1fr_1.6fr] flex-col sm:flex-row border-b border-tjb-lavender-200/50 bg-tjb-lavender-50/30">
              <div class="py-3 px-4 text-sm text-tjb-gray font-medium">Los Angeles, CA</div>
              <div class="py-1 sm:py-3 px-4 text-sm font-semibold text-tjb-charcoal sm:text-right">$2,000–$3,000</div>
              <div class="py-1 sm:py-3 px-4 text-sm font-semibold text-tjb-charcoal sm:text-right">$55–$75</div>
              <div class="py-1 sm:py-3 px-4 text-sm text-tjb-gray">Medi-Cal doula coverage available</div>
            </div>
            <!-- Houston, TX -->
            <div class="flex sm:grid sm:grid-cols-[1.3fr_1.1fr_1fr_1.6fr] flex-col sm:flex-row border-b border-tjb-lavender-200/50">
              <div class="py-3 px-4 text-sm text-tjb-gray font-medium">Houston, TX</div>
              <div class="py-1 sm:py-3 px-4 text-sm font-semibold text-tjb-charcoal sm:text-right">$1,900–$3,000</div>
              <div class="py-1 sm:py-3 px-4 text-sm font-semibold text-tjb-charcoal sm:text-right">$35–$55</div>
              <div class="py-1 sm:py-3 px-4 text-sm text-tjb-gray">Large metro, higher than TX average</div>
            </div>
            <!-- Dallas, TX -->
            <div class="flex sm:grid sm:grid-cols-[1.3fr_1.1fr_1fr_1.6fr] flex-col sm:flex-row border-b border-tjb-lavender-200/50 bg-tjb-lavender-50/30">
              <div class="py-3 px-4 text-sm text-tjb-gray font-medium">Dallas, TX</div>
              <div class="py-1 sm:py-3 px-4 text-sm font-semibold text-tjb-charcoal sm:text-right">$900–$2,800</div>
              <div class="py-1 sm:py-3 px-4 text-sm font-semibold text-tjb-charcoal sm:text-right">$30–$50</div>
              <div class="py-1 sm:py-3 px-4 text-sm text-tjb-gray">Texas Medicaid covers doula services</div>
