      <div class="grid grid-cols-3 gap-4 mb-8">
        <div class="bg-white rounded-xl p-4 text-center border border-tjb-lavender-200/60">
          <div class="text-2xl md:text-3xl font-bold text-tjb-rose-500 mb-1">39%</div>
