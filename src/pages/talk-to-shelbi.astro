---
import Layout from '../layouts/Layout.astro';

const breadcrumbList = [{"name": "Home", "url": "https://truejoybirthing.com/"}, {"name": "Talk to Shelbi", "url": "https://truejoybirthing.com/talk-to-shelbi/"}];

const faqs = [
  {
    q: "Is talking to Shelbi free?",
    a: "Yes. The initial conversation is completely free. Shelbi will listen to your questions, point you toward the right resources, and help you figure out your next step. If a paid service like a Birth Plan Confidence Session makes sense, she'll mention it — but there's never any pressure."
  },
  {
    q: "How quickly will Shelbi respond?",
    a: "Shelbi reads every message herself and typically responds within 1-2 business days. If you reach out on a weekend, expect a reply by Monday or Tuesday."
  },
  {
    q: "Can I talk to Shelbi before I hire a doula?",
    a: "Absolutely. Many expecting moms reach out before they've decided whether they want a doula at all. Shelbi can help you understand what doula support looks like, what it costs in your area, and whether it's the right fit for your birth."
  },
  {
    q: "I'm a doula or midwife — can I talk to Shelbi about my practice?",
    a: "Yes. Shelbi works with birth professionals on practice-building, client communication, Pro Mode tools, and the Ambassador Program. Whether you're a new doula figuring out your first steps or an experienced midwife exploring TJB's professional tools, she's happy to talk."
  },
  {
    q: "What should I include in my message?",
    a: "A sentence or two about where you are in your journey — how far along you are, what you're wondering about, or what kind of support you're looking for. That's enough for Shelbi to know how she can help."
  },
  {
    q: "Is this medical advice?",
    a: "No. Shelbi is a certified birth doula, not a medical provider. She can share birth education, planning guidance, and doula support knowledge — but she'll always encourage you to talk to your care provider about medical decisions."
  }
];

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://truejoybirthing.com/talk-to-shelbi/#faq",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

const contactSchema = {
  "@type": "ContactPage",
  "@id": "https://truejoybirthing.com/talk-to-shelbi/#contactpage",
  "name": "Talk to Shelbi — True Joy Birthing",
  "description": "Reach out to Shelbi Kohler, certified birth doula and founder of True Joy Birthing. Birth education guidance, doula support questions, and practice-building help for birth professionals.",
  "url": "https://truejoybirthing.com/talk-to-shelbi/",
  "mainEntity": {
    "@type": "Person",
    "name": "Shelbi Kohler",
    "jobTitle": "Certified Birth Doula",
    "url": "https://truejoybirthing.com/about/"
  }
};
---

<Layout
  title="Talk to Shelbi"
  description="Have a question about birth planning, doula support, or your birth options? Talk to Shelbi — certified birth doula and founder of True Joy Birthing. Free, no pressure, real answers."
  canonical="https://truejoybirthing.com/talk-to-shelbi/"
  ogImage="https://truejoybirthing.com/images/og-homepage.webp"
  ogImageAlt="Talk to Shelbi — True Joy Birthing"
  breadcrumbList={breadcrumbList}
  schema={{ "@graph": [faqSchema, contactSchema] }}
>

  <!-- ═══════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream pt-16 pb-12">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="eyebrow mb-4">Talk to Shelbi</p>
          <h1 class="text-[2.2rem] md:text-[3rem] leading-[1.12] font-bold text-tjb-charcoal mb-6">
            Want to Talk to Shelbi?
          </h1>
          <p class="text-lg text-tjb-gray leading-relaxed mb-8 max-w-xl">
            Sometimes you just need to talk to someone who gets it. Whether you're an expecting mom with questions about your birth plan, a doula building your practice, or someone wondering where to start — Shelbi's here. Certified birth doula, real answers, zero pressure.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#connect" class="btn-primary text-center">
              Send Shelbi a Message
            </a>
            <a href="#faq" class="btn-secondary text-center">
              See Common Questions
            </a>
          </div>
        </div>
        <div class="relative flex justify-center md:justify-end">
          <div class="w-full max-w-sm rounded-2xl overflow-hidden shadow-xl shadow-tjb-lavender-300/40">
            <img
              src="/images/doula-teaching.webp"
              srcset="/images/responsive/doula-teaching-480w.webp 480w, /images/responsive/doula-teaching-960w.webp 960w, /images/doula-teaching.webp 1024w"
              sizes="(max-width: 480px) 480px, (max-width: 960px) 960px, 480px"
              alt="Shelbi Kohler, certified birth doula, supporting an expecting family"
              class="w-full h-auto object-cover"
              width="1024"
              height="1536"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHAT SHELBI OFFERS
       ═══════════════════════════════════════════ -->
  <section class="py-16 bg-tjb-cream-50">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="eyebrow mb-4">What Shelbi Can Help With</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
        <h2 class="text-[2.25rem] md:text-[2.75rem] leading-[1.15] max-w-2xl mx-auto">
          Real Conversations, Real Support
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-8 border border-tjb-lavender-200/50 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-tjb-lavender-100 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-tjb-lavender-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          </div>
          <h3 class="text-xl mb-3">Birth Education Guidance</h3>
          <p class="text-tjb-gray">Questions about your birth plan, your options, or what to expect? Shelbi breaks it down in plain language — no jargon, no judgment.</p>
        </div>
        <div class="bg-white rounded-xl p-8 border border-tjb-lavender-200/50 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-tjb-lavender-100 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-tjb-lavender-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </div>
          <h3 class="text-xl mb-3">Doula Support Questions</h3>
          <p class="text-tjb-gray">Wondering whether a doula is right for you? How much they cost? How to find one in your area? Shelbi walks you through it so you can decide with confidence.</p>
        </div>
        <div class="bg-white rounded-xl p-8 border border-tjb-lavender-200/50 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-tjb-lavender-100 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-tjb-lavender-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <h3 class="text-xl mb-3">For Birth Professionals</h3>
          <p class="text-tjb-gray">Building your doula practice, exploring Pro Mode tools, or curious about the Ambassador Program? Shelbi works with birth pros at every stage.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CONNECT FORM — TWO-PATH
       ═══════════════════════════════════════════ -->
  <section id="connect" class="py-20 md:py-28 bg-white border-y border-tjb-lavender-200/40">
    <div class="max-w-2xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="eyebrow mb-4">Send a Message</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
        <h2 class="text-[2.25rem] md:text-[2.75rem] leading-[1.15]">
          Let's Talk
        </h2>
        <p class="text-lg text-tjb-gray mt-4 max-w-xl mx-auto">
          Tell Shelbi what's on your mind. She reads every message herself and will get back to you within 1-2 business days.
        </p>
      </div>

      <!-- Path selector — two cards -->
      <div class="grid grid-cols-2 gap-4 mb-8" id="path-selector">
        <button type="button" id="path-mom-btn" class="path-card path-active rounded-xl p-5 border-2 text-left transition-all" data-path="mom">
          <div class="flex items-center gap-3 mb-1">
            <div class="w-8 h-8 rounded-full bg-tjb-rose-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-tjb-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/></svg>
            </div>
            <span class="text-sm font-bold text-tjb-charcoal">I'm an expecting mom</span>
          </div>
          <p class="text-xs text-tjb-gray">Birth planning, doula questions, birth options</p>
        </button>
        <button type="button" id="path-provider-btn" class="path-card rounded-xl p-5 border-2 text-left transition-all" data-path="provider">
          <div class="flex items-center gap-3 mb-1">
            <div class="w-8 h-8 rounded-full bg-tjb-lavender-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-tjb-lavender-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <span class="text-sm font-bold text-tjb-charcoal">I'm a doula or midwife</span>
          </div>
          <p class="text-xs text-tjb-gray">Practice-building, Pro Mode, ambassador program</p>
        </button>
      </div>

      <!-- Form -->
      <div class="bg-white rounded-2xl p-8 md:p-10 shadow-sm border border-tjb-lavender-200/50">
        <form id="shelbi-form" class="space-y-5">
          <input type="hidden" name="path" id="form-path" value="mom" />
          <input type="hidden" name="source" value="website" />

          <div>
            <label for="shelbi-name" class="block text-sm font-medium text-tjb-charcoal mb-1.5">Name <span class="text-tjb-rose-500">*</span></label>
            <input type="text" id="shelbi-name" name="name" class="w-full px-5 py-3.5 rounded-xl border border-tjb-lavender-200 focus:outline-none focus:border-tjb-rose-400 focus:ring-1 focus:ring-tjb-rose-400 bg-white transition-colors text-[0.9375rem]" required />
          </div>

          <div>
            <label for="shelbi-email" class="block text-sm font-medium text-tjb-charcoal mb-1.5">Email <span class="text-tjb-rose-500">*</span></label>
            <input type="email" id="shelbi-email" name="email" class="w-full px-5 py-3.5 rounded-xl border border-tjb-lavender-200 focus:outline-none focus:border-tjb-rose-400 focus:ring-1 focus:ring-tjb-rose-400 bg-white transition-colors text-[0.9375rem]" required />
          </div>

          <div>
            <label for="shelbi-phone" class="block text-sm font-medium text-tjb-charcoal mb-1.5">Phone <span class="text-tjb-gray-400 font-normal">(optional)</span></label>
            <input type="tel" id="shelbi-phone" name="phone" class="w-full px-5 py-3.5 rounded-xl border border-tjb-lavender-200 focus:outline-none focus:border-tjb-rose-400 focus:ring-1 focus:ring-tjb-rose-400 bg-white transition-colors text-[0.9375rem]" />
          </div>

          <!-- Provider-only role dropdown -->
          <div id="provider-role-field" class="hidden">
            <label for="shelbi-role" class="block text-sm font-medium text-tjb-charcoal mb-1.5">I'm a... <span class="text-tjb-rose-500">*</span></label>
            <select id="shelbi-role" name="role" class="w-full px-5 py-3.5 rounded-xl border border-tjb-lavender-200 focus:outline-none focus:border-tjb-rose-400 focus:ring-1 focus:ring-tjb-rose-400 bg-white transition-colors text-[0.9375rem]">
              <option value="">Select your role</option>
              <option value="doula">Birth Doula</option>
              <option value="postpartum-doula">Postpartum Doula</option>
              <option value="midwife">Midwife</option>
              <option value="childbirth-educator">Childbirth Educator</option>
              <option value="lactation-consultant">Lactation Consultant (IBCLC)</option>
              <option value="student">Student / In Training</option>
              <option value="other">Other Birth Professional</option>
            </select>
          </div>

          <div>
            <label for="shelbi-message" class="block text-sm font-medium text-tjb-charcoal mb-1.5">What would you like to discuss? <span class="text-tjb-rose-500">*</span></label>
            <textarea id="shelbi-message" name="message" rows="4" placeholder="A sentence or two about what's on your mind..." class="w-full px-5 py-3.5 rounded-xl border border-tjb-lavender-200 focus:outline-none focus:border-tjb-rose-400 focus:ring-1 focus:ring-tjb-rose-400 bg-white transition-colors text-[0.9375rem]" required></textarea>
          </div>

          <button type="submit" id="shelbi-submit-btn" class="btn-primary w-full text-center">
            Send Message
          </button>
          <div id="shelbi-form-status" class="hidden text-sm mt-2"></div>
          <p class="text-xs text-tjb-gray text-center mt-2">Shelbi reads every message herself. Your information is never shared.</p>
        </form>

        <!-- Success state -->
        <div id="shelbi-success" class="hidden text-center py-8">
          <div class="w-16 h-16 rounded-full bg-tjb-rose-100 flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-tjb-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <h3 class="text-2xl font-bold text-tjb-charcoal mb-3">Thank You!</h3>
          <p class="text-tjb-gray max-w-md mx-auto leading-relaxed">Your message is on its way to Shelbi. She'll be in touch soon — usually within 1-2 business days.</p>
        </div>

        <!-- Error state -->
        <div id="shelbi-error" class="hidden text-center py-8">
          <div class="w-16 h-16 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-tjb-charcoal mb-2">Something Went Wrong</h3>
          <p class="text-tjb-gray max-w-md mx-auto mb-6">We couldn't send your message right now. Please try again, or email Shelbi directly at <a href="mailto:shelbi@truejoybirthing.com" class="text-tjb-rose-500 hover:underline font-medium">shelbi@truejoybirthing.com</a>.</p>
          <button type="button" id="shelbi-retry-btn" class="btn-secondary">Try Again</button>
        </div>

        <div class="mt-8 pt-6 border-t border-tjb-lavender-200/50 text-center">
          <p class="text-tjb-gray text-sm">Prefer email? Reach out directly at <a href="mailto:shelbi@truejoybirthing.com" class="text-tjb-rose-500 hover:underline font-medium">shelbi@truejoybirthing.com</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       FAQ — Interactive Accordion
       ═══════════════════════════════════════════ -->
  <section id="faq" class="py-16 bg-tjb-cream-50 border-t border-tjb-lavender-200/50">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="eyebrow mb-4">Good to Know</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
        <h2 class="text-2xl font-bold">Frequently Asked Questions</h2>
      </div>
      <div class="space-y-3" id="shelbi-faq">
        {faqs.map((faq, i) => (
          <div class="border border-tjb-lavender-200/60 rounded-xl overflow-hidden">
            <button
              class="faq-toggle w-full text-left px-6 py-4 flex items-center justify-between gap-4 hover:bg-tjb-cream-50 transition-colors"
              aria-expanded="false"
              aria-controls={`shelbi-faq-answer-${i}`}
            >
              <h3 class="text-base font-semibold text-tjb-charcoal">{faq.q}</h3>
              <svg class="faq-chevron w-5 h-5 text-tjb-lavender-500 shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div id={`shelbi-faq-answer-${i}`} class="faq-answer px-6 pb-0 max-h-0 overflow-hidden transition-all duration-300 ease-in-out" aria-hidden="true">
              <p class="text-tjb-gray pb-4">{faq.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       KEEP READING
       ═══════════════════════════════════════════ -->
  <section class="py-16 bg-white border-t border-tjb-lavender-200/50">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-2xl font-bold mb-8 text-center">Learn More About TJB</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/about/" class="block bg-tjb-cream-50 rounded-xl p-5 border border-tjb-lavender-200 hover:border-tjb-rose-300 transition group">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-tjb-rose-500 transition">About Shelbi</h3>
          <p class="text-sm text-tjb-gray">Meet the certified birth doula behind True Joy Birthing and why she started it.</p>
        </a>
        <a href="/birth-plan-template/" class="block bg-tjb-cream-50 rounded-xl p-5 border border-tjb-lavender-200 hover:border-tjb-rose-300 transition group">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-tjb-rose-500 transition">Joyful Birth Plan</h3>
          <p class="text-sm text-tjb-gray">The free birth plan template that started it all. Build yours step by step.</p>
        </a>
        <a href="/birth-plan-confidence-session/" class="block bg-tjb-cream-50 rounded-xl p-5 border border-tjb-lavender-200 hover:border-tjb-rose-300 transition group">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-tjb-rose-500 transition">Confidence Session</h3>
          <p class="text-sm text-tjb-gray">A 60-75 minute live review of your birth plan with Shelbi. $250.</p>
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .path-card {
    border-color: theme('colors.tjb-lavender.200');
    background: white;
  }
  .path-active {
    border-color: theme('colors.tjb-rose.500');
    background: theme('colors.tjb-rose.50');
    box-shadow: 0 4px 14px -4px rgba(0,0,0,0.08);
  }
</style>

<script>
  // ── Path selector ──
  const pathMomBtn = document.getElementById('path-mom-btn') as HTMLButtonElement;
  const pathProviderBtn = document.getElementById('path-provider-btn') as HTMLButtonElement;
  const formPath = document.getElementById('form-path') as HTMLInputElement;
  const providerRoleField = document.getElementById('provider-role-field') as HTMLDivElement;
  const providerRoleSelect = document.getElementById('shelbi-role') as HTMLSelectElement;

  function selectPath(path: string) {
    if (path === 'provider') {
      pathMomBtn.classList.remove('path-active');
      pathProviderBtn.classList.add('path-active');
      formPath.value = 'provider';
      providerRoleField.classList.remove('hidden');
      providerRoleSelect.setAttribute('required', 'true');
    } else {
      pathProviderBtn.classList.remove('path-active');
      pathMomBtn.classList.add('path-active');
      formPath.value = 'mom';
      providerRoleField.classList.add('hidden');
      providerRoleSelect.removeAttribute('required');
      providerRoleSelect.value = '';
    }
  }

  pathMomBtn?.addEventListener('click', () => selectPath('mom'));
  pathProviderBtn?.addEventListener('click', () => selectPath('provider'));

  // ── Form submission ──
  const form = document.getElementById('shelbi-form') as HTMLFormElement;
  const status = document.getElementById('shelbi-form-status') as HTMLDivElement;
  const btn = document.getElementById('shelbi-submit-btn') as HTMLButtonElement;
  const successDiv = document.getElementById('shelbi-success') as HTMLDivElement;
  const errorDiv = document.getElementById('shelbi-error') as HTMLDivElement;
  const retryBtn = document.getElementById('shelbi-retry-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const body: Record<string, string> = {};
    formData.forEach((value, key) => {
      body[key] = value.toString();
    });

    // If provider path but no role selected, show inline error
    if (body.path === 'provider' && !body.role) {
      status.textContent = 'Please select your role.';
      status.className = 'text-sm mt-2 text-red-600';
      status.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Sending...';
    status.className = 'hidden text-sm mt-2';
    status.textContent = '';

    try {
      const res = await fetch('https://truejoybirthing-app.up.railway.app/api/shelbi-leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        form.classList.add('hidden');
        document.querySelector('#path-selector')?.classList.add('hidden');
        successDiv.classList.remove('hidden');
        form.reset();
      } else {
        form.classList.add('hidden');
        document.querySelector('#path-selector')?.classList.add('hidden');
        errorDiv.classList.remove('hidden');
      }
    } catch {
      form.classList.add('hidden');
      document.querySelector('#path-selector')?.classList.add('hidden');
      errorDiv.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Message';
    }
  });

  // ── Retry button ──
  retryBtn?.addEventListener('click', () => {
    errorDiv.classList.add('hidden');
    form.classList.remove('hidden');
    document.querySelector('#path-selector')?.classList.remove('hidden');
    // Restore path state
    selectPath(formPath.value);
  });

  // ── FAQ Accordion ──
  document.querySelectorAll('.faq-toggle').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      const answer = document.getElementById(toggle.getAttribute('aria-controls')!);
      const chevron = toggle.querySelector('.faq-chevron');

      document.querySelectorAll('.faq-toggle').forEach((t) => {
        if (t !== toggle && t.getAttribute('aria-expanded') === 'true') {
          t.setAttribute('aria-expanded', 'false');
          const a = document.getElementById(t.getAttribute('aria-controls')!);
          if (a) {
            a.setAttribute('aria-hidden', 'true');
            a.style.maxHeight = '0';
            a.style.paddingBottom = '0';
          }
          const c = t.querySelector('.faq-chevron');
          if (c) c.classList.remove('rotate-180');
        }
      });

      if (isOpen) {
        toggle.setAttribute('aria-expanded', 'false');
        answer?.setAttribute('aria-hidden', 'true');
        if (answer) {
          answer.style.maxHeight = '0';
          answer.style.paddingBottom = '0';
        }
        chevron?.classList.remove('rotate-180');
      } else {
        toggle.setAttribute('aria-expanded', 'true');
        answer?.setAttribute('aria-hidden', 'false');
        if (answer) {
          answer.style.maxHeight = answer.scrollHeight + 'px';
          answer.style.paddingBottom = '1rem';
        }
        chevron?.classList.add('rotate-180');
      }
    });
  });
</script>