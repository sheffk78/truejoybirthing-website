---
import Layout from '../layouts/Layout.astro';

const breadcrumbList = [{"name": "Home", "url": "https://truejoybirthing.com/"}, {"name": "Terms of Use", "url": "https://truejoybirthing.com/terms/"}];
---

<Layout
  title="Terms of Use"
  description="Terms of Use for True Joy Birthing — our birth plan app, free templates, True Joy Pro subscription, and paid Birth Plan Confidence Session."
  canonical="https://truejoybirthing.com/terms/"
  breadcrumbList={breadcrumbList}
  schema={{
    "@graph": [{
      "@type": "WebPage",
      "name": "Terms of Use",
      "description": "Terms of Use for True Joy Birthing products and services.",
      "url": "https://truejoybirthing.com/terms"
    }]
  }}>
  <!-- Hero -->
  <section class="bg-tjb-cream pt-16 pb-12">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">Terms of Use</h1>
      <p class="text-lg text-tjb-gray">Last updated: July 2026</p>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-6 space-y-8">

      <p class="text-tjb-gray leading-relaxed">By using True Joy Birthing products and services, you agree to these terms. If you do not agree, do not use our services.</p>

      <!-- 1. Definitions -->
      <div class="bg-tjb-cream-50 rounded-xl p-6 border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">1. Definitions</h2>
        <p class="text-tjb-gray leading-relaxed">"True Joy Birthing," "we," "us," and "our" refer to Agentic Trust. "You" and "your" refer to the user of our app, website, and services. "Services" refers to our birth plan app, birth plan PDF templates, the Birth Plan Confidence Session, blog content, city guides, and True Joy Pro (Pro Mode), our paid subscription for birth professionals (doulas and midwives) available via in-app purchase through the Apple App Store and Google Play.</p>
      </div>

      <!-- 2. Eligibility -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">2. Eligibility</h2>
        <p class="text-tjb-gray leading-relaxed">You must be at least 18 years old to use our Services. By using our Services, you represent and warrant that you meet this age requirement.</p>
      </div>

      <!-- 3. Not Medical Advice -->
      <div class="bg-tjb-rose-50 rounded-xl p-6 border border-tjb-rose-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">3. Not Medical Advice</h2>
        <p class="text-tjb-gray leading-relaxed">True Joy Birthing provides educational tools and information. We are not a substitute for professional medical care. Always consult your healthcare provider for medical advice, diagnosis, or treatment. Do not disregard professional medical advice or delay seeking it because of something you read in our app or on our website.</p>
      </div>

      <!-- 4. Birth Plan Confidence Session -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-tjb-charcoal">4. Birth Plan Confidence Session</h2>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <h3 class="font-semibold text-lg mb-2">4.1 Session Description</h3>
          <p class="text-tjb-gray leading-relaxed">The Birth Plan Confidence Session is a one-on-one coaching session with a True Joy Birthing educator. During the session, we review your birth plan, discuss your preferences, and help you build confidence for your upcoming birth.</p>
        </div>

        <div class="bg-tjb-cream-50 rounded-xl p-6 border border-tjb-lavender-200/50">
          <h3 class="font-semibold text-lg mb-2">4.2 Price and Payment</h3>
          <p class="text-tjb-gray leading-relaxed">The Birth Plan Confidence Session costs $250 as a one-time payment, processed securely through Stripe. Payment is due at the time of booking to confirm your session.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <h3 class="font-semibold text-lg mb-2">4.3 Cancellation and Refund Policy</h3>
          <p class="text-tjb-gray leading-relaxed">You may cancel your session up to 48 hours before the scheduled start time for a full refund. Cancellations made less than 48 hours before the session are non-refundable. To cancel or request a refund, contact us at support@truejoybirthing.com.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <h3 class="font-semibold text-lg mb-2">4.4 Rescheduling</h3>
          <p class="text-tjb-gray leading-relaxed">You may reschedule your session at no cost if you provide at least 48 hours' notice. To reschedule, contact us at support@truejoybirthing.com.</p>
        </div>

        <div class="bg-tjb-cream-50 rounded-xl p-6 border border-tjb-lavender-200/50">
          <h3 class="font-semibold text-lg mb-2">4.5 What the Session Includes</h3>
          <p class="text-tjb-gray leading-relaxed">The Birth Plan Confidence Session includes a birth plan review, preferences discussion, and confidence building. The session does not include medical advice, medical diagnosis, or any guarantee of birth outcomes. We are educators, not medical providers.</p>
        </div>
      </div>

      <!-- 5. birth plan app -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">5. birth plan app</h2>
        <p class="text-tjb-gray leading-relaxed">Our birth plan app is free to download and use. You may use it to create, edit, and save birth plans for your personal use. You are responsible for the content you enter into the app.</p>
      </div>

      <!-- 6. Free PDF Templates -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">6. Free PDF Templates</h2>
        <p class="text-tjb-gray leading-relaxed">We offer birth plan PDF templates for personal use. You may download and print these templates for your own use. You may not redistribute, resell, or modify the templates for commercial purposes. The templates are educational tools and must not be used as a substitute for medical advice or professional care.</p>
      </div>

      <!-- 7. True Joy Pro Subscription -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-tjb-charcoal">7. True Joy Pro Subscription</h2>

        <div class="bg-tjb-cream-50 rounded-xl p-6 border border-tjb-lavender-200/50">
          <h3 class="font-semibold text-lg mb-2">7.1 Plan and Pricing</h3>
          <p class="text-tjb-gray leading-relaxed">True Joy Pro is our paid subscription for birth professionals (doulas and midwives). The plan is priced at $29.99/month or $274.99/year, available via in-app purchase through the Apple App Store and Google Play.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <h3 class="font-semibold text-lg mb-2">7.2 Free Trial</h3>
          <p class="text-tjb-gray leading-relaxed">A 14-day free trial is available for new subscribers. If you do not cancel before the trial ends, your subscription automatically converts to a paid subscription at the applicable monthly or annual rate.</p>
        </div>

        <div class="bg-tjb-cream-50 rounded-xl p-6 border border-tjb-lavender-200/50">
          <h3 class="font-semibold text-lg mb-2">7.3 Auto-Renewal</h3>
          <p class="text-tjb-gray leading-relaxed">Subscriptions automatically renew at the end of each billing cycle unless cancelled before the renewal date. Your Apple App Store or Google Play account will be charged for each renewal.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <h3 class="font-semibold text-lg mb-2">7.4 Cancellation</h3>
          <p class="text-tjb-gray leading-relaxed">You may cancel your subscription at any time through your Apple App Store or Google Play account settings. Cancellation takes effect at the end of the current billing period; you retain access to Pro features until then.</p>
        </div>

        <div class="bg-tjb-cream-50 rounded-xl p-6 border border-tjb-lavender-200/50">
          <h3 class="font-semibold text-lg mb-2">7.5 Refunds</h3>
          <p class="text-tjb-gray leading-relaxed">Subscription refunds are handled by the Apple App Store and Google Play according to their respective refund policies. We do not issue subscription refunds directly. For refund requests, contact Apple or Google support through your account settings.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
          <h3 class="font-semibold text-lg mb-2">7.6 Pro Features</h3>
          <p class="text-tjb-gray leading-relaxed">True Joy Pro includes client management, visit notes, scheduling, invoicing, and professional birth plan tools. Features may be added, modified, or removed at our discretion during your subscription term.</p>
        </div>
      </div>

      <!-- 8. Your Content -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">8. Your Content</h2>
        <p class="text-tjb-gray leading-relaxed">You own the birth plan data, preferences, and notes you create using our Services. By using our Services, you grant True Joy Birthing a limited, non-exclusive license to process your content solely as necessary to provide and improve the Services to you. We will not sell your content to third parties.</p>
      </div>

      <!-- 9. User Accounts -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">9. User Accounts</h2>
        <p class="text-tjb-gray leading-relaxed">You are responsible for maintaining the confidentiality of your account credentials. You agree to notify us immediately of any unauthorized use of your account.</p>
      </div>

      <!-- 10. Acceptable Use -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">10. Acceptable Use</h2>
        <p class="text-tjb-gray leading-relaxed">You agree not to misuse our services, including but not limited to: attempting to gain unauthorized access, using the service for illegal purposes, or interfering with the service's operation.</p>
      </div>

      <!-- 11. Intellectual Property -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">11. Intellectual Property</h2>
        <p class="text-tjb-gray leading-relaxed">All content, features, and functionality of True Joy Birthing — including but not limited to text, graphics, logos, and software — are owned by Agentic Trust and are protected by copyright, trademark, and other intellectual property laws.</p>
      </div>

      <!-- 12. Warranty Disclaimer -->
      <div class="bg-tjb-rose-50 rounded-xl p-6 border border-tjb-rose-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">12. Warranty Disclaimer</h2>
        <p class="text-tjb-gray leading-relaxed">THE SERVICES ARE PROVIDED "AS IS" AND "AS AVAILABLE," WITHOUT WARRANTIES OF ANY KIND, WHETHER EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO IMPLIED WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND NON-INFRINGEMENT.</p>
      </div>

      <!-- 13. Limitation of Liability -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">13. Limitation of Liability</h2>
        <p class="text-tjb-gray leading-relaxed">To the maximum extent permitted by law, Agentic Trust shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising from your use of our services. In no event shall our total aggregate liability exceed the amount you paid us in the twelve (12) months preceding the claim.</p>
      </div>

      <!-- 14. Indemnification -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">14. Indemnification</h2>
        <p class="text-tjb-gray leading-relaxed">You agree to indemnify and hold harmless Agentic Trust and its affiliates from any claims, damages, losses, or expenses (including reasonable attorneys' fees) arising from your use of the Services or your violation of these terms.</p>
      </div>

      <!-- 15. Governing Law -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">15. Governing Law</h2>
        <p class="text-tjb-gray leading-relaxed">These terms are governed by the laws of the State of Utah, without regard to conflict of law principles.</p>
      </div>

      <!-- 16. Severability -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">16. Severability</h2>
        <p class="text-tjb-gray leading-relaxed">If any provision of these terms is found to be unenforceable or invalid, that provision will be limited or eliminated to the minimum extent necessary, and the remaining provisions will remain in full force and effect.</p>
      </div>

      <!-- 17. Force Majeure -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">17. Force Majeure</h2>
        <p class="text-tjb-gray leading-relaxed">We shall not be liable for any failure or delay in performance caused by events beyond our reasonable control, including but not limited to natural disasters, acts of God, war, terrorism, pandemics, government actions, or failures of third-party service providers.</p>
      </div>

      <!-- 18. Assignment -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">18. Assignment</h2>
        <p class="text-tjb-gray leading-relaxed">You may not assign or transfer these terms or your rights under them without our prior written consent. We may assign these terms freely in connection with a merger, acquisition, or sale of assets.</p>
      </div>

      <!-- 19. Entire Agreement -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">19. Entire Agreement</h2>
        <p class="text-tjb-gray leading-relaxed">These terms, together with our Privacy Policy, constitute the entire agreement between you and True Joy Birthing regarding your use of our Services and supersede all prior or contemporaneous understandings.</p>
      </div>

      <!-- 20. Changes to Terms -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">20. Changes to Terms</h2>
        <p class="text-tjb-gray leading-relaxed">We may update these terms from time to time. We will notify you of material changes by posting the updated terms on this page with a revised "Last updated" date. Your continued use of the service after changes are posted constitutes your acceptance of the updated terms.</p>
      </div>

      <!-- 21. Contact -->
      <div class="bg-white rounded-xl p-6 shadow-sm border border-tjb-lavender-200/50">
        <h2 class="text-xl font-bold text-tjb-charcoal mb-3">21. Contact</h2>
        <p class="text-tjb-gray leading-relaxed">For questions about these terms, contact us at <a href="mailto:support@truejoybirthing.com" class="text-tjb-rose-500 hover:text-tjb-charcoal underline underline-offset-3 transition-colors">support@truejoybirthing.com</a>.</p>
        <div class="mt-3 text-sm text-tjb-gray">
          <p>Agentic Trust</p>
          <p>217 6th Ave N STE 43363, Nashville, TN 37219</p>
        </div>
      </div>

      <!-- Related links -->
      <div class="pt-8 border-t border-tjb-lavender-200/50 text-center">
        <p class="text-tjb-gray mb-4">Related: <a href="/privacy/" class="text-tjb-rose-500 hover:text-tjb-charcoal underline underline-offset-3 transition-colors font-semibold">Privacy Policy</a></p>
        <a href="/" class="btn-primary">Back to Home →</a>
      </div>

    </div>
  </section>
</Layout>