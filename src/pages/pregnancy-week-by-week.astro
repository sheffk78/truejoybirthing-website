---
// Pregnancy Week by Week — Hub page
// Timeline of all 37 weeks (4–40), organized by trimester, with due date calculator.
import Layout from '../layouts/Layout.astro';
import DueDateCalculator from '../components/DueDateCalculator.astro';
import { PREGNANCY_WEEKS, TRIMESTERS } from '../data/pregnancy-weeks.ts';

const SITE = 'https://truejoybirthing.com';
const pageUrl = `${SITE}/pregnancy-week-by-week/`;

const breadcrumbList = [
  { name: 'Home', url: `${SITE}/` },
  { name: 'Pregnancy Week by Week', url: pageUrl },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${pageUrl}#itemlist`,
  name: 'Pregnancy Week by Week: Baby Growth & Development Guide',
  description: 'A week-by-week guide to pregnancy from week 4 to week 40 — how your baby grows, what happens in your body, and encouragement from a certified doula.',
  numberOfItems: PREGNANCY_WEEKS.length,
  itemListElement: PREGNANCY_WEEKS.map((w, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${w.week} Weeks Pregnant`,
    url: `${SITE}/pregnancy/${w.slug}/`,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How many weeks is a full-term pregnancy?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "A full-term pregnancy lasts about 40 weeks from the first day of your last menstrual period. Babies born between 37 and 42 weeks are considered term, with 39–40 weeks being ideal for most births.",
      },
    },
    {
      '@type': 'Question',
      name: 'What weeks are in each trimester?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The first trimester runs through week 12, the second trimester covers weeks 13 through 26, and the third trimester runs from week 27 until birth.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I calculate my due date?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The most common method counts 280 days (40 weeks) from the first day of your last menstrual period. Use our free due date calculator on this page — you can enter either your LMP or a due date from your provider and see exactly where you are week by week.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is it normal for symptoms to differ week to week?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Absolutely. Every pregnancy is different, and even the same person can feel completely different from one week to the next. These guides describe what's typical, not what's required — always check in with your provider if something feels off.",
      },
    },
  ],
};
---

<Layout
  title="Pregnancy Week by Week: Baby Growth & Development Guide"
  description="Follow your baby's growth from week 4 to week 40. See how big baby is each week, what's happening in your body, and encouragement from a certified doula and mother of seven."
  canonical={pageUrl}
  ogImage={`${SITE}/images/pregnancy-series/pregnancy-week-30-approved.webp`}
  ogImageAlt="Pregnancy week 30 — baby development illustration"
  breadcrumbList={breadcrumbList}
  schema={[itemListSchema, faqSchema]}
>

  <!-- ═══════════════════════════════════════════
       HERO — Two-column: text left, illustration right
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream">
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-24">
      <div class="flex flex-col md:flex-row gap-12 items-center">
        <!-- Left: text (55%) -->
        <div class="md:w-[55%]">
          <p class="eyebrow mb-3">Pregnancy Week by Week</p>
          <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
          <h1 class="font-bold text-tjb-charcoal leading-[1.15] mb-4" style="font-size: clamp(2.25rem, 5vw, 3.75rem);">
            Pregnancy Week by Week: Baby Growth &amp; Development Guide
          </h1>
          <!-- Author credibility strip -->
          <div class="flex items-center gap-2.5 mb-5">
            <img src="/images/shelbi-thumb.webp" alt="Shelbi Kohler, certified birth doula" width="32" height="32" class="w-8 h-8 rounded-full object-cover" />
            <p class="text-sm text-tjb-gray leading-snug">
              <a href="/about/" class="text-tjb-lavender-600 hover:text-tjb-lavender-700 font-medium no-underline">Shelbi Kohler</a>,
              certified birth doula &amp; mother of seven
            </p>
          </div>
          <p class="text-tjb-gray text-lg leading-[1.7] max-w-[38rem]">
            Every week of pregnancy brings something new — a beating heart, tiny fingers, hiccups you can feel from the outside.
            Pick your week below and see what's happening with your baby, what your body is doing, and a little encouragement
            from someone who's been through it seven times.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#timeline" class="btn-primary">Jump to your week ↓</a>
            <a href="/birth-plan-template/" class="btn-secondary">Get the free birth plan template</a>
          </div>
        </div>
        <!-- Right: illustration (45%) -->
        <div class="md:w-[45%] flex justify-center">
          <img
            src="/images/pregnancy-series/pregnancy-week-30-approved.webp"
            alt="Pregnancy illustration at 30 weeks — baby in the womb"
            class="w-full max-w-md rounded-2xl shadow-sm"
            width="600"
            height="600"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       DUE DATE CALCULATOR
       ═══════════════════════════════════════════ -->
  <section class="bg-white py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-6">
      <DueDateCalculator />
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       INTERACTIVE WEEK SLIDER — scrub through weeks 4-40
       ═══════════════════════════════════════════ -->
  <section id="slider" class="bg-tjb-lavender-100/50 py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-6">
      <p class="eyebrow mb-4 text-center">Explore your pregnancy</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6 mx-auto"></div>
      <h2 class="text-center font-semibold text-tjb-charcoal leading-[1.15] mb-4" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        Slide through every week
      </h2>
      <p class="text-center text-tjb-gray text-lg leading-relaxed mb-10 max-w-2xl mx-auto">
        Drag the slider to watch your baby grow from a poppy seed to a full newborn — 4 weeks to 40.
      </p>

      <!-- Slider preview card -->
      <div class="bg-white rounded-3xl shadow-lg border border-tjb-lavender-200 overflow-hidden">
        <div class="grid md:grid-cols-2 gap-0 items-center">
          <!-- Left: illustration -->
          <div class="bg-tjb-lavender-100 flex items-center justify-center p-8 md:p-12">
            <img
              id="slider-image"
              src="/images/pregnancy-series/pregnancy-week-04-approved.webp"
              alt="Week 4 pregnancy illustration"
              class="w-full max-w-xs rounded-2xl shadow-sm transition-opacity duration-200"
              width="400"
              height="400"
            />
          </div>
          <!-- Right: info -->
          <div class="p-8 md:p-10 text-center md:text-left">
            <span class="inline-block text-xs font-bold uppercase tracking-wide text-tjb-rose-500 mb-2" id="slider-trimester-label">First Trimester</span>
            <h3 class="font-bold text-tjb-charcoal mb-2" style="font-size: clamp(2rem, 4vw, 3rem);">
              <span id="slider-week">4</span> <span class="text-tjb-gray/40 font-normal">weeks</span>
            </h3>
            <p class="text-lg font-semibold text-tjb-charcoal mb-3" id="slider-baby-title">As small as a poppy seed</p>
            <p class="text-tjb-gray leading-relaxed mb-4" id="slider-baby-desc">Your baby is still tiny — the embryo is now fully implanted in the uterus and the amniotic sac is beginning to form.</p>
            <div class="flex flex-wrap gap-2 justify-center md:justify-start">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-tjb-lavender-100 text-sm font-medium text-tjb-lavender-700" id="slider-size-badge">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>
                <span id="slider-size">~1mm</span>
              </span>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-tjb-rose-100 text-sm font-medium text-tjb-rose-600" id="slider-food-badge" style="display:none;">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M3 3a1 1 0 000 2h11.5a.5.5 0 01.5.5V11a1 1 0 102 0V5.5A2.5 2.5 0 0014.5 3H3z"/><path d="M3 7a1 1 0 011-1h8a1 1 0 010 2H4a1 1 0 01-1-1zM3 11a1 1 0 011-1h6a1 1 0 010 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h10a1 1 0 010 2H4a1 1 0 01-1-1z"/></svg>
                <span id="slider-food">poppy seed</span>
              </span>
            </div>
            <a id="slider-cta" href="/pregnancy/4-weeks-pregnant/" class="inline-block mt-5 btn-primary text-sm">
              See full week 4 guide →
            </a>
          </div>
        </div>
      </div>

      <!-- Slider control -->
      <div class="mt-8 px-2 md:px-4">
        <div class="flex items-center justify-between text-sm font-semibold text-tjb-gray/60 mb-2">
          <span>Week 4</span>
          <span id="slider-current-label" class="text-tjb-rose-500 font-bold">Week 4</span>
          <span>Week 40</span>
        </div>
        <input
          type="range"
          id="week-slider"
          min="4"
          max="40"
          value="4"
          step="1"
          class="w-full slider-tjb"
          aria-label="Select pregnancy week"
        />
        <!-- Trimester markers under slider -->
        <div class="relative mt-2 h-5">
          <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-1 bg-tjb-lavender-200 rounded-full"></div>
          <div id="slider-progress" class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-tjb-rose-500 rounded-full" style="width:0%"></div>
          <div class="absolute inset-x-0 flex justify-between text-[10px] font-semibold uppercase tracking-wide text-tjb-gray/40">
            <span class="relative z-10 bg-tjb-lavender-100/50 px-1" style="margin-left:0%">T1</span>
            <span class="relative z-10 bg-tjb-lavender-100/50 px-1" style="margin-left:24%">T2</span>
            <span class="relative z-10 bg-tjb-lavender-100/50 px-1" style="margin-right:0%">T3</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Week data for slider (injected as JSON) -->
  <script id="pregnancy-slider-data" type="application/json" set:html={JSON.stringify(PREGNANCY_WEEKS.map(w => ({
    week: w.week,
    trimester: w.trimester,
    slug: w.slug,
    babyTitle: w.babyTitle,
    babyDescription: w.babyDescription,
    imageName: w.imageName,
    food: w.food,
    sizeNote: w.sizeNote,
  })))} />

  <style>
    .slider-tjb {
      -webkit-appearance: none;
      appearance: none;
      height: 8px;
      border-radius: 9999px;
      background: linear-gradient(to right, #f3e8ff 0%, #fce7f3 100%);
      outline: none;
      cursor: pointer;
    }
    .slider-tjb::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #e11d63;
      border: 4px solid #fff;
      box-shadow: 0 2px 6px rgba(225, 29, 99, 0.4);
      cursor: grab;
      transition: transform 0.15s;
    }
    .slider-tjb::-webkit-slider-thumb:hover {
      transform: scale(1.15);
    }
    .slider-tjb::-webkit-slider-thumb:active {
      cursor: grabbing;
      transform: scale(1.1);
    }
    .slider-tjb::-moz-range-thumb {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #e11d63;
      border: 4px solid #fff;
      box-shadow: 0 2px 6px rgba(225, 29, 99, 0.4);
      cursor: grab;
    }
    .slider-tjb::-moz-range-track {
      height: 8px;
      border-radius: 9999px;
    }
    @media (prefers-reduced-motion: reduce) {
      .slider-tjb::-webkit-slider-thumb { transition: none; }
    }
  </style>

  <script type="module">
    // ═══════════════════════════════════════════
    // INTERACTIVE WEEK SLIDER
    // ═══════════════════════════════════════════
    const dataEl = document.getElementById('pregnancy-slider-data');
    const weeks = JSON.parse(dataEl?.textContent || '[]');

    const slider = document.getElementById('week-slider');
    const sliderImg = document.getElementById('slider-image');
    const sliderWeek = document.getElementById('slider-week');
    const sliderBabyTitle = document.getElementById('slider-baby-title');
    const sliderBabyDesc = document.getElementById('slider-baby-desc');
    const sliderSize = document.getElementById('slider-size');
    const sliderFood = document.getElementById('slider-food');
    const sliderFoodBadge = document.getElementById('slider-food-badge');
    const sliderCta = document.getElementById('slider-cta');
    const sliderLabel = document.getElementById('slider-current-label');
    const sliderProgress = document.getElementById('slider-progress');
    const sliderTrimester = document.getElementById('slider-trimester-label');

    const trimesterLabels = { first: 'First Trimester', second: 'Second Trimester', third: 'Third Trimester' };

    function updateSlider(weekNum) {
      const w = weeks.find(x => x.week === weekNum);
      if (!w) return;

      // Fade image transition
      sliderImg.style.opacity = '0.4';
      const newImg = new Image();
      newImg.onload = () => {
        sliderImg.src = newImg.src;
        sliderImg.alt = `Week ${w.week} pregnancy illustration — ${w.babyTitle}`;
        sliderImg.style.opacity = '1';
      };
      newImg.src = `/images/pregnancy-series/${w.imageName}`;

      // Update text
      sliderWeek.textContent = w.week;
      sliderBabyTitle.textContent = w.babyTitle;
      sliderBabyDesc.textContent = w.babyDescription;
      sliderSize.textContent = w.sizeNote || '';

      if (w.food) {
        sliderFood.textContent = w.food;
        sliderFoodBadge.style.display = 'inline-flex';
      } else {
        sliderFoodBadge.style.display = 'none';
      }

      sliderCta.href = `/pregnancy/${w.slug}/`;
      sliderCta.textContent = `See full week ${w.week} guide →`;
      sliderLabel.textContent = `Week ${w.week}`;
      sliderTrimester.textContent = trimesterLabels[w.trimester] || '';

      // Progress bar (0% at week 4, 100% at week 40)
      const pct = ((w.week - 4) / (40 - 4)) * 100;
      sliderProgress.style.width = pct + '%';
    }

    if (slider) {
      slider.addEventListener('input', (e) => {
        updateSlider(parseInt(e.target.value));
      });
      // Initialize
      updateSlider(4);
    }
  </script>

  <!-- ═══════════════════════════════════════════
       WEEK-BY-WEEK TIMELINE BY TRIMESTER
       ═══════════════════════════════════════════ -->
  <section id="timeline" class="bg-tjb-cream py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-6 md:px-12">

      <p class="eyebrow mb-4">Your week-by-week timeline</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-4" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        All 37 weeks, organized by trimester
      </h2>
      <p class="text-tjb-gray text-lg leading-relaxed mb-12 max-w-[42rem]">
        Tap any week to see how big your baby is, what's developing, what your body might be feeling, and a note from Shelbi.
      </p>

      {TRIMESTERS.map((trimester) => {
        const weeks = PREGNANCY_WEEKS.filter((w) => w.trimester === trimester.id);
        return (
          <div class="mb-16 last:mb-0" id={trimester.slug}>
            <!-- Trimester header -->
            <div class="flex items-baseline gap-4 mb-2">
              <h3 class="text-2xl font-semibold text-tjb-charcoal">{trimester.name}</h3>
              <span class="text-sm font-medium text-tjb-lavender-600">{trimester.weeks}</span>
            </div>
            <p class="text-tjb-gray leading-relaxed mb-8 max-w-[46rem]">{trimester.description}</p>

            <!-- Week card grid — all cards visible, no horizontal scroll -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5">
              {weeks.map((week) => (
                <a
                  href={`/pregnancy/${week.slug}/`}
                  class="group bg-white rounded-xl overflow-hidden border border-tjb-lavender-200/50 shadow-sm hover:shadow-md hover:border-tjb-rose-300 transition-all no-underline"
                >
                  <div class="aspect-square bg-tjb-lavender-100 overflow-hidden">
                    <img
                      src={`/images/pregnancy-series/${week.imageName}`}
                      alt={`Week ${week.week} pregnancy illustration — ${week.babyTitle}`}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                      width="400"
                      height="400"
                    />
                  </div>
                  <div class="p-4">
                    <span class="inline-block text-xs font-bold uppercase tracking-wide text-tjb-rose-500 mb-1">Week {week.week}</span>
                    <h4 class="text-sm font-semibold text-tjb-charcoal leading-snug group-hover:text-tjb-rose-600 transition-colors">{week.babyTitle}</h4>
                    <span class="mt-2 inline-block text-xs text-tjb-lavender-600 font-medium group-hover:text-tjb-rose-500 transition-colors">See week {week.week} →</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       FAQ
       ═══════════════════════════════════════════ -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">
      <p class="eyebrow mb-4">Common questions</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mb-6"></div>
      <h2 class="font-semibold text-tjb-charcoal leading-[1.15] mb-10" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        Week-by-week basics
      </h2>
      <div class="space-y-4">
        <details class="group bg-tjb-cream rounded-xl border border-tjb-lavender-200/50 open:shadow-md transition-shadow">
          <summary class="cursor-pointer list-none p-5 font-semibold text-tjb-charcoal flex items-center justify-between gap-4">
            How many weeks is a full-term pregnancy?
            <span class="text-tjb-rose-500 group-open:rotate-45 transition-transform text-xl leading-none shrink-0">+</span>
          </summary>
          <p class="px-5 pb-5 text-tjb-gray leading-relaxed">A full-term pregnancy lasts about 40 weeks from the first day of your last menstrual period. Babies born between 37 and 42 weeks are considered term, with 39–40 weeks being ideal for most births.</p>
        </details>
        <details class="group bg-tjb-cream rounded-xl border border-tjb-lavender-200/50 open:shadow-md transition-shadow">
          <summary class="cursor-pointer list-none p-5 font-semibold text-tjb-charcoal flex items-center justify-between gap-4">
            What weeks are in each trimester?
            <span class="text-tjb-rose-500 group-open:rotate-45 transition-transform text-xl leading-none shrink-0">+</span>
          </summary>
          <p class="px-5 pb-5 text-tjb-gray leading-relaxed">The first trimester runs through week 12, the second trimester covers weeks 13 through 26, and the third trimester runs from week 27 until birth.</p>
        </details>
        <details class="group bg-tjb-cream rounded-xl border border-tjb-lavender-200/50 open:shadow-md transition-shadow">
          <summary class="cursor-pointer list-none p-5 font-semibold text-tjb-charcoal flex items-center justify-between gap-4">
            How do I calculate my due date?
            <span class="text-tjb-rose-500 group-open:rotate-45 transition-transform text-xl leading-none shrink-0">+</span>
          </summary>
          <p class="px-5 pb-5 text-tjb-gray leading-relaxed">The most common method counts 280 days (40 weeks) from the first day of your last menstrual period. Use our free due date calculator above — enter your LMP or your provider's due date and see exactly where you are week by week.</p>
        </details>
        <details class="group bg-tjb-cream rounded-xl border border-tjb-lavender-200/50 open:shadow-md transition-shadow">
          <summary class="cursor-pointer list-none p-5 font-semibold text-tjb-charcoal flex items-center justify-between gap-4">
            Is it normal for symptoms to differ week to week?
            <span class="text-tjb-rose-500 group-open:rotate-45 transition-transform text-xl leading-none shrink-0">+</span>
          </summary>
          <p class="px-5 pb-5 text-tjb-gray leading-relaxed">Absolutely. Every pregnancy is different, and even the same person can feel completely different from one week to the next. These guides describe what's typical, not what's required — always check in with your provider if something feels off.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       APP CTA
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-charcoal py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-4">
        Track every week in the free True Joy Birthing app
      </h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        Weekly updates, your birth plan, and doula-backed guidance — all in one place, all free.
      </p>
      <a href="https://apps.apple.com/us/app/true-joy-birthing/id6760793180" class="btn-primary">Download the free app</a>
    </div>
  </section>

</Layout>
