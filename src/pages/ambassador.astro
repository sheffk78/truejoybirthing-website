---
import Layout from '../layouts/Layout.astro';

const breadcrumbList = [{"name": "Home", "url": "https://truejoybirthing.com/"}, {"name": "Ambassador Program", "url": "https://truejoybirthing.com/ambassador/"}];

const faqs = [
  {
    q: "Who can become a True Joy Birthing ambassador?",
    a: "Any certified doula, midwife, childbirth educator, or lactation consultant with an active practice. If you care about better birth preparation and you want to share a tool that genuinely helps your clients, you're who this is for."
  },
  {
    q: "Is there a minimum number of posts or referrals required?",
    a: "One post a month. That's it. Not a quota, not a tracking system. Just: did you share something this month? If life got crazy and you missed a month, I'll check in like a friend, not a manager."
  },
  {
    q: "How does free Pro Mode work?",
    a: "Pro Mode is free as long as you're actively in the program. Each month you post about TJB — even just one mention — your Pro Mode renews automatically. No credit card, no weird strings. If you go quiet for a while, I'll check in. If you need to step back, your account goes back to the free plan. No hard feelings ever."
  },
  {
    q: "Is there a commission or affiliate program?",
    a: "No. I know how these programs usually work. They promise community and track you like a sales rep. I didn't want that for TJB, and I'm guessing you don't want it either. When you tell another doula about a tool that works, that's real. I won't turn your word-of-mouth into a number."
  },
  {
    q: "What does being featured on a city page mean?",
    a: "Your name, photo, and a short bio appear on the TJB city page for your area. When an expecting family searches for birth support in your city, they find you. It's free professional visibility on a page that already ranks in search."
  },
  {
    q: "Do I have to use specific words in my posts?",
    a: "We'll give you ready-to-use captions that you can post as-is or adapt. The words help your posts show up when moms search for birth tools online. But it's not a script — your voice is what makes it real."
  },
  {
    q: "What platforms should I post on?",
    a: "Instagram Reels, YouTube Shorts, and TikTok all get picked up by Google, so those are the best for visibility. But post wherever you're already active. One post a month is all we ask."
  },
  {
    q: "What if I don't know what to post?",
    a: "We've got you. We'll send you caption templates, talking points, and content ideas. You bring your real experience and your voice."
  },
  {
    q: "How do I apply?",
    a: "Fill out the form on this page or email me directly at <a href=\"mailto:shelbi@truejoybirthing.com\" class=\"text-tjb-rose-500 hover:text-tjb-rose-600 border-b border-transparent hover:border-tjb-rose-500 transition-all font-semibold\">shelbi@truejoybirthing.com</a>. I review every application within 2-3 business days. If it's a fit, Pro Mode gets activated within 24 hours. A 15-minute welcome call is available if you'd like to connect, but it's completely optional."
  },
  {
    q: "How long does it take to hear back?",
    a: "I review applications within 2-3 business days. If it's a fit, Pro Mode gets activated within 24 hours. Want to chat? You can schedule a short call anytime, but it's not required."
  },
  {
    q: "What if I want to leave the program?",
    a: "You leave whenever you want. No notice required, no questions asked. Your account goes back to the free plan, and that's it. No hard feelings ever."
  }
];

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a.replace(/<[^>]*>/g, '')
    }
  }))
};

const articleSchema = {
  "@type": "Article",
  "headline": "Doula Ambassador Program — Free Pro Mode for Birth Professionals",
  "description": "Become a True Joy Birthing ambassador. Get free Pro Mode, a featured listing on your city page, and ready-to-use content to post. One post a month keeps your free access active.",
  "author": {
    "@type": "Organization",
    "name": "True Joy Birthing",
    "url": "https://truejoybirthing.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "True Joy Birthing",
    "logo": {
      "@type": "ImageObject",
      "url": "https://truejoybirthing.com/images/tjb-logo.svg"
    }
  },
  "datePublished": "2026-05-30",
  "dateModified": "2026-08-18",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://truejoybirthing.com/ambassador/"
  }
};
---

<Layout
  title="Doula Ambassador Program — Free Pro Mode for Birth Professionals | True Joy Birthing"
  description="Become a True Joy Birthing ambassador. Get free Pro Mode, a featured listing on your city page, and ready-to-use content to post. One post a month keeps your free access active. Apply in 2 minutes."
  canonical="https://truejoybirthing.com/ambassador/"
  ogImage="https://truejoybirthing.com/images/og/og-ambassador.png"
  breadcrumbList={breadcrumbList}
  schema={{ "@graph": [faqSchema, articleSchema] }}
>

  <!-- ═══════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════ -->
  <section class="bg-tjb-cream pt-16 pb-12">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="eyebrow mb-4">For Doulas & Midwives</p>
          <h1 class="text-[2.2rem] md:text-[3rem] leading-[1.12] font-bold text-tjb-charcoal mb-6">
            Free Pro Mode for Doulas and Midwives Who Want to Be Found
          </h1>
          <p class="text-lg text-tjb-gray leading-relaxed mb-8 max-w-xl">
            You build birth plans and support families through one of the most important days of their lives. True Joy Birthing gives you the tools to run your practice and the visibility to reach more families. Free Pro Mode, a listing on your city page, and a community that amplifies your work. One post a month keeps it all going.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#join" class="btn-primary text-center">
              Join the Ambassador Program
            </a>
            <a href="#what-you-get" class="btn-secondary text-center">
              See What's Included
            </a>
          </div>
        </div>
        <div class="relative flex justify-center md:justify-end">
          <div class="w-full max-w-sm rounded-2xl overflow-hidden shadow-xl shadow-tjb-lavender-300/40">
            <img
              src="/images/doula-teaching.webp"
              srcset="/images/responsive/doula-teaching-480w.webp 480w, /images/responsive/doula-teaching-960w.webp 960w, /images/doula-teaching.webp 1024w"
              sizes="(max-width: 480px) 480px, (max-width: 960px) 960px, 480px"
              alt="Doula supporting an expecting family with birth preparation tools"
              class="w-full h-auto object-cover"
              width="1024"
              height="1536"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SOCIAL PROOF — STATS
       ═══════════════════════════════════════════ -->
  <section class="py-16 bg-tjb-cream-50">
    <div class="max-w-5xl mx-auto px-6">
      <div class="bg-white rounded-2xl p-8 shadow-sm border border-tjb-lavender-200/40">
        <div class="grid md:grid-cols-3 gap-8 text-center">
          <div class="p-4">
            <p class="text-4xl font-bold text-tjb-rose-500 font-serif">180+</p>
            <p class="text-sm text-tjb-gray mt-2">City pages with doula and midwife listings</p>
          </div>
          <div class="p-4 border-x border-tjb-lavender-200/40">
            <p class="text-4xl font-bold text-tjb-rose-500 font-serif">Free</p>
            <p class="text-sm text-tjb-gray mt-2">Pro Mode every month you're active. One post keeps it going.</p>
          </div>
          <div class="p-4">
            <p class="text-4xl font-bold text-tjb-rose-500 font-serif">1</p>
            <p class="text-sm text-tjb-gray mt-2">Post a month. That's all we ask. No contracts, no tracking links.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHO THIS IS FOR
       ═══════════════════════════════════════════ -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="eyebrow mb-4">Who This Is For</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
        <h2 class="text-[2.25rem] md:text-[2.75rem] leading-[1.15] max-w-2xl mx-auto">
          You, If This Sounds Like You
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6 max-w-3xl mx-auto">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-tjb-rose-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-tjb-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div>
            <p class="font-semibold text-tjb-charcoal">Certified birth professional</p>
            <p class="text-sm text-tjb-gray mt-1">Doula, midwife, childbirth educator, or lactation consultant with an active practice.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-tjb-rose-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-tjb-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div>
            <p class="font-semibold text-tjb-charcoal">Already using TJB (or want to)</p>
            <p class="text-sm text-tjb-gray mt-1">You build birth plans with your clients and want a tool that makes your practice easier.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-tjb-rose-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-tjb-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div>
            <p class="font-semibold text-tjb-charcoal">Tired of affiliate programs</p>
            <p class="text-sm text-tjb-gray mt-1">You want to share what works without being tracked, measured, or put on a quota.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHY THIS IS DIFFERENT
       ═══════════════════════════════════════════ -->
  <section class="py-16 bg-tjb-cream-50">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="eyebrow mb-4">Not Another Affiliate Program</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
        <h2 class="text-[2.25rem] md:text-[2.75rem] leading-[1.15] max-w-2xl mx-auto">
          This Is a Relationship, Not a Contract
        </h2>
        <p class="text-lg text-tjb-gray mt-6 max-w-2xl mx-auto">
          I know how these programs usually work. They promise community and track you like a sales rep. I didn't want that for TJB, and I'm guessing you don't want it either. Here's what makes this different.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white rounded-xl p-8 border border-tjb-lavender-200/50 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-tjb-lavender-100 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-tjb-lavender-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </div>
          <h3 class="text-xl mb-3">No Tracking</h3>
          <p class="text-tjb-gray">I don't count your posts or track who you refer. When you tell another doula about a tool that works, that's real. I won't turn your word-of-mouth into a number. The one-post-a-month ask is about staying active, not about me counting.</p>
        </div>

        <div class="bg-white rounded-xl p-8 border border-tjb-lavender-200/50 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-tjb-lavender-100 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-tjb-lavender-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-xl mb-3">Stay Active, Stay Free</h3>
          <p class="text-tjb-gray">Free Pro Mode renews every month. One post about TJB each month keeps it going. Not a quota. Not a performance metric. Just: did you share something this month? If life got crazy and you missed a month, I check in like a friend, not a manager. If you need to step back, your account goes to the free plan. No hard feelings.</p>
        </div>

        <div class="bg-white rounded-xl p-8 border border-tjb-lavender-200/50 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-tjb-lavender-100 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-tjb-lavender-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </div>
          <h3 class="text-xl mb-3">No Quotas</h3>
          <p class="text-tjb-gray">No minimum posts. No referral targets. No tiers to climb. You share when it's real and when it fits. Authentic advocacy works because it's honest, not because it's measured.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHAT YOU GET
       ═══════════════════════════════════════════ -->
  <section id="what-you-get" class="py-20 md:py-28 bg-white border-y border-tjb-lavender-200/40">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="eyebrow mb-4">What You Get</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
        <h2 class="text-[2.25rem] md:text-[2.75rem] leading-[1.15] max-w-2xl mx-auto">
          Real Benefits, Not Discount Codes
        </h2>
      </div>

      <div class="space-y-0">
        <!-- 01: Free Pro Mode -->
        <div class="py-8 border-t border-tjb-lavender-300/40">
          <div class="grid md:grid-cols-[3rem_1fr] gap-4 md:gap-8 items-start">
            <span class="text-3xl font-bold text-tjb-lavender-600 font-serif">01</span>
            <div>
              <h3 class="text-2xl mb-1">Free Pro Mode</h3>
              <p class="text-sm text-tjb-lavender-600 font-semibold mb-3">Free. For as long as you're in the program.</p>
              <p class="text-tjb-gray leading-relaxed">Full Pro Mode access. Client management, visit tracking, invoicing, birth plan collaboration, notes. Every feature, every update, no limits. You use it because it makes your practice better. I give it to you because that's the point.</p>
            </div>
          </div>
        </div>

        <!-- 02: Featured on your city page -->
        <div class="py-8 border-t border-tjb-lavender-300/40">
          <div class="grid md:grid-cols-[3rem_1fr] gap-4 md:gap-8 items-start">
            <span class="text-3xl font-bold text-tjb-lavender-600 font-serif">02</span>
            <div>
              <h3 class="text-2xl mb-1">Featured on Your City Page</h3>
              <p class="text-sm text-tjb-lavender-600 font-semibold mb-3">Families in your area find you</p>
              <p class="text-tjb-gray leading-relaxed">Your name, photo, and a short bio on the TJB city page for your area. When an expecting family searches for birth support in your city, they find you. <a href="/birth-support/lehi-ut/" class="text-tjb-rose-500 hover:underline font-medium">See what that looks like &rarr;</a> You get it because you're part of the community.</p>
            </div>
          </div>
        </div>

        <!-- 03: Cross-promotion -->
        <div class="py-8 border-t border-tjb-lavender-300/40">
          <div class="grid md:grid-cols-[3rem_1fr] gap-4 md:gap-8 items-start">
            <span class="text-3xl font-bold text-tjb-lavender-600 font-serif">03</span>
            <div>
              <h3 class="text-2xl mb-1">More Eyes on Your Work</h3>
              <p class="text-sm text-tjb-lavender-600 font-semibold mb-3">I amplify your content, you amplify mine</p>
              <p class="text-tjb-gray leading-relaxed">I repost your content, tag you in stories, and feature you on TJB's pages. Your audience grows with ours. When you post about birth prep or client wins, I help more people see it. Cross-promotion, not one-way extraction.</p>
            </div>
          </div>
        </div>

        <!-- 04: Partner badge -->
        <div class="py-8 border-t border-tjb-lavender-300/40">
          <div class="grid md:grid-cols-[3rem_1fr] gap-4 md:gap-8 items-start">
            <span class="text-3xl font-bold text-tjb-lavender-600 font-serif">04</span>
            <div>
              <h3 class="text-2xl mb-1">TJB Partner Badge</h3>
              <p class="text-sm text-tjb-lavender-600 font-semibold mb-3">A credential that actually means something</p>
              <p class="text-tjb-gray leading-relaxed">A clean credential for your website, social profiles, and business cards. "True Joy Birthing Partner" says you use professional tools and take your practice seriously. Simple, credible, and earned.</p>
            </div>
          </div>
        </div>

        <!-- 05: Early access -->
        <div class="py-8 border-t border-tjb-lavender-300/40">
          <div class="grid md:grid-cols-[3rem_1fr] gap-4 md:gap-8 items-start">
            <span class="text-3xl font-bold text-tjb-lavender-600 font-serif">05</span>
            <div>
              <h3 class="text-2xl mb-1">You Help Build What Comes Next</h3>
              <p class="text-sm text-tjb-lavender-600 font-semibold mb-3">Early access and real input</p>
              <p class="text-tjb-gray leading-relaxed">New features come to ambassadors first. When you tell me something should work differently, I listen. You're not a user I market to. You're a professional I build with.</p>
            </div>
          </div>
        </div>

        <!-- 06: Content kit -->
        <div class="py-8 border-t border-tjb-lavender-300/40">
          <div class="grid md:grid-cols-[3rem_1fr] gap-4 md:gap-8 items-start">
            <span class="text-3xl font-bold text-tjb-lavender-600 font-serif">06</span>
            <div>
              <h3 class="text-2xl mb-1">Ready-to-Use Content Kit</h3>
              <p class="text-sm text-tjb-lavender-600 font-semibold mb-3">Never stare at a blank screen again</p>
              <p class="text-tjb-gray leading-relaxed">We give you caption templates, posting ideas, and talking points so you never have to figure out what to say. You bring your real experience and your voice. Post it as-is or make it yours. Either way, your content is working for you while you sleep.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Mid-page CTA -->
      <div class="mt-12 text-center">
        <a href="#join" class="btn-primary">Join the Ambassador Program</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       HOW YOUR POSTS HELP FAMILIES FIND YOU
       ═══════════════════════════════════════════ -->
  <section class="py-20 md:py-28 bg-tjb-cream">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="eyebrow mb-4">Your Posts Work for You</p>
      <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
      <h2 class="text-[2.25rem] md:text-[2.75rem] leading-[1.15] max-w-2xl mx-auto mb-8">
        How Your Posts Help Families Find You
      </h2>
      <p class="text-lg text-tjb-gray leading-relaxed max-w-2xl mx-auto">
        When you post about True Joy Birthing on Instagram, YouTube, or TikTok, those posts don't just reach your followers. Google picks them up. When an expecting mom searches for a birth plan app or doula tools online, your posts can show up in her results. That means more families find you, and more families find TJB. We give you ready-to-use captions so you don't have to think about what to write. You just post, tag us, and your content works for you while you sleep.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHAT WE ASK
       ═══════════════════════════════════════════ -->
  <section class="py-20 md:py-28 bg-tjb-cream-50">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="eyebrow mb-4">What I Ask</p>
        <div class="w-10 h-0.5 bg-tjb-rose-500 mx-auto mb-6"></div>
        <h2 class="text-[2.25rem] md:text-[2.75rem] leading-[1.15] max-w-2xl mx-auto">
          Three Things. Nothing Complicated.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center bg-white rounded-xl p-8 border border-tjb-lavender-200/50 shadow-sm">
          <div class="w-16 h-16 rounded-full bg-tjb-rose-100 flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-tjb-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <h3 class="text-xl mb-3">Use the App With Your Clients</h3>
          <p class="text-tjb-gray">Build birth plans, track visits, manage your practice. You do it because it works, not because I asked.</p>
        </div>

        <div class="text-center bg-white rounded-xl p-8 border border-tjb-lavender-200/50 shadow-sm">
          <div class="w-16 h-16 rounded-full bg-tjb-rose-100 flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-tjb-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <h3 class="text-xl mb-3">Tell Your Professional Network</h3>
          <p class="text-tjb-gray">When it comes up with other doulas and midwives, mention it. In person, in your groups, in your DMs. However you naturally share.</p>
        </div>

        <div class="text-center bg-white rounded-xl p-8 border border-tjb-lavender-200/50 shadow-sm">
          <div class="w-16 h-16 rounded-full bg-tjb-rose-100 flex items-center justify-center mx-auto mb-6">
