{
  "name": "truejoybirthing-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/split-sitemaps.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "bash scripts/deploy.sh",
    "deploy:city": "bash scripts/deploy.sh",
    "wrangler": "bash scripts/wrangler-guard.sh",
    "preflight": "npx tsx scripts/preflight.ts",
    "preflight:self-test": "npx tsx scripts/preflight.ts --self-test",
    "test:city-pages": "tsx scripts/city-pages.test.ts",
    "validate": "tsx scripts/validate-cities.ts && tsx scripts/validate-xrefs.ts",
    "validate:xrefs": "tsx scripts/validate-xrefs.ts",
    "build:safe": "tsx scripts/validate-cities.ts && tsx scripts/validate-xrefs.ts && astro build && node scripts/split-sitemaps.mjs",
    "indexnow": "node scripts/submit-indexnow.cjs",
    "postdeploy": "node scripts/submit-indexnow.cjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^6.4.8",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.11",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "astro-icon": "^1.2.0",
    "node-html-parser": "^7.1.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3"
  }
}
